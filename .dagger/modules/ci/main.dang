"""
Runs the repository's checks in containers built from its pins.
"""
type Ci {
  """
  The files git would commit; ignored files such as a local kubeconfig stay on the host.
  """
  let source: Directory!

  """
  Git metadata with the full history of HEAD, self-contained even when the checkout is a linked worktree.
  """
  let git: Directory!

  new(ws: Workspace!) {
    self.source = ws.directory("/", exclude: [".git"], gitignore: true)
    self.git = ws.git.directory
    self
  }

  """
  Run the justfile's groups of checks side by side and return what they printed, after a line that says where the tools came from: the groups are the dependencies of the checks recipe, and a group's checks are its own dependencies. A group's renovate-check runs Renovate's validator and extraction in its own image, its vector-check runs Vector in the image the log collector runs, on the configuration the pinned tools render, and its edge-policy-check runs FRR's speakers in FRR's image, on the configuration the pinned tools render; its rules-check runs promtool, taken from the Prometheus image the monitoring chart deploys, on the alert rules the pinned tools render; its alerts-route-check runs amtool and Alertmanager, taken from the Alertmanager image the monitoring chart deploys, on the configuration the pinned tools render for it; its other checks run in one just run, in the tools container (tools). Every group runs to its end; when a check fails, the call fails with every group's output and names the groups that failed.
  """
  pub checks(
    """
    The image renovate-check runs Renovate from.
    """
    renovateImage: String!,

    """
    The image vector-check runs Vector from, the one the log collector runs.
    """
    vectorImage: String!,

    """
    The image edge-policy-check runs FRR from.
    """
    frrImage: String!,

    """
    The image alerts-route-check takes amtool and Alertmanager from, the one the monitoring chart deploys.
    """
    alertmanagerImage: String!,

    """
    The image the tools container is built from.
    """
    toolsBase: String!,

    """
    The shell command that installs the system packages mise needs, run in toolsBase before mise install.
    """
    toolsPackages: String!,

    """
    The tools image published for these inputs, by digest, or empty.
    """
    toolsImage: String! = "",

    """
    The commit where HEAD's history leaves the default branch, or empty without one; the messages of the commits after it are checked.
    """
    base: String! = "",

    """
    The one group to run, such as tests-2; every group when empty.
    """
    group: String! = "",
  ): String! {
    let chosen = tools(toolsBase, toolsPackages, toolsImage)
    let checkout = chosen.ctr
      .withDirectory("/src", source)
      .withDirectory("/src/.git", git)
      # The snapshot's index matches HEAD, so a file staged here but not yet committed would look untracked.
      .withExec(["git", "add", "--all"])
      # The snapshot holds HEAD's history and no other ref, so the default branch is named where it
      # leaves that history, under the name a CI checkout gives the remote's main.
      .withExec(["sh", "-c", """if [ -n "$1" ]; then git update-ref refs/remotes/origin/main "$1"; fi""", "sh", base])
    let validator = container
      .from(renovateImage)
      .withMountedDirectory("/usr/src/app", source)
      .withWorkdir("/usr/src/app")
    # The configuration the log collector runs with and Vector's unit tests of it, as
    # scripts/vector-config writes them with the pinned tools, where vector-check reads them.
    let collector = container
      .from(vectorImage)
      .withEnvVariable("VECTOR_SELF_NODE_NAME", "node-1")
      .withMountedDirectory("/check", checkout.withExec(["scripts/vector-config", "/tmp/vector-check"]).directory("/tmp/vector-check"))
    # One line per group: its name, then its checks as just takes them on its command line, each
    # recipe followed by its arguments.
    let listing = checkout.withExec(["bash", "-c", """
      set -euo pipefail
      just --dump --dump-format json | jq -r --arg group "$1" '
        .recipes as $recipes
        | [$recipes.checks.dependencies[].recipe] as $groups
        | if $group == "" or ($groups | index($group)) != null then $groups[]
          else error("no group " + $group + "; the groups are " + ($groups | join(" "))) end
        | select($group == "" or . == $group)
        | [., ($recipes[.].dependencies[] | .recipe, (.arguments[]
            | if type == "string" and test("^[^[:space:]]+$") then . else error("the arguments of the checks of a group are single words") end))]
        | join(" ")'
    """, "bash", group]).stdout
    let groups = listing.trimSpace.split("\n").reject { _.isEmpty }.map { line =>
      let words = line.split(" ")
      Group(name: words.takeFirst.join(""), checks: words.dropFirst, checkout: checkout, validator: validator, collector: collector, frr: container.from(frrImage), alertmanagerImage: alertmanagerImage)
    }
    if (groups.isEmpty) {
      raise "the checks recipe has no groups"
    }
    let ran = groups.{{ name, checks, outcome }}
    let report = ran.map { g =>
      let verdict = if (g.outcome.passed) { "passed" } else { "failed" }
      "== " + g.name + ": " + verdict + " (" + g.checks.join(" ") + ")\n" + g.outcome.output
    }.join("\n")
    let failed = ran.reject { _.outcome.passed }.map { _.name }
    let passed = ran.filter { _.outcome.passed }.map { _.name }
    let summary = (if (failed.isEmpty) { [] } else { ["failed: " + failed.join(" ")] })
      + (if (passed.isEmpty) { [] } else { ["passed: " + passed.join(" ")] })
    if (failed.isEmpty) {
      chosen.origin + "\n" + report + "\n" + summary.join("\n")
    } else {
      raise chosen.origin + "\n" + report + "\n" + summary.join("\n")
    }
  }

  """
  The pull request comment of the CI render job: scripts/render-pr renders the commit base and the checkout, both with the base's render code, in the tools container (tools), and compares them. It pulls the charts from their public registries and needs no credential.
  """
  pub renderDiff(
    """
    The image the tools container is built from.
    """
    toolsBase: String!,

    """
    The shell command that installs the system packages mise needs, run in toolsBase before mise install.
    """
    toolsPackages: String!,

    """
    The tools image published for these inputs, by digest, or empty.
    """
    toolsImage: String! = "",

    """
    The commit the checkout is compared with; the first parent of HEAD when empty.
    """
    base: String! = "",
  ): File! {
    tools(toolsBase, toolsPackages, toolsImage).ctr
      .withDirectory("/src", source)
      .withDirectory("/src/.git", git)
      # The pinned installs first on PATH, as the justfile puts them: mise's shims resolve a version
      # only below a mise.toml, and the render works in a directory of its own.
      .withExec(["bash", "-c", `PATH="$(mise bin-paths | paste -sd: -):$PATH" exec scripts/render-pr "$@"`, "bash", base, "/tmp/render-diff/comment.md"])
      .file("/tmp/render-diff/comment.md")
  }

  """
  The tools container checks and renderDiff run in, chosen here alone so the two cannot differ, and a line that says where it came from: image, the tools image published for base, packages and mise.toml, when it is given and runs on the engine's platform, as one of another platform would run under emulation, if at all; otherwise the layer toolsLayer builds from them.
  """
  let tools(base: String!, packages: String!, image: String!): Tools! {
    let engine = toString(defaultPlatform)
    let platform = if (image == "") { "" } else { toString(container.from(image).platform) }
    if (image != "" and platform == engine) {
      Tools(ctr: container.from(image), origin: "tools: " + image)
    } else if (image == "") {
      Tools(ctr: toolsLayer(base, packages), origin: "tools: built from the pins, as no tools image is given")
    } else {
      Tools(ctr: toolsLayer(base, packages), origin: "tools: built from the pins, as " + image + " is for " + platform + " and the engine runs " + engine)
    }
  }

  """
  The tools pinned in mise.toml, in a layer that depends on base, packages, mise.toml and the steps here alone, so changes to other files reuse it: the tools container of the checks and the render when no tools image fits (tools), and the image the tools image workflow publishes. A tools image's key covers this whole module, so a change anywhere in it gets an image of its own.
  """
  pub toolsLayer(
    """
    The image to start from.
    """
    base: String!,

    """
    The shell command that installs the system packages mise needs, run before mise install.
    """
    packages: String!,
  ): Container! {
    container
      .from(base)
      .withExec(["sh", "-c", packages])
      .withWorkdir("/src")
      .withEnvVariable("MISE_TRUSTED_CONFIG_PATHS", "/src")
      .withFile("/src/mise.toml", source.file("mise.toml"))
      .withExec(["mise", "install"])
  }
}

"""
The tools container, and where it came from.
"""
type Tools {
  """
  The container.
  """
  ctr: Container!

  """
  A line that says where the container came from.
  """
  origin: String!
}

"""
One group of checks, run in containers of its own.
"""
type Group {
  """
  The group's recipe.
  """
  name: String!

  """
  The group's checks, as just takes them on its command line.
  """
  checks: [String!]!

  """
  The tools container with the checkout under test.
  """
  let checkout: Container!

  """
  Renovate's image with the files under test, which scripts/renovate-check validates the configuration of and extracts the dependencies from.
  """
  let validator: Container!

  """
  Vector's image with the log collector's rendered configuration and Vector's unit tests of it under /check.
  """
  let collector: Container!

  """
  FRR's image, which edge-policy-check's speakers run in.
  """
  let frr: Container!

  """
  The image of the Alertmanager the monitoring chart deploys, which alerts-route-check takes amtool and Alertmanager from.
  """
  let alertmanagerImage: String!

  """
  Whether every check of the group passed, and what they printed: renovate-check's Renovate, vector-check's Vector, edge-policy-check's FRR, rules-check's promtool, alerts-route-check's amtool and Alertmanager, and the just run of the others side by side.
  """
  outcome: Outcome! {
    let others = checks.reject { _ == "renovate-check" }.reject { _ == "vector-check" }.reject { _ == "edge-policy-check" }.reject { _ == "rules-check" }.reject { _ == "alerts-route-check" }
    # The edge routers' routing policy against real BGP speakers: the checkout renders the edge's
    # configuration, FRR's container runs the speakers, which bind and dial loopback addresses only,
    # and the checkout checks what they printed. No docker, no privileges. What the proof printed is
    # kept as a failed check's output is, so the check reads it, and prints it when a check fails,
    # whether the proof's container ended well or not.
    let policyInputs = checkout.withExec(["just", "edge-policy-render", "/tmp/edge-policy"]).directory("/tmp/edge-policy")
    let proof = Run(label: "", ctr: frr.withMountedDirectory("/work", policyInputs).withExec(["sh", "-c", `exec 2>&1; sh /work/proof.sh /work`])).outcome
    let policyPrinted = if (proof.passed) { proof.output } else { proof.output + "\n== container\nended with an error\n" }
    let edgePolicy: [Run!]! = if (checks.contains("edge-policy-check")) {
      [Run(label: "edge-policy-check", ctr: checkout.withNewFile("/tmp/proof.out", policyPrinted).withExec(["bash", "-c", `exec 2>&1; just edge-policy-assert /tmp/proof.out`]))]
    } else {
      []
    }
    let renovate: [Run!]! = if (checks.contains("renovate-check")) {
      [Run(label: "renovate-check", ctr: validator.withExec(["sh", "-c", "bash scripts/renovate-check 2>&1"]))]
    } else {
      []
    }
    # The image has no shell, so Vector's own errors, on standard error, reach the report through
    # the failed exec's error.
    let vector: [Run!]! = if (checks.contains("vector-check")) {
      [Run(label: "vector-check", ctr: collector
        .withExec(["vector", "validate", "--no-environment", "/check/vector.yaml"])
        .withExec(["vector", "test", "/check/vector.yaml", "/check/tests.yaml"]))]
    } else {
      []
    }
    # The alert rules the tree renders, and promtool's checks and unit tests of them. promtool comes
    # from the image of the Prometheus the monitoring chart deploys, by the tag the chart names,
    # which scripts/rules-image reads from the chart: no image is pinned for it and dagger.lock holds
    # no entry for it, so Dagger resolves the tag as it pulls the image, and a chart update that
    # moves the tag needs no other change. The tools container runs it, as it has the network the
    # render needs, with the pinned installs first on PATH as the justfile puts them: the render
    # works in a directory of its own, where mise's shims find no version. The check fails when the
    # render names another image.
    let rules: [Run!]! = if (checks.contains("rules-check")) {
      # rules-image pulls the chart: when it cannot, the check fails with what rules-image printed,
      # and the group's other checks still report.
      let found = Run(label: "", ctr: checkout.withExec(["scripts/rules-image"])).outcome
      if (found.passed) {
        let image = found.output.trimSpace
        [Run(label: "rules-check", ctr: checkout
          .withFile("/usr/local/bin/promtool", container.from(image).file("/bin/promtool"))
          .withExec(["chmod", "+x", "/usr/local/bin/promtool"])
          .withExec(["bash", "-c", `PATH="$(mise bin-paths | paste -sd: -):$PATH"; export PATH; exec 2>&1; scripts/rules-config /tmp/rules-check && { [ "$(cat /tmp/rules-check/image)" = "$1" ] || { echo "the render deploys $(cat /tmp/rules-check/image), not $1, which promtool came from"; exit 1; }; } && scripts/rules-promtool /tmp/rules-check promtool && scripts/rules-refusal /tmp/rules-check promtool`, "bash", image]))]
      } else {
        [Run(label: "rules-check", ctr: checkout.withNewFile("/tmp/rules-image.out", found.output).withExec(["sh", "-c", `cat /tmp/rules-image.out; echo "rules-image found no Prometheus image to take promtool from"; exit 1`]))]
      }
    } else {
      []
    }
    # The configuration the monitoring chart gives Alertmanager, and amtool's and Alertmanager's own
    # word on it. Both come from the image of the Alertmanager the chart deploys, which the recipe
    # hands in by its digest, so dagger.lock holds no entry for it. The tools container runs them, as
    # it has the network the render needs, with the pinned installs first on PATH as the justfile
    # puts them; amtool and Alertmanager bind and dial that container's loopback alone. The check
    # fails when the render names another image than the one they came from.
    let routes: [Run!]! = if (checks.contains("alerts-route-check")) {
      let image = container.from(alertmanagerImage)
      [Run(label: "alerts-route-check", ctr: checkout
        .withFile("/usr/local/bin/amtool", image.file("/bin/amtool"))
        .withFile("/usr/local/bin/alertmanager", image.file("/bin/alertmanager"))
        .withExec(["chmod", "+x", "/usr/local/bin/amtool", "/usr/local/bin/alertmanager"])
        .withExec(["bash", "-c", `PATH="$(mise bin-paths | paste -sd: -):$PATH"; export PATH; exec 2>&1; pinned="$(printf '%s' "$1" | cut -d@ -f1)"; scripts/alerts-route-config /tmp/alerts-route-check && { [ "$(cat /tmp/alerts-route-check/image)" = "$pinned" ] || { echo "the render deploys $(cat /tmp/alerts-route-check/image), not $pinned, which amtool and Alertmanager came from"; exit 1; }; } && scripts/alerts-route-run /tmp/alerts-route-check sh && scripts/alerts-route-run --refusals /tmp/alerts-route-check sh`, "bash", alertmanagerImage]))]
    } else {
      []
    }
    # One just run, so a recipe that several checks depend on runs once. Without a recipe, just
    # would run its default and pass having checked nothing.
    let justRun: [Run!]! = if (others.isEmpty) {
      []
    } else {
      [Run(label: "", ctr: checkout.withExec(["bash", "-c", `exec 2>&1; just "$@"`, "bash"] + others))]
    }
    let done = (renovate + vector + edgePolicy + rules + routes + justRun).{{ label, outcome }}
    Outcome(
      passed: done.all { _.outcome.passed },
      output: done.map { r => if (r.label == "") { r.outcome.output } else { r.label + ":\n" + r.outcome.output } }.join("\n"),
    )
  }
}

"""
One container run of a group's checks, everything it prints on stdout, so that it reads in the order it was printed.
"""
type Run {
  """
  What the run checks, when it is not a just run, which names its recipes itself.
  """
  label: String!

  """
  The container, ending in the exec that checks.
  """
  let ctr: Container!

  """
  Whether the run passed, and what it printed. A failed exec is not cached, so a check that failed runs again next time.
  """
  outcome: Outcome! {
    Outcome(passed: true, output: ctr.stdout) rescue {
      failure: GraphQLError => {
        # Dagger's error for an exec that exited non-zero carries what it printed; any other
        # error, such as an image that cannot be pulled, says what went wrong itself.
        let exec: ExecError = JSON.decode(failure.extensions) rescue null
        Outcome(passed: false, output: if (exec == null) { failure.message } else { exec.stdout + exec.stderr })
      }
      err: Error => Outcome(passed: false, output: err.message)
    }
  }
}

"""
Whether a run or a group passed, and what it printed.
"""
type Outcome {
  passed: Boolean!
  output: String!
}

"""
The extensions of Dagger's error for an exec that exited non-zero, as far as a report needs them.
"""
type ExecError {
  stdout: String!
  stderr: String!
}
