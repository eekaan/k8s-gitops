# talman's configuration of one cluster, rendered by OpenTofu's templatefile from the cluster's
# node list, so node names and addresses have one source. The rendered file belongs in
# talos/<cluster>/, where the relative paths below resolve; it is generated and never committed.
apiVersion: talman.dev/v1
clusterName: ${cluster_name}
endpoint: ${endpoint}
talosVersion: ${talos_version}
kubernetesVersion: ${kubernetes_version}

values:
  nodeSubnet: ${node_subnet}
  podSubnet: ${pod_subnet}
  serviceSubnet: ${service_subnet}
  apiSANs: ${jsonencode(api_sans)}
  # The load balancer's floating address, where the cluster recipes reach the Kubernetes API.
  apiAddress: ${api_address}
  # Services announced over BGP, from the plumbing stack: the range LoadBalancer addresses come
  # from, the AS numbers and the edge routers the workers peer with. just cluster-config hands them
  # to the cluster in cluster-config; no Talos patch reads them.
  serviceRange: ${service_range}
  bgp:
    clusterASN: ${bgp.cluster_asn}
    edgeASN: ${bgp.edge_asn}
    edgeAddresses: ${jsonencode(bgp.edge_addresses)}
    # The public Gateway's address, a host of the service range, which the edge routers forward
    # public traffic to.
    gatewayAddress: ${bgp.gateway_address}
  # The ingress firewall's rules for each role (talos/patches/all/firewall.yaml): every listener of
  # talos/firewall.yaml the role has, accepting the networks of its sources. A port is written as a
  # range, the one form in which a rule takes it quoted.
  firewall: ${jsonencode({
    for role in ["controlplane", "worker"] : role => [
      for listener in firewall.listeners : {
        name     = listener.name
        protocol = listener.protocol
        ports    = [for port in listener.ports : strcontains(tostring(port), "-") ? tostring(port) : "${port}-${port}"]
        subnets = sort(distinct(flatten([for source in listener.from : {
          operators     = operator_cidrs
          floating      = [for node in nodes : "${node.floating_ip}/32"]
          pods          = [pod_subnet]
          controlplanes = [for node in nodes : "${node.private_address}/32" if node.role == "controlplane"]
          members       = [for node in nodes : "${node.private_address}/32"]
          loadbalancer  = api_load_balancer_addresses
          cihost        = ci_host_address == null ? [] : ["${ci_host_address}/32"]
        }[source]])))
      } if contains(["all", role], listener.nodes)
    ]
  })}

# Installer images are the Image Factory's openstack installer for this schematic; talman computes
# the schematic's ID offline.
imageFactory:
  platform: openstack

schematic: ../schematic.yaml

# Only the reserved groups, each with a member: talman refuses a patch group no node is in, so the
# workers' group is there only when a worker is.
patches:
  all:
    - ../patches/all/hostname.yaml
    - ../patches/all/install.yaml
    - ../patches/all/cluster-network.yaml
    - ../patches/all/floating-ip.yaml
    - ../patches/all/kubelet.yaml
    - ../patches/all/node-ip.yaml
    - ../patches/all/kernel-modules.yaml
    - ../patches/all/user-namespaces.yaml
    - ../patches/all/seccomp-default.yaml
    - ../patches/all/spegel.yaml
    - ../patches/all/firewall.yaml
  controlplane:
    - ../patches/controlplane/api-sans.yaml
    - ../patches/controlplane/etcd.yaml
    - ../patches/controlplane/metrics.yaml
    - ../patches/controlplane/deny-service-external-ips.yaml
    - ../patches/cni/cilium.yaml
%{ if contains([for node in nodes : node.role], "worker") ~}
  worker:
    - ../patches/worker/data-volume.yaml
%{ endif ~}

nodes:
%{ for node in nodes ~}
  - hostname: ${node.hostname}
    role: ${node.role}
    ipAddress: ${node.address}
    values:
      floatingIP: ${node.floating_ip}
%{ endfor ~}
