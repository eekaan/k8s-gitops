#!/usr/bin/env bash
# Takes an etcd snapshot of a cluster and keeps it, encrypted, in the etcd backup bucket,
# <BACKUP_BUCKET_PREFIX>-etcd: take_etcd_snapshot in scripts/lib/snapshot.sh, which the upgrade
# recipes run as well, says how. Prints one line: the cluster, the object's name and its size.
# Nothing is left on disk, whether the run succeeds, fails or is interrupted.
# Usage: scripts/cluster-snapshot [cluster]
set -euo pipefail
umask 077

here=$(dirname "$0")
# shellcheck source=scripts/lib/snapshot.sh
. "$here/lib/snapshot.sh"
# shellcheck source=scripts/cluster-env
. "$here/cluster-env" "${1-}"
complete=1
require_cluster talman secrets age-key recipient || complete=0
require_snapshot || complete=0
((complete))
prepare_snapshot
take_etcd_snapshot
