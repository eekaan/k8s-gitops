#!/usr/bin/env bash
# Creates the bucket TF_STATE_BUCKET names, which holds every stack's state, unless it exists,
# through the object storage's S3 API with the state key, the key OpenTofu's s3 backend reaches it
# with; no OpenStack credentials are needed. Prints neither the bucket's name nor anything rclone
# reports, which names the bucket and the endpoint, so its output can be shared. A second run finds
# the bucket and creates nothing.
# Usage: scripts/infra-state-bucket
set -euo pipefail

# shellcheck source=scripts/lib/s3.sh
. "$(dirname "$0")/lib/s3.sh"
load_env
complete=1
refuse_http2_debug || complete=0
require_env TF_STATE_BUCKET AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY || complete=0
((complete))
s3_bucket_name_ok TF_STATE_BUCKET
s3_require_client

if ! s3_create_buckets state "$TF_STATE_BUCKET"; then
  infra_error "rclone cannot list the object storage's buckets with the state key"
  exit 1
fi
case ${s3_bucket_state[$TF_STATE_BUCKET]} in
  exists) echo "infra-state-bucket: the bucket TF_STATE_BUCKET names exists; nothing to create" ;;
  created) echo "infra-state-bucket: created the bucket TF_STATE_BUCKET names" ;;
  taken)
    infra_error "the name TF_STATE_BUCKET holds is taken; choose another"
    exit 1
    ;;
  unconfirmed)
    infra_error "the bucket TF_STATE_BUCKET names may have been created, but the buckets could not be listed to confirm it"
    exit 1
    ;;
  *)
    infra_error "rclone cannot create the bucket TF_STATE_BUCKET names"
    exit 1
    ;;
esac
