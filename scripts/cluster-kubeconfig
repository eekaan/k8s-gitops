#!/usr/bin/env bash
# Fetches a cluster's admin kubeconfig with talman kubeconfig into talman's output directory,
# talos/<cluster>/clusterconfig/kubeconfig, which git ignores, with mode 0600, and points every
# cluster in it at https://KUBE_API_ADDRESS:6443, the API load balancer's floating address. The
# server talman writes is the cluster endpoint, the load balancer's address on the node network,
# which only the nodes reach. Prints the kubeconfig's path, and neither its content nor the address.
# Usage: scripts/cluster-kubeconfig [cluster]
set -euo pipefail

# shellcheck source=scripts/cluster-env
. "$(dirname "$0")/cluster-env" "${1-}"
require_cluster talman secrets age-key api-address
umask 077

step="fetching the kubeconfig with talman"
cluster_talman kubeconfig
if [[ ! -f $KUBECONFIG ]] || ! yq -e '.clusters | length > 0' "$KUBECONFIG" > /dev/null 2>&1; then
  infra_error "talman kubeconfig wrote no talos/$cluster/clusterconfig/kubeconfig with a cluster in it"
  exit 1
fi
chmod 600 "$KUBECONFIG"

step="pointing the kubeconfig at KUBE_API_ADDRESS"
# yq takes the address from its environment, so it reaches no command line.
yq -i '.clusters[].cluster.server = "https://" + strenv(KUBE_API_ADDRESS) + ":6443"' "$KUBECONFIG"
chmod 600 "$KUBECONFIG"
echo "$KUBECONFIG"
