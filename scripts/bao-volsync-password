#!/usr/bin/env bash
# Opens one application's restic repository for the operator without a password at a prompt or in a
# command line: derives the application's repository password from the master in bao-seed-volsync's
# custody file, as components/volsync does (the SHA-256 digest of the master, a slash and the
# application's name, as 64 lower-case hexadecimal digits), and runs a command with the repository,
# the password and the cluster's S3 key in its environment, as restic reads them: RESTIC_REPOSITORY,
# RESTIC_PASSWORD, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_DEFAULT_REGION. The custody file is
# read only where no one but this user can have written it (bao_custody_trusted in
# scripts/lib/openbao.sh), and opens with the Talos age key into memory only. The command gets no
# other secret of this environment, and nothing here prints the master or the password, or passes
# either as an argument.
# The repository is the one the component names, in the VolSync bucket of BACKUP_BUCKET_PREFIX at
# the object storage's endpoint. It reaches neither the cluster nor OpenBao; the command's status is
# its own.
# Usage: scripts/bao-volsync-password <file> <app> <command> [argument...]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/openbao.sh
. "$here/lib/openbao.sh"

if (($# < 3)); then
  echo "bao-volsync-password: give the custody file, the application and the command to run: just bao-volsync-password <file> <app> <command> [argument...]" >&2
  exit 1
fi
file=$1 app=$2
shift 2

# An empty argument, so cluster-env takes lab-sto2 and not this script's own arguments.
# shellcheck source=scripts/cluster-env
. "$here/cluster-env" ""
complete=1
require_commands jq age sha256sum cut stat || complete=0
require_env CLUSTER_S3_ACCESS_KEY_ID CLUSTER_S3_SECRET_ACCESS_KEY BACKUP_BUCKET_PREFIX || complete=0
if [[ -n ${BACKUP_BUCKET_PREFIX:-} ]]; then
  s3_bucket_name_ok BACKUP_BUCKET_PREFIX prefix || complete=0
fi
s3_read_backend || complete=0
require_age_key || complete=0
# The names the component's APP is: a DNS label.
if [[ ! $app =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
  infra_error "the application is not a name: lower-case letters, digits and hyphens, starting and ending with a letter or a digit"
  complete=0
fi
if ! type -P -- "$1" > /dev/null; then
  infra_error "the command to run is not on PATH"
  complete=0
fi
if [[ ! -f $file ]]; then
  infra_error "$file is not a file; give the custody file bao-seed-volsync wrote"
  complete=0
elif ! bao_custody_trusted "$file"; then
  complete=0
fi
((complete))

step="opening $file with the Talos age key"
custody=$(bao_decrypt "$file")
if ! printf '%s' "$custody" | jq -e --arg cluster "$cluster" \
  '.cluster == $cluster and (.volsync.master // "" | test("^[0-9a-f]{64}$"))' > /dev/null; then
  infra_error "$file holds no volsync master for $cluster; give the custody file bao-seed-volsync wrote"
  exit 1
fi
step="deriving the password of $app"
master=$(printf '%s' "$custody" | jq -r '.volsync.master')
custody=
password=$(printf '%s/%s' "$master" "$app" | sha256sum | cut -d' ' -f1)
master=

step="running ${1##*/}"
(
  # No secret of the environment but the ones this command is given.
  while IFS= read -r name; do
    if secret_variable "$name"; then
      export -n "${name?}"
    fi
  done < <(compgen -e)
  export RESTIC_REPOSITORY="s3:$s3_endpoint/$BACKUP_BUCKET_PREFIX-volsync/$app" RESTIC_PASSWORD=$password \
    AWS_ACCESS_KEY_ID=$CLUSTER_S3_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY=$CLUSTER_S3_SECRET_ACCESS_KEY \
    AWS_DEFAULT_REGION=$s3_region
  exec "$@"
)
