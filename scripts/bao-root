#!/usr/bin/env bash
# Runs one command with a fifteen-minute token that has OpenBao's root policy, made from the recovery
# keys in the operator's custody file: the way back to privileged access when a role, a policy or a
# mount has to change after the first start, as the initial configuration never runs again
# (docs/runbooks/openbao.md). As the role operator, through the session of scripts/lib/openbao.sh,
# it starts OpenBao's authenticated root token generation, gives it a threshold of the shares,
# decrypted from FILE with the Talos age key into memory only, and has OpenBao decode the result.
# A root token made so never expires, so it serves only to mint an orphan token with the root
# policy, which expires after fifteen minutes and cannot be renewed, and is revoked at once. The
# command runs with that token in BAO_TOKEN, and OpenBao's address through the port-forward, its CA
# and its certificate's name in BAO_ADDR, BAO_CACERT and BAO_TLS_SERVER_NAME, as OpenBao's CLI reads
# them; it prints what it prints, and nothing here prints a share or a token. The token is revoked
# however the command and this script end, and expires by itself if neither can revoke it; a
# generation started and not finished is cancelled. Every field it reads from OpenBao's
# generate-root and decode answers is under data, as OpenBao's logical backend returns it.
# Usage: scripts/bao-root <file> <command> [argument...]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/openbao.sh
. "$here/lib/openbao.sh"

if (($# < 2)); then
  echo "bao-root: give the custody file bao-recovery wrote and the command to run: just bao-root <file> <command> [argument...]" >&2
  exit 1
fi
file=$1
shift

# An empty argument, so cluster-env takes lab-sto2 and not this script's own arguments.
# shellcheck source=scripts/cluster-env
. "$here/cluster-env" ""
complete=1
require_commands kubectl curl jq base64 age || complete=0
require_kubeconfig || complete=0
require_age_key || complete=0
if [[ ! -f $file ]]; then
  infra_error "$file is not a file; give the custody file bao-recovery wrote"
  complete=0
fi
((complete))

# How long the command's token lives, at most, renewal or not.
lifetime=15m

# generating is 1 from the request that starts a generation until OpenBao has the last share.
generating=0 root_token="" command_token=""

# bao_revoke_with TOKEN: revokes TOKEN, using it to revoke itself.
bao_revoke_with() {
  local operator=${bao_token-} status=0
  bao_token=$1
  bao_request POST auth/token/revoke-self < /dev/null > /dev/null || status=$?
  bao_token=$operator
  return "$status"
}

# bao_abort: revokes the root token and the command's token while they exist, and cancels a
# generation this run started and did not finish, so OpenBao takes a new one later.
bao_abort() {
  if [[ -n $root_token ]]; then
    bao_revoke_with "$root_token" || infra_error "could not revoke the root token; revoke it with OpenBao's API as soon as OpenBao answers"
    root_token=""
  fi
  if [[ -n $command_token ]]; then
    bao_revoke_with "$command_token" || infra_error "could not revoke the command's token; it expires $lifetime after it was made"
    command_token=""
  fi
  if ((generating)); then
    bao_request DELETE sys/generate-root-token/attempt > /dev/null 2>&1 || true
  fi
}

step="opening $file with the Talos age key"
custody=$(bao_decrypt "$file")
if ! printf '%s' "$custody" | jq -e '.recovery.keys_base64 | length > 0' > /dev/null; then
  infra_error "$file holds no recovery keys"
  exit 1
fi

bao_open
bao_login

# One generation runs at a time; one left by a run that was cut short is cancelled.
step="cancelling a root token generation left in progress"
if bao_request GET sys/generate-root-token/attempt | jq -e '.data.started == true' > /dev/null; then
  bao_request DELETE sys/generate-root-token/attempt > /dev/null
fi

step="starting a root token generation"
generating=1
# Without an otp, OpenBao makes the one-time password the token is encoded with and returns it.
attempt=$(printf '{}' | bao_request PUT sys/generate-root-token/attempt)
required=$(printf '%s' "$attempt" | jq -r '.data.required')
if [[ ! $required =~ ^[1-9][0-9]*$ ]]; then
  infra_error "OpenBao did not say how many recovery key shares the generation takes"
  exit 1
fi
step="giving OpenBao $required recovery key shares"
for ((share = 0; share < required; share++)); do
  progress=$({
    printf '%s\n' "$attempt"
    printf '%s\n' "$custody"
  } | jq -sc --argjson share "$share" '{key: .[1].recovery.keys_base64[$share], nonce: .[0].data.nonce}' |
    bao_request PUT sys/generate-root-token/update)
done
custody=
if ! printf '%s' "$progress" | jq -e '.data.complete == true' > /dev/null; then
  infra_error "OpenBao did not complete the root token generation"
  exit 1
fi
generating=0

step="decoding the root token"
root_token=$({
  printf '%s\n' "$attempt"
  printf '%s\n' "$progress"
} | jq -sc '{encoded_token: .[1].data.encoded_token, otp: .[0].data.otp}' | bao_request POST sys/decode-token |
  jq -r '.data.token // empty')
attempt="" progress=""
if [[ -z $root_token ]]; then
  infra_error "OpenBao decoded no root token"
  exit 1
fi

# The root token mints the command's token and is revoked at once; if minting fails, the root token
# is revoked on the way out and nothing runs.
step="making the command's token"
command_token=$(jq -nc --arg lifetime "$lifetime" \
  '{policies: ["root"], ttl: $lifetime, explicit_max_ttl: $lifetime, renewable: false}' |
  { bao_token=$root_token bao_request POST auth/token/create-orphan; } | jq -r '.auth.client_token // empty')
step="revoking the root token"
bao_revoke_with "$root_token"
root_token=""
if [[ -z $command_token ]]; then
  infra_error "OpenBao made no token for the command"
  exit 1
fi

step="running $1"
ran=0
BAO_TOKEN=$command_token BAO_ADDR="https://localhost:$bao_local_port" BAO_CACERT="$work_dir/ca.crt" \
  BAO_TLS_SERVER_NAME=$bao_host "$@" || ran=$?
step="revoking the command's token"
bao_revoke_with "$command_token"
command_token=""
if ((ran != 0)); then
  step="running $1"
  infra_error "$1 exited $ran; its token is revoked"
  exit "$ran"
fi
echo "bao-root: $1 ran with a $lifetime token of the root policy, which is revoked"
