#!/usr/bin/env bash
# Destroys a cluster: its stack, the cluster stack sto2/cluster, through infra-destroy, which plans
# the destroy, prints the plan's summary, destroys once the stack's name is typed back, or with
# --yes, and then removes the files generated for the cluster that hold its addresses. The plumbing
# stack, the secrets bundle and the buckets stay.
#
# The stack holds one cluster, and destroying it destroys that cluster whatever name was given. So
# before it asks the cluster anything, whatever flags are given, it refuses a name other than the
# cluster name in the stack's talman_yaml output, naming that cluster, and the name of a cluster with
# no directory under talos/.
#
# The load balancers that Services of type LoadBalancer get and the volumes behind PersistentVolumes
# of a CSI driver are made by the cluster, not by OpenTofu, so the stack's destroy would leave them
# in the cloud, where they also keep the network from being deleted. infra-destroy, which this
# recipe runs, asks the cluster for them through its kubeconfig before it plans, whichever way the
# stack is destroyed (require_cluster_owns_nothing in lib/cluster.sh): while there are any it names
# them and destroys nothing; LINSTOR's volumes, whose data is on the workers' data volumes in the
# stack, are counted and go with it; a cluster that cannot be asked is not destroyed unless
# --unreachable is given.
# Usage: scripts/cluster-destroy [cluster] [--yes] [--unreachable]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/cluster.sh
. "$here/lib/cluster.sh"

usage() {
  infra_error "usage: cluster-destroy [cluster] [--yes] [--unreachable]"
  exit 2
}

cluster='' confirmed=0 unreachable=0
for arg; do
  case $arg in
    --yes) confirmed=1 ;;
    --unreachable) unreachable=1 ;;
    -*) usage ;;
    *)
      [[ -z $cluster ]] || usage
      cluster=$arg
      ;;
  esac
done
stack=sto2/cluster

# shellcheck source=scripts/cluster-env
. "$here/cluster-env" "$cluster"

# stack_env: reads and checks what infra-destroy needs for the stack, as infra-destroy does, naming
# what is missing. Run in a subshell, it leaves this script's environment as it is.
stack_env() {
  # shellcheck source=scripts/stack-env
  . "$here/stack-env" "$stack"
}

# So that nothing runs while any of it is missing; what it prints is shown only when something is.
if ! checked=$(stack_env 2>&1); then
  printf '%s\n' "$checked" >&2
  exit 1
fi

# stack_holds: the name of the cluster the stack holds. Run in a subshell, so the stack's lock is
# released before infra-destroy takes it.
stack_holds() {
  # shellcheck source=scripts/stack-env
  . "$here/stack-env" "$stack" || return 1
  lock_stack || return 1
  init_stack || return 1
  stack_cluster_name
}
step="checking that $cluster is the cluster $stack holds"
stack_cluster=$(stack_holds) || exit 1
if [[ $stack_cluster != "$cluster" ]]; then
  if [[ -n $stack_cluster ]]; then
    infra_error "$stack holds $stack_cluster, not $cluster; it destroys that cluster only: just cluster-destroy $stack_cluster. Nothing was destroyed"
  else
    infra_error "$stack's outputs name no cluster, so it cannot be told to be $cluster. Nothing was destroyed"
  fi
  exit 1
fi
# cluster-secrets and infra-talman run before a cluster's directory exists, which is why cluster-env
# does not refuse a name without one and this recipe does.
if [[ ! -d $cluster_dir ]]; then
  infra_error "talos/$cluster does not exist, though $stack holds $cluster"
  exit 1
fi

step="destroying $stack"
flags=()
((!confirmed)) || flags+=(--yes)
((!unreachable)) || flags+=(--unreachable)
"$here/infra-destroy" "$stack" "${flags[@]}"
