#!/usr/bin/env bash
# Destroys a cluster: its stack, the cluster stack sto2/cluster, through infra-destroy, which plans
# the destroy, prints the plan's summary, destroys once the stack's name is typed back, or with
# --yes, and then removes the files generated for the cluster that hold its addresses. The plumbing
# stack, the secrets bundle and the buckets stay.
#
# A load balancer a cloud controller makes for a Service of type LoadBalancer, and the volume behind
# a PersistentVolume of a CSI driver, are made by the cluster, not by OpenTofu, so the stack's
# destroy would leave them in the cloud, where they also keep the network from being deleted. So
# first, through the cluster's kubeconfig, it lists every such Service and PersistentVolume, and
# while there are any, it names them and destroys nothing. A Service whose every load-balancer
# address lies in the service range of the cluster's talman.yaml is left out: Cilium gave it that
# address from its pool, the workers announce it over BGP, and nothing in the cloud stands behind it
# (ADR 0013). A Service with no address yet, or one outside the range, still counts, as does every
# such Service when talman.yaml names no service range. LINSTOR's volumes are the other exception:
# their data is on the workers' data volumes, which the stack holds and destroys, so nothing of
# them stays in the cloud. They do not hold the destroy up; it says how many there are before it
# asks, and confirming the destroy confirms that they go with it. A cluster whose API does not
# answer, or that has no kubeconfig, cannot be asked and may still own some, so it is not destroyed
# either, unless --unreachable is given, with which the operator takes on what may be left. Neither
# kubectl's errors nor anything of the objects but their names are printed, as they can hold
# addresses.
# Usage: scripts/cluster-destroy [cluster] [--yes] [--unreachable]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/cluster.sh
. "$here/lib/cluster.sh"

usage() {
  infra_error "usage: cluster-destroy [cluster] [--yes] [--unreachable]"
  exit 2
}

cluster='' confirmed=0 unreachable=0
for arg; do
  case $arg in
    --yes) confirmed=1 ;;
    --unreachable) unreachable=1 ;;
    -*) usage ;;
    *)
      [[ -z $cluster ]] || usage
      cluster=$arg
      ;;
  esac
done
stack=sto2/cluster
# LINSTOR's CSI driver, whose volumes are on the workers' data volumes in the stack.
linstor_driver=linstor.csi.linbit.com

# shellcheck source=scripts/cluster-env
. "$here/cluster-env" "$cluster"
require_commands kubectl jq yq

# stack_env: reads and checks what infra-destroy needs for the stack, as infra-destroy does, naming
# what is missing. Run in a subshell, it leaves this script's environment as it is.
stack_env() {
  # shellcheck source=scripts/stack-env
  . "$here/stack-env" "$stack"
}

# So that nothing runs while any of it is missing; what it prints is shown only when something is.
if ! checked=$(stack_env 2>&1); then
  printf '%s\n' "$checked" >&2
  exit 1
fi

say() {
  printf '%s: %s\n' "${0##*/}" "$1"
}

step="asking $cluster for its load balancers and volumes"
asked=0
if [[ ! -f $KUBECONFIG ]]; then
  why="${KUBECONFIG#"$infra_root"/} does not exist"
elif services=$(kubectl get services --all-namespaces --output json --request-timeout=30s 2> /dev/null) &&
  volumes=$(kubectl get persistentvolumes --output json --request-timeout=30s 2> /dev/null); then
  asked=1
else
  why="the API of $cluster does not answer through its kubeconfig"
fi

if ((asked)); then
  # The service range the cluster stack rendered into talman.yaml; without one, no address counts as
  # the pool's.
  service_range=
  if [[ -f $talman_file ]]; then
    service_range=$(yq '.values.serviceRange // ""' "$talman_file" 2> /dev/null) || service_range=
  fi
  balancers=$(jq -r --arg range "$service_range" '
    def ip4: split(".") | map(tonumber) | .[0] * 16777216 + .[1] * 65536 + .[2] * 256 + .[3];
    def in_range($cidr): ($cidr | split("/")) as $net | pow(2; 32 - ($net[1] | tonumber)) as $size
      | ((ip4 / $size) | floor) == (($net[0] | ip4) / $size | floor);
    def ipv4: type == "string" and test("^[0-9]{1,3}(\\.[0-9]{1,3}){3}$");
    def from_pool: if .hostname == null and (.ip | ipv4) then .ip | in_range($range) else false end;
    ($range | test("^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$")) as $known
    | .items[] | select(.spec.type == "LoadBalancer")
    | (.status.loadBalancer.ingress // []) as $ingress
    | select(if $known and ($ingress | length) > 0 then ($ingress | all(from_pool)) | not else true end)
    | "\(.metadata.namespace)/\(.metadata.name)"' <<< "$services")
  csi_volumes=$(jq -r --arg linstor "$linstor_driver" '.items[]
    | select(.spec.csi != null and .spec.csi.driver != $linstor)
    | "\(.metadata.name) \(.spec.csi.driver // "unnamed")"' <<< "$volumes")
  linstor_volumes=$(jq --arg linstor "$linstor_driver" '[.items[] | select(.spec.csi.driver? == $linstor)] | length' <<< "$volumes")
  if [[ -n $balancers || -n $csi_volumes ]]; then
    while read -r name; do
      [[ -z $name ]] || infra_error "the Service $name is of type LoadBalancer, without an address from the service range"
    done <<< "$balancers"
    while read -r name driver; do
      [[ -z $name ]] || infra_error "the PersistentVolume $name is a volume of the CSI driver $driver"
    done <<< "$csi_volumes"
    infra_error "$cluster still owns load balancers or volumes that are not in the state of $stack, which a destroy would leave in the cloud, keeping the network from being deleted; remove them first. Nothing was destroyed"
    exit 1
  fi
  if ((linstor_volumes == 0)); then
    say "$cluster owns no Service of type LoadBalancer outside its service range and no PersistentVolume of a CSI driver"
  else
    say "$cluster owns no Service of type LoadBalancer outside its service range and no PersistentVolume of a CSI driver other than LINSTOR's"
    if ((linstor_volumes == 1)); then
      counted="1 PersistentVolume of LINSTOR ($linstor_driver), whose data is on the workers' data volumes in $stack: it is"
    else
      counted="$linstor_volumes PersistentVolumes of LINSTOR ($linstor_driver), whose data is on the workers' data volumes in $stack: they are"
    fi
    say "$cluster has $counted destroyed with the stack, and confirming its destroy confirms that"
  fi
elif ((unreachable)); then
  say "$why; with --unreachable it is destroyed without being asked, and a load balancer or volume it owns stays in the cloud"
else
  infra_error "$why, so $cluster cannot be asked whether it owns load balancers or volumes, which are not in the state of $stack. Nothing was destroyed; --unreachable destroys it without asking, leaving any it owns in the cloud"
  exit 1
fi

step="destroying $stack"
flags=()
((!confirmed)) || flags+=(--yes)
"$here/infra-destroy" "$stack" "${flags[@]}"
