#!/usr/bin/env bash
# Says whether a cluster's public Gateway serves, reading only: the objects through the cluster's
# kubeconfig, then requests through each edge router's floating address, from the edge stack's
# outputs, with curl --resolve, as a client outside would make them once the names are in DNS.
# Prints pass, FAIL or skip for each check, with one line of why, and exits 0 only when none fails:
#   cluster-config         flux-system/cluster-config holds CLUSTER_DOMAIN and GATEWAY_ADDRESS, which
#                          the checks below compare with;
#   Gateway                the Gateway public in envoy-gateway-system is Accepted and Programmed;
#   Gateway address        its status gives the GATEWAY_ADDRESS of cluster-config;
#   proxy Service          the Service Envoy Gateway makes for its proxies is of type LoadBalancer
#                          and carries the label k8s-gitops/announce: bgp;
#   proxy Service address  it holds the GATEWAY_ADDRESS;
#   proxies                two proxies, or more, are Ready, on different nodes;
#   certificate            the Certificate whose Secret the https listener serves is Ready;
#   cluster CA             the public certificate of the CA its issuer signs with is read: the
#                          tls.crt of the issuer's Secret, by a path that names that one key;
#   routes                 no HTTPRoute is Accepted on the Gateway from a namespace without the label
#                          k8s-gitops/gateway: public, but for the redirect in the Gateway's own;
#   http listener          the http listener holds one route, the redirect;
# and for each edge router, by its name (one skipped line says why when the edge stack has no
# outputs, and a failed one when they cannot be read):
#   EDGE http              plain HTTP on 80 for hello.<CLUSTER_DOMAIN> answers 301 with the Location
#                          https://hello.<CLUSTER_DOMAIN> and the same path;
#   EDGE TLS               HTTPS on 443 for it verifies against the cluster CA's certificate, chain
#                          and name, with nothing else trusted;
#   EDGE certificate names the certificate served names it, read from what curl shows of it, which
#                          says, when TLS fails, whether the names are the cause;
#   EDGE hello             the demo answers 200 with the page of its ConfigMap demo/hello;
#   EDGE unrouted host     a host under the domain that no route serves answers 404.
# It runs kubectl get, tofu init and output on the edge stack, and curl. It prints object, node and
# edge names, never an address, a host name under the domain, what the CA's Secret holds, or a
# tool's own errors, which can name addresses. kubectl is bounded by --request-timeout and curl by
# --connect-timeout and --max-time, and curl reads no configuration file and uses no proxy. Needs
# curl 7.88 or newer, for its write-out of the certificates.
# Usage: scripts/gateway-check [cluster]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/cluster.sh
. "$here/lib/cluster.sh"
# shellcheck source=scripts/lib/edge.sh
. "$here/lib/edge.sh"

if (($# > 1)) || [[ ${1-} == -* ]]; then
  infra_error "usage: gateway-check [cluster]"
  exit 2
fi

# shellcheck source=scripts/cluster-env
. "$here/cluster-env" "${1-}"
complete=1
require_kubeconfig || complete=0
require_commands kubectl jq curl base64 || complete=0
((complete))

# The Gateway and where its parts are, as the tree makes them (docs/kubernetes.md, The public
# Gateway); cert-manager keeps a ClusterIssuer's Secret in its own namespace.
gateway=public
namespace=envoy-gateway-system
issuer_namespace=cert-manager
proxy_selector=app.kubernetes.io/component=proxy,gateway.envoyproxy.io/owning-gateway-name=$gateway,gateway.envoyproxy.io/owning-gateway-namespace=$namespace
opt_in=k8s-gitops/gateway=public
redirect=https-redirect
# The path plain HTTP is asked for, which the redirect keeps, and a host under the domain no route
# serves.
probe_path=/gateway-check
unrouted='gateway-check-unrouted'

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

failures=0 checks=0 skipped=()
# result VERDICT CHECK WHY: one check's result, pass, FAIL or skip, with its name and why.
result() {
  printf '%-4s  %s: %s\n' "$1" "$2" "$3"
  checks=$((checks + 1))
  case $1 in
    FAIL) failures=$((failures + 1)) ;;
    skip) skipped+=("$2") ;;
  esac
}

# get ARG...: kubectl get ARG... as JSON. Its errors are left out, as they can name the API server's
# address.
get() {
  kubectl get "$@" --output=json --request-timeout=10s 2> /dev/null
}

# joined: the lines on standard input, joined with commas.
joined() {
  paste -sd, - | sed 's/,/, /g'
}

# condition JSON TYPE: the status of the condition TYPE of the object, or Unknown.
condition() {
  jq -r --arg type "$2" '[.status.conditions[]? | select(.type == $type) | .status] | first // "Unknown"' <<< "$1"
}

# reason JSON TYPE: the reason of the condition TYPE, a word, never its message.
reason() {
  jq -r --arg type "$2" '[.status.conditions[]? | select(.type == $type) | .reason // "no reason"] | first // "no condition"
    | if test("^[A-Za-z]+$") then . else "a reason that is not a word" end' <<< "$1"
}

step="checking the Gateway"
domain='' address=''
dns_name='^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'
ipv4='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
if ! config=$(get configmap cluster-config --namespace=flux-system); then
  result FAIL cluster-config "kubectl could not read flux-system/cluster-config"
else
  domain=$(jq -r '.data.CLUSTER_DOMAIN // ""' <<< "$config")
  address=$(jq -r '.data.GATEWAY_ADDRESS // ""' <<< "$config")
  if [[ ! $domain =~ $dns_name ]]; then
    result FAIL cluster-config "its CLUSTER_DOMAIN is not a DNS name"
    domain=''
  elif [[ ! $address =~ $ipv4 ]]; then
    result FAIL cluster-config "its GATEWAY_ADDRESS is not an IPv4 address"
    address=''
  else
    result pass cluster-config "holds CLUSTER_DOMAIN and GATEWAY_ADDRESS"
  fi
fi

listeners='' https_secret=''
if ! gateway_json=$(get gateways.gateway.networking.k8s.io "$gateway" --namespace="$namespace"); then
  result FAIL Gateway "kubectl could not read $namespace/$gateway"
  result FAIL "Gateway address" "kubectl could not read $namespace/$gateway"
else
  listeners=$(jq -c '.status.listeners // []' <<< "$gateway_json")
  https_secret=$(jq -r '[.spec.listeners[]? | select(.name == "https") | .tls.certificateRefs[]? | select((.kind // "Secret") == "Secret") | .name] | first // ""' <<< "$gateway_json")
  if [[ $(condition "$gateway_json" Accepted) != True ]]; then
    result FAIL Gateway "not Accepted: $(reason "$gateway_json" Accepted)"
  elif [[ $(condition "$gateway_json" Programmed) != True ]]; then
    result FAIL Gateway "Accepted, not Programmed: $(reason "$gateway_json" Programmed)"
  else
    result pass Gateway "$namespace/$gateway is Accepted and Programmed"
  fi
  if [[ -z $address ]]; then
    result skip "Gateway address" "no GATEWAY_ADDRESS from cluster-config to compare with"
  elif jq -e --arg address "$address" 'any(.status.addresses[]?; .value == $address)' <<< "$gateway_json" > /dev/null; then
    result pass "Gateway address" "its status gives the GATEWAY_ADDRESS of cluster-config"
  elif jq -e '(.status.addresses // []) | length == 0' <<< "$gateway_json" > /dev/null; then
    result FAIL "Gateway address" "its status gives no address"
  else
    result FAIL "Gateway address" "its status gives another address than the GATEWAY_ADDRESS of cluster-config"
  fi
fi

if ! services=$(get services --namespace="$namespace" --selector="$proxy_selector"); then
  result FAIL "proxy Service" "kubectl could not read the Services of $namespace"
  result FAIL "proxy Service address" "kubectl could not read the Services of $namespace"
else
  count=$(jq '.items | length' <<< "$services")
  service=$(jq -c '.items[0] // {}' <<< "$services")
  name=$(jq -r '.metadata.name // ""' <<< "$service")
  if ((count != 1)); then
    result FAIL "proxy Service" "$count Services of the Gateway's proxies, not one"
  elif [[ $(jq -r '.spec.type' <<< "$service") != LoadBalancer ]]; then
    result FAIL "proxy Service" "$name is of type $(jq -r '.spec.type' <<< "$service"), not LoadBalancer"
  elif [[ $(jq -r '.metadata.labels["k8s-gitops/announce"] // ""' <<< "$service") != bgp ]]; then
    result FAIL "proxy Service" "$name lacks the label k8s-gitops/announce: bgp, so no worker announces it"
  else
    result pass "proxy Service" "$name is of type LoadBalancer, labelled k8s-gitops/announce: bgp"
  fi
  if ((count != 1)); then
    result FAIL "proxy Service address" "no one Service of the Gateway's proxies to read"
  elif [[ -z $address ]]; then
    result skip "proxy Service address" "no GATEWAY_ADDRESS from cluster-config to compare with"
  elif jq -e --arg address "$address" 'any(.status.loadBalancer.ingress[]?; .ip == $address)' <<< "$service" > /dev/null; then
    result pass "proxy Service address" "$name holds the GATEWAY_ADDRESS"
  elif jq -e '(.status.loadBalancer.ingress // []) | length == 0' <<< "$service" > /dev/null; then
    result FAIL "proxy Service address" "$name holds no address yet"
  else
    result FAIL "proxy Service address" "$name holds another address than the GATEWAY_ADDRESS"
  fi
fi

if ! pods=$(get pods --namespace="$namespace" --selector="$proxy_selector"); then
  result FAIL proxies "kubectl could not read the pods of $namespace"
else
  total=$(jq '.items | length' <<< "$pods")
  ready=$(jq '[.items[] | select(any(.status.conditions[]?; .type == "Ready" and .status == "True"))] | length' <<< "$pods")
  nodes=$(jq -r '[.items[] | select(any(.status.conditions[]?; .type == "Ready" and .status == "True")) | .spec.nodeName // empty] | unique | .[]' <<< "$pods")
  node_count=$(grep -c . <<< "$nodes" || true)
  if ((ready < 2)); then
    result FAIL proxies "$ready of $total proxies Ready, fewer than two"
  elif ((node_count < 2)); then
    result FAIL proxies "$ready proxies Ready, all on $(joined <<< "$nodes")"
  else
    result pass proxies "$ready of $total proxies Ready, on $(joined <<< "$nodes")"
  fi
fi

issuer=''
if ! certificates=$(get certificates.cert-manager.io --namespace="$namespace"); then
  result FAIL certificate "kubectl could not read the Certificates of $namespace"
else
  certificate=$(jq -c --arg secret "$https_secret" '[.items[] | select(.spec.secretName == $secret)] | first // {}' <<< "$certificates")
  name=$(jq -r '.metadata.name // ""' <<< "$certificate")
  if [[ -z $https_secret || -z $name ]]; then
    result FAIL certificate "no Certificate in $namespace makes the Secret the https listener serves"
  elif [[ $(condition "$certificate" Ready) != True ]]; then
    result FAIL certificate "$name is not Ready: $(reason "$certificate" Ready)"
  else
    result pass certificate "$name, the https listener's, is Ready"
  fi
  if [[ -n $name ]]; then
    issuer=$(jq -r 'if (.spec.issuerRef.kind // "Issuer") == "ClusterIssuer" and (.spec.issuerRef.group // "cert-manager.io") == "cert-manager.io"
      then .spec.issuerRef.name else "" end' <<< "$certificate")
  fi
fi

# The CA's public certificate, by the one key of its Secret that holds it: the Secret's private key
# never leaves the API server in kubectl's output, and the certificate is written to a file of this
# run, never printed.
ca_file=$tmp/ca.crt
ca=0
if [[ -z $issuer ]]; then
  result FAIL "cluster CA" "the Gateway's Certificate names no ClusterIssuer to read a CA from"
elif ! issuer_json=$(get clusterissuers.cert-manager.io "$issuer") ||
  ! ca_secret=$(jq -re '.spec.ca.secretName // empty' <<< "$issuer_json"); then
  result FAIL "cluster CA" "the ClusterIssuer $issuer is not a CA issuer kubectl could read"
elif ! encoded=$(kubectl get secret "$ca_secret" --namespace="$issuer_namespace" --output='jsonpath={.data.tls\.crt}' --request-timeout=10s 2> /dev/null) ||
  ! base64 -d <<< "$encoded" > "$ca_file" 2> /dev/null || ! grep -q '^-----BEGIN CERTIFICATE-----' "$ca_file"; then
  result FAIL "cluster CA" "kubectl could not read the certificate of $issuer_namespace/$ca_secret"
else
  result pass "cluster CA" "read the public certificate of $issuer_namespace/$ca_secret, which $issuer signs with"
  ca=1
fi

labelled=''
if ! namespaces=$(get namespaces --selector="$opt_in") || ! routes=$(get httproutes.gateway.networking.k8s.io --all-namespaces); then
  result FAIL routes "kubectl could not read the namespaces or the HTTPRoutes"
else
  labelled=$(jq -c '[.items[].metadata.name]' <<< "$namespaces")
  # Every route Accepted on the Gateway, whatever listener, outside the namespaces that opt in, but
  # for the redirect in the Gateway's own.
  outside=$(jq -r --arg gateway "$gateway" --arg namespace "$namespace" --arg redirect "$redirect" --argjson labelled "$labelled" '
    .items[] | .metadata as $route
    | select(any(.status.parents[]?; .parentRef.name == $gateway
        and (.parentRef.kind // "Gateway") == "Gateway"
        and (.parentRef.namespace // $route.namespace) == $namespace
        and any(.conditions[]?; .type == "Accepted" and .status == "True")))
    | select(($route.namespace | IN($labelled[])) | not)
    | select(($route.namespace == $namespace and $route.name == $redirect) | not)
    | "\($route.namespace)/\($route.name)"' <<< "$routes" | joined)
  accepted=$(jq --arg gateway "$gateway" --arg namespace "$namespace" '[.items[] | .metadata as $route
    | select(any(.status.parents[]?; .parentRef.name == $gateway and (.parentRef.namespace // $route.namespace) == $namespace
        and any(.conditions[]?; .type == "Accepted" and .status == "True")))] | length' <<< "$routes")
  if [[ -n $outside ]]; then
    result FAIL routes "Accepted on $gateway from a namespace without the label $opt_in: $outside"
  else
    result pass routes "$accepted routes Accepted on $gateway, each from a namespace labelled $opt_in or the redirect"
  fi
fi

if [[ -z $listeners ]]; then
  result FAIL "http listener" "kubectl could not read $namespace/$gateway"
else
  attached=$(jq -r '[.[] | select(.name == "http") | .attachedRoutes] | first // "no"' <<< "$listeners")
  if [[ $attached == 1 ]]; then
    result pass "http listener" "holds one route, the redirect"
  else
    result FAIL "http listener" "holds $attached routes, not the redirect alone"
  fi
fi

# The page the demo serves, which its answer through an edge must be.
page=''
page_read=0
if page=$(kubectl get configmap hello --namespace=demo --output='jsonpath={.data.index\.html}' --request-timeout=10s 2> /dev/null); then
  page_read=1
fi

# edges: each edge router's name and floating address, "NAME ADDRESS" per line, from the edge
# stack's outputs (edge_load): returns 2 when the stack has none, as before it is applied, and 1
# when they cannot be read. Run in a subshell, so the stack's environment and lock stay in it; the
# addresses go to the caller only.
edges() {
  local outputs i
  # shellcheck source=scripts/stack-env
  . "$here/stack-env" sto2/edge || return 1
  lock_stack || return 1
  init_stack || return 1
  outputs=$(stack_tofu output -json) || return 1
  jq -e '(.addresses.value // []) | length > 0' <<< "$outputs" > /dev/null || return 2
  edge_load || return 1
  for i in 0 1; do
    printf '%s %s\n' "${edge_names[i]}" "${edge_addresses[i]}"
  done
}

# request ADDRESS PORT HOST PATH OUTPUT FORMAT [ARG...]: curl for HOST on PORT, connecting to ADDRESS,
# with ARG..., the body to OUTPUT; prints what FORMAT writes out and returns curl's status. curl
# reads no .curlrc, uses no proxy and follows no redirect. Its errors name the address, so they are
# left out.
request() {
  local address=$1 port=$2 host=$3 path=$4 output=$5 format=$6 scheme=http
  shift 6
  if ((port == 443)); then
    scheme=https
  fi
  curl --disable --silent --noproxy '*' --connect-timeout 5 --max-time 15 --resolve "$host:$port:$address" \
    --output "$output" --write-out "$format" "$@" "$scheme://$host$path" 2> /dev/null
}

# covers HOST: whether the first certificate curl showed, in certs, names HOST, by name or by a
# wildcard for its first label.
covers() {
  local names name
  names=$(awk '/^Subject:/ { n++ } n == 1 && sub(/^X509v3 Subject Alternative Name:/, "") { print }' <<< "$certs")
  while IFS= read -r name; do
    name=${name# }
    name=${name#DNS:}
    if [[ $name == "$1" ]] || [[ $name == '*.'* && $1 == *.*.* && ${1#*.} == "${name#*.}" ]]; then
      return 0
    fi
  done <<< "${names//,/$'\n'}"
  return 1
}

# check_edge NAME ADDRESS: the lines of one edge router.
check_edge() {
  local edge=$1 edge_address=$2 host=hello.$domain answer code location status certs tls=0
  status=0
  answer=$(request "$edge_address" 80 "$host" "$probe_path" /dev/null '%{http_code} %header{location}') || status=$?
  code=${answer%% *} location=${answer#* }
  if ((status != 0)); then
    result FAIL "$edge http" "no answer on port 80 (curl exit $status)"
  elif [[ $code != 301 ]]; then
    result FAIL "$edge http" "plain HTTP for hello answered $code, not 301"
  elif [[ $location != "https://$host$probe_path" ]]; then
    result FAIL "$edge http" "plain HTTP for hello is sent elsewhere than https on the same host and path"
  else
    result pass "$edge http" "plain HTTP for hello answers 301 to https on the same host and path"
  fi

  if ((!ca)); then
    result skip "$edge TLS" "no certificate of the cluster's CA to verify with"
    result skip "$edge certificate names" "no certificate of the cluster's CA to verify with"
  else
    status=0
    answer=$(request "$edge_address" 443 "$host" / "$tmp/page" '%{http_code}\n%{certs}' --cacert "$ca_file") || status=$?
    code=${answer%%$'\n'*}
    certs=${answer#*$'\n'}
    if ((status == 0)); then
      result pass "$edge TLS" "HTTPS for hello verifies against the cluster's CA"
      result pass "$edge certificate names" "the certificate served names hello under the cluster's domain"
      tls=1
    elif ((status == 60)); then
      result FAIL "$edge TLS" "HTTPS for hello does not verify against the cluster's CA for its name (curl exit 60)"
      if ! grep -q '^Subject:' <<< "$certs"; then
        result skip "$edge certificate names" "curl showed no certificate to read the names of"
      elif covers "$host"; then
        result pass "$edge certificate names" "the certificate served names hello under the cluster's domain, so its chain is what fails"
      else
        result FAIL "$edge certificate names" "the certificate served does not name hello under the cluster's domain"
      fi
    else
      result FAIL "$edge TLS" "no TLS answer on port 443 (curl exit $status)"
      result skip "$edge certificate names" "no TLS answer to read a certificate from"
    fi
  fi

  if ((!tls)); then
    result skip "$edge hello" "no verified TLS connection"
    result skip "$edge unrouted host" "no verified TLS connection"
    return
  fi
  if ((!page_read)); then
    result FAIL "$edge hello" "kubectl could not read the page of demo/hello to compare with"
  elif [[ $code != 200 ]]; then
    result FAIL "$edge hello" "the demo answered $code, not 200"
  elif [[ $(< "$tmp/page") != "$page" ]]; then
    result FAIL "$edge hello" "the demo answered 200 with another page than its ConfigMap's"
  else
    result pass "$edge hello" "the demo answers 200 with its page"
  fi
  status=0
  answer=$(request "$edge_address" 443 "$unrouted.$domain" / /dev/null '%{http_code}' --cacert "$ca_file") || status=$?
  if ((status != 0)); then
    result FAIL "$edge unrouted host" "no verified answer for a host no route serves (curl exit $status)"
  elif [[ $answer != 404 ]]; then
    result FAIL "$edge unrouted host" "a host under the domain that no route serves answered $answer, not 404"
  else
    result pass "$edge unrouted host" "a host under the domain that no route serves answers 404"
  fi
}

step="checking through the edge routers"
if [[ -z $domain ]]; then
  result skip edges "no CLUSTER_DOMAIN from cluster-config to ask for, so no edge is checked"
else
  edges_status=0
  listing=$(edges) || edges_status=$?
  if ((edges_status == 2)); then
    result skip edges "the edge stack sto2/edge has no outputs: it is not applied, so no edge is checked"
  elif ((edges_status != 0)); then
    result FAIL edges "the edge stack's outputs could not be read, for the reason above"
  else
    mapfile -t listed <<< "$listing"
    for entry in "${listed[@]}"; do
      check_edge "${entry%% *}" "${entry#* }"
    done
  fi
fi

if ((failures > 0)); then
  infra_error "$failures of $checks checks failed"
  exit 1
fi
summary="every check of the public Gateway of $cluster passes"
if ((${#skipped[@]} > 0)); then
  summary+="; skipped: $(printf '%s\n' "${skipped[@]}" | joined)"
fi
echo "gateway-check: $summary"
