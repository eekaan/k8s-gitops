#!/usr/bin/env bash
# Checks, reading only, over SSH, that both edge routers (or the one named with --edge) are serving:
# FRR runs; as many BGP sessions are established as the cluster's talman.yaml lists workers, and,
# from each worker's own address there, which worker has none; the table holds only /32s inside
# the service range; each has as many next hops as there are sessions, or fewer, which is for a
# person to read, as a Service that is local-only is announced by some workers only; FRR is
# configured with the reject route for the service range, which is in the kernel; the nftables
# rules are loaded, and their forward chain passes a translated connection's packets toward the
# Gateway, new or established, only through a worker, its guard holding every worker's address and
# not the default route's next hop; the kernel forwards, and not without the rules; and unattended
# upgrades are off, as an edge is rebuilt, not patched. Prints pass, FAIL or skip per line, never an
# address, and exits non-zero on any FAIL.
# A check that needs the cluster's talman.yaml is skipped while it does not exist.
# Usage: scripts/edge-check [--edge 1|2] [cluster]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/edge.sh
. "$here/lib/edge.sh"

only='' cluster=lab-sto2
while (($#)); do
  case $1 in
    --edge)
      [[ ${2-} == 1 || ${2-} == 2 ]] || {
        infra_error "usage: edge-check [--edge 1|2] [cluster]"
        exit 2
      }
      only=$2
      shift 2
      ;;
    -*)
      infra_error "usage: edge-check [--edge 1|2] [cluster]"
      exit 2
      ;;
    *)
      cluster=$1
      shift
      ;;
  esac
done
if [[ ! $cluster =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
  infra_error "$cluster is not a cluster: name a directory under talos/, such as lab-sto2"
  exit 1
fi
# shellcheck source=scripts/stack-env
. "$here/stack-env" sto2/edge
# scripts/edge-rollout holds the stack's lock while it runs this.
if [[ -z ${EDGE_STACK_LOCKED-} ]]; then
  lock_stack
fi
init_stack
edge_connect "$only"

talman=$infra_root/talos/$cluster/talman.yaml
# The workers, each with its own address on the node subnet, which the cluster stack writes into
# talman.yaml, and the Gateway's address.
workers=() worker_addresses=() service_range='' gateway=''
if [[ -f $talman ]]; then
  mapfile -t workers < <(yq '.nodes[] | select(.role == "worker") | .hostname' "$talman")
  mapfile -t worker_addresses < <(yq '.nodes[] | select(.role == "worker") | .values.privateAddress // ""' "$talman")
  service_range=$(yq '.values.serviceRange // ""' "$talman")
  gateway=$(yq '.values.bgp.gatewayAddress // ""' "$talman")
fi
# A talman.yaml written before it carried each node's own address gives a worker none, and a
# session or a guard cannot be matched to that worker: the lines that need it fail, saying so.
unaddressed=()
for i in "${!workers[@]}"; do
  [[ -n ${worker_addresses[i]-} ]] || unaddressed+=("${workers[i]}")
done
no_address="talman.yaml has no privateAddress for ${unaddressed[*]}; run just infra-talman, after just infra-apply sto2/cluster if the stack's output has none either"

ipv4_number() {
  local -a octets
  IFS=. read -r -a octets <<< "$1"
  echo $(((10#${octets[0]} << 24) | (10#${octets[1]} << 16) | (10#${octets[2]} << 8) | 10#${octets[3]}))
}
# in_range PREFIX: whether PREFIX is a /32 inside the service range.
in_range() {
  local bits=${service_range#*/} mask
  [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/32$ ]] || return 1
  mask=$(((0xffffffff << (32 - bits)) & 0xffffffff))
  ((($(ipv4_number "${1%/*}") & mask) == ($(ipv4_number "${service_range%/*}") & mask)))
}
# in_set ADDRESS SET: whether ADDRESS is in SET, the elements of an nftables set as nft lists them,
# separated by commas: addresses, networks and ranges.
in_set() {
  local element number first last
  number=$(ipv4_number "$1")
  while IFS= read -r element; do
    element=${element// /}
    if [[ $element =~ ^([0-9.]+)-([0-9.]+)$ ]]; then
      first=$(ipv4_number "${BASH_REMATCH[1]}") last=$(ipv4_number "${BASH_REMATCH[2]}")
    elif [[ $element =~ ^([0-9.]+)/([0-9]+)$ ]]; then
      first=$(($(ipv4_number "${BASH_REMATCH[1]}") & ((0xffffffff << (32 - BASH_REMATCH[2])) & 0xffffffff)))
      last=$((first + (1 << (32 - BASH_REMATCH[2])) - 1))
    elif [[ $element =~ ^[0-9.]+$ ]]; then
      first=$(ipv4_number "$element") last=$first
    else
      continue
    fi
    ((number >= first && number <= last)) && return 0
  done <<< "${2//,/$'\n'}"
  return 1
}

# guard CHAIN: what the forward chain CHAIN, as nft lists it, does with a translated connection
# toward the Gateway: says what is wrong with its guard, as a line for check_edge, or nothing.
# The guard is a rule ahead of what belongs to a connection that drops every packet of one whose
# route does not go through a worker, and the rule that admits a new one only through a worker;
# each holds every worker's address and not the default route's next hop.
guard() {
  local chain=$1 line drop='' accept='' drop_at=0 established_at=0 at=0 address set
  while IFS= read -r line; do
    line=${line#"${line%%[![:space:]]*}"}
    at=$((at + 1))
    if [[ $line =~ ^ip\ daddr\ ([0-9.]+)\ ct\ direction\ original\ ct\ status\ dnat\ rt\ ip\ nexthop\ !=\ \{\ (.+)\ \}\ drop$ ]]; then
      drop="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}" drop_at=$at
    elif [[ $line == 'ct state established,related accept' ]]; then
      established_at=$at
    elif [[ $line =~ ^ip\ daddr\ ([0-9.]+)\ tcp\ dport\ .+\ ct\ state\ new\ ct\ status\ dnat\ rt\ ip\ nexthop\ \{\ (.+)\ \}\ accept$ ]]; then
      accept="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
    fi
  done <<< "$chain"
  if [[ -z $drop || -z $accept || $established_at -eq 0 || $drop_at -gt $established_at ]]; then
    echo "the forward chain does not drop an established connection's packets toward the Gateway that do not go through a worker"
    return
  fi
  if ((${#unaddressed[@]} > 0)); then
    echo "the forward chain's guard cannot be checked against every worker: $no_address"
    return
  fi
  for set in "$drop" "$accept"; do
    if [[ -n $gateway && ${set%% *} != "$gateway" ]]; then
      echo "the forward chain's guard is not for the cluster's Gateway address"
      return
    fi
    for address in "${worker_addresses[@]}"; do
      if [[ -n $address ]] && ! in_set "$address" "${set#* }"; then
        echo "the forward chain's guard leaves out a worker's address"
        return
      fi
    done
    if [[ -n $default_hop ]] && in_set "$default_hop" "${set#* }"; then
      echo "the forward chain's guard admits the default route's next hop"
      return
    fi
  done
}

failed=0
say() { printf '%-5s %s: %s\n' "$1" "$2" "$3"; }
pass() { say pass "$1" "$2"; }
fail() {
  say FAIL "$1" "$2"
  failed=1
}
skip() { say skip "$1" "$2"; }

# What an edge is asked, as one command, in sections.
remote='echo "== frr"; systemctl is-active frr || true
echo "== sessions"; sudo -n vtysh -c "show bgp ipv4 unicast summary json" || true
echo "== table"; sudo -n vtysh -c "show bgp ipv4 unicast json" || true
echo "== config"; sudo -n vtysh -c "show running-config" || true
echo "== unreachable"; ip -4 -o route show type unreachable || true
echo "== rules"; sudo -n nft list tables || true
echo "== forward"; sudo -n nft list chain inet edge forward || true
echo "== default"; ip -4 -o route show default || true
echo "== forwarding"; sysctl -n net.ipv4.ip_forward || true
echo "== upgrades"; apt-config dump APT::Periodic::Unattended-Upgrade || true'

check_edge() {
  local index=$1 edge=${edge_names[$1]} report section_frr section_sessions section_table section_rules section_forwarding
  local section_config section_unreachable section_forward section_default section_upgrades reject loaded=0
  local default_hop wrong i
  local -a established=() prefixes=() missing=() outside=() fewer=()
  local prefix hops address
  if ! report=$(edge_ssh "$index" "$remote" 2> /dev/null); then
    fail "$edge" "cannot connect over SSH"
    return
  fi
  # section NAME: what the edge printed under NAME.
  section() { sed -n "/^== $1\$/,/^== /{/^== /d;p}" <<< "$report"; }
  section_frr=$(section frr)
  section_sessions=$(section sessions)
  section_table=$(section table)
  section_rules=$(section rules)
  section_forwarding=$(section forwarding)
  section_config=$(section config)
  section_unreachable=$(section unreachable)
  section_forward=$(section forward)
  section_default=$(section default)
  section_upgrades=$(section upgrades)

  if [[ $section_frr == active ]]; then
    pass "$edge" "FRR is running"
  else
    fail "$edge" "FRR is not running"
  fi

  mapfile -t established < <(jq -r '.peers // {} | to_entries[] | select(.value.state == "Established") | .key' <<< "$section_sessions" 2> /dev/null)
  if ((${#workers[@]} == 0)); then
    skip "$edge" "sessions: talos/$cluster/talman.yaml lists no workers, so none is expected"
  else
    for i in "${!workers[@]}"; do
      address=${worker_addresses[i]-}
      if [[ -n $address && " ${established[*]} " != *" $address "* ]]; then
        missing+=("${workers[i]}")
      fi
    done
    if ((${#unaddressed[@]} > 0)); then
      fail "$edge" "${#established[@]} of ${#workers[@]} worker sessions are established, but $no_address"
    elif ((${#established[@]} == ${#workers[@]} && ${#missing[@]} == 0)); then
      pass "$edge" "${#established[@]} of ${#workers[@]} worker sessions are established"
    elif ((${#missing[@]} > 0)); then
      fail "$edge" "${#established[@]} of ${#workers[@]} worker sessions are established; no session from ${missing[*]}"
    else
      fail "$edge" "${#established[@]} of ${#workers[@]} worker sessions are established"
    fi
  fi

  mapfile -t prefixes < <(jq -r '.routes // {} | keys[]' <<< "$section_table" 2> /dev/null)
  if [[ -z $service_range ]]; then
    skip "$edge" "routes: talos/$cluster/talman.yaml gives no service range"
  else
    for prefix in "${prefixes[@]}"; do
      in_range "$prefix" || outside+=("$prefix")
    done
    if ((${#outside[@]} > 0)); then
      fail "$edge" "${#outside[@]} of ${#prefixes[@]} routes in the table are not a /32 inside the service range"
    else
      pass "$edge" "the table holds ${#prefixes[@]} routes, each a /32 inside the service range"
    fi
    for prefix in "${prefixes[@]}"; do
      hops=$(jq -r --arg prefix "$prefix" '[.routes[$prefix][] | select(.multipath == true or .bestpath == true)] | length' <<< "$section_table")
      if ((hops > ${#established[@]})); then
        fail "$edge" "a route has more next hops than there are sessions"
        break
      elif ((hops < ${#established[@]})); then
        fewer+=("$prefix")
      fi
    done
    if ((${#prefixes[@]} == 0)); then
      skip "$edge" "next hops: no Service address is announced"
    elif ((${#fewer[@]} > 0)); then
      skip "$edge" "next hops: ${#fewer[@]} of ${#prefixes[@]} routes have fewer next hops than sessions, as a Service that is local-only has"
    else
      pass "$edge" "each route has a next hop for each of the ${#established[@]} sessions"
    fi
  fi

  # The reject route FRR is configured with, and that it is in the kernel: with it, a translated
  # connection with no worker's route is refused on the edge instead of following its default route.
  reject=$(sed -n 's/^ip route \([^ ]*\) reject$/\1/p' <<< "$section_config" | head -1)
  if [[ -z $reject ]]; then
    fail "$edge" "FRR's configuration holds no reject route for the service range"
  elif [[ -n $service_range && $reject != "$service_range" ]]; then
    fail "$edge" "FRR's reject route is not for the cluster's service range"
  elif ! awk -v range="$reject" '$1 == "unreachable" && $2 == range { found = 1 } END { exit !found }' <<< "$section_unreachable"; then
    fail "$edge" "the service range's reject route is not in the kernel"
  else
    pass "$edge" "the service range is unreachable on the edge but through a worker's route"
  fi

  if grep -qx 'table inet edge' <<< "$section_rules" && grep -qx 'table ip edge-nat' <<< "$section_rules"; then
    pass "$edge" "the nftables rules are loaded"
    loaded=1
  else
    fail "$edge" "the nftables rules are not loaded"
  fi
  # The next hop must be a worker's for the forward chain to pass a translated connection's packets
  # toward the Gateway, new or established, which holds whether FRR runs or not.
  default_hop=$(sed -n 's/^default via \([0-9.]*\) .*/\1/p' <<< "$section_default" | head -1)
  wrong=$(guard "$section_forward")
  if [[ -z $wrong ]]; then
    pass "$edge" "the forward chain sends a translated connection, new or established, toward the Gateway only through a worker"
  elif ((loaded)); then
    fail "$edge" "$wrong"
  fi
  if [[ $section_forwarding == 1 ]] && ((loaded)); then
    pass "$edge" "the kernel forwards"
  elif [[ $section_forwarding == 1 ]]; then
    fail "$edge" "the kernel forwards without the nftables rules"
  else
    fail "$edge" "the kernel does not forward"
  fi
  if [[ $section_upgrades == 'APT::Periodic::Unattended-Upgrade "0";' ]]; then
    pass "$edge" "unattended upgrades are off"
  else
    fail "$edge" "unattended upgrades are on, and would upgrade and restart FRR in place"
  fi
}

for index in 0 1; do
  if [[ -z $only || $only == $((index + 1)) ]]; then
    check_edge "$index"
  fi
done
exit "$failed"
