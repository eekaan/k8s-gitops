#!/usr/bin/env bash
# Forwards a local port to Grafana on a cluster until it is interrupted: kubectl port-forward,
# through the cluster's kubeconfig as scripts/cluster-env finds it, from GRAFANA_PORT, 3000 when
# unset, on 127.0.0.1 only, to port 3000 of the Service grafana-service in the namespace
# monitoring. It changes nothing on the cluster and reads no Secret. Once kubectl reports the
# forward, it prints the local URL and where the admin password is kept, never the password; none
# of kubectl's own output is shown, as its errors can name the API server's address. The forward
# ends with the script, however that ends: Ctrl-C, SIGTERM or SIGHUP; kubectl not reporting the
# forward within GRAFANA_WAIT seconds, 20 when unset; kubectl stopping; or a failure.
# Usage: scripts/grafana [cluster]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/cluster.sh
. "$here/lib/cluster.sh"

if (($# > 1)) || [[ ${1-} == -* ]]; then
  infra_error "usage: grafana [cluster]"
  exit 2
fi

# shellcheck source=scripts/cluster-env
. "$here/cluster-env" "${1-}"
port=${GRAFANA_PORT:-3000} seconds=${GRAFANA_WAIT:-20}
complete=1
require_kubeconfig || complete=0
require_commands kubectl || complete=0
if [[ ! $port =~ ^[1-9][0-9]{0,4}$ ]] || ((port > 65535)); then
  infra_error "GRAFANA_PORT is not a port number from 1 to 65535"
  complete=0
fi
if [[ ! $seconds =~ ^[1-9][0-9]{0,3}$ ]]; then
  infra_error "GRAFANA_WAIT is not a whole number of seconds from 1 to 9999"
  complete=0
fi
((complete))

forward_pid='' forward_out=''
# end STATUS: stops kubectl while it still runs and removes what it printed, then exits with
# STATUS. A failure names the step it happened in, as in every cluster recipe; an interruption says
# the forward has ended.
# shellcheck disable=SC2329 # It runs from the EXIT trap.
end() {
  local status=$1
  if [[ -n $forward_pid ]]; then
    kill "$forward_pid" 2> /dev/null || true
    wait "$forward_pid" 2> /dev/null || true
  fi
  if [[ -n $forward_out ]]; then
    rm -f -- "$forward_out"
  fi
  case $status in
    129 | 130 | 143) echo "The forward to Grafana has ended." ;;
    *) failed_step "$status" ;;
  esac
  exit "$status"
}
trap 'end $?' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

step="starting kubectl port-forward"
forward_out=$(mktemp -t grafana.XXXXXXXXXX)
# Run in the background, kubectl ignores the Ctrl-C the terminal sends; the trap above ends it.
kubectl port-forward --address 127.0.0.1 --namespace monitoring service/grafana-service "$port:3000" \
  > "$forward_out" 2> /dev/null &
forward_pid=$!

step="waiting for kubectl to report the forward"
ticks=$((seconds * 10))
until grep -q '^Forwarding from ' "$forward_out"; do
  if ! kill -0 "$forward_pid" 2> /dev/null; then
    status=0
    wait "$forward_pid" || status=$?
    forward_pid=''
    infra_error "kubectl port-forward stopped with status $status before it forwarded; check that local port $port is free and that the cluster runs Grafana"
    exit 1
  fi
  if ((ticks-- == 0)); then
    infra_error "kubectl port-forward did not report the forward within $seconds seconds"
    exit 1
  fi
  sleep 0.1
done

step="forwarding"
cat << EOF
Grafana: http://127.0.0.1:$port
Sign in as admin. The password is under GF_SECURITY_ADMIN_PASSWORD in the Secret
grafana-admin-credentials in the namespace monitoring.
Ctrl-C ends the forward.
EOF
status=0
wait "$forward_pid" || status=$?
forward_pid=''
infra_error "kubectl port-forward stopped with status $status"
exit 1
