#!/usr/bin/env bash
# Upgrades Talos on a cluster's nodes to the version and schematic their talman.yaml gives them,
# which come from versions.yaml through the cluster stack; it takes no version of its own. Shows
# which nodes talman upgrade would reach, and once the cluster's name is typed back, or with --yes,
# takes an etcd snapshot, encrypted and kept in the etcd backup bucket as cluster-snapshot keeps it,
# and goes through the nodes one at a time in talman.yaml's order. A snapshot that cannot be taken
# stops the run before any node is touched. Each node that is behind is drained with kubectl,
# upgraded with talman, and uncordoned once its kubelet has reported Ready since the upgrade began,
# before the next is drained. A node already on its version is not drained. A worker is taken out of
# BGP before its drain, waiting for up to BGP_WAIT seconds (120) until its CiliumBGPNodeConfig is
# gone, so the edge routers withdraw its paths at once, and put back once it is uncordoned and its
# Cilium agent has stayed Ready, since the upgrade, for FORWARD_SETTLE seconds (30) within
# FORWARD_WAIT seconds (300): forward first, announce second (join_bgp in scripts/lib/cluster.sh).
# So no more than one worker is out at a time; --no-bgp-wait skips the first wait, for the
# withdrawal, for every worker the run takes out, as for a worker whose Cilium agent is not running,
# and not the wait for the agent. A worker out of BGP by a label this
# run did not set is dealt with only once the run is confirmed: one Ready and schedulable is put back
# before the first node is upgraded, and taken out again like any other when it is behind; any
# other, when it is the first worker behind, is taken through as out already: drained, upgraded,
# uncordoned and put back; otherwise it stops the run before another worker is taken out, or fails
# it at the end. With nothing behind it is only reported, and the run fails. A run that stops with a
# worker out says so last, with the command that puts it back.
#
# kubectl reaches the API through the kubeconfig cluster-kubeconfig fetches, served at
# KUBE_API_ADDRESS, and the run stops before a drain when the API does not answer there. talosctl's
# own drain is turned off: it reaches the API at the cluster endpoint, the load balancer's address
# on the node network, which only the nodes reach. When a run stops after draining a node, the node
# stays cordoned until it is uncordoned by hand; a second run skips it once it is on its version.
# It holds the cluster's lock (lock_cluster in scripts/lib/cluster.sh) for the whole run, and
# refuses while another of cluster-reboot, cluster-upgrade, cluster-upgrade-k8s and cluster-talos
# holds it. BGP_WAIT, FORWARD_WAIT and FORWARD_SETTLE are whole numbers of seconds of at most nine
# digits; a longer one is refused before anything runs.
# Usage: scripts/cluster-upgrade [cluster] [--yes] [--no-bgp-wait]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/snapshot.sh
. "$here/lib/snapshot.sh"

cluster='' confirmed=0 bgp_wait=1
for arg; do
  case $arg in
    --yes) confirmed=1 ;;
    --no-bgp-wait) bgp_wait=0 ;;
    *)
      if [[ $arg == -* || -n $cluster ]]; then
        infra_error "usage: cluster-upgrade [cluster] [--yes] [--no-bgp-wait]"
        exit 2
      fi
      cluster=$arg
      ;;
  esac
done

# shellcheck source=scripts/cluster-env
. "$here/cluster-env" "$cluster"
require_cluster talman secrets age-key api-address
complete=1
require_bgp_wait || complete=0
require_forward_waits || complete=0
((complete))
step="locking $cluster"
lock_cluster

# on_exit STATUS: a failing run names its step, as report_failed_step has it do, and then the workers
# it left out of BGP. prepare_snapshot's exit trap does the same once it is made.
on_exit() {
  failed_step "$1"
  bgp_report_out
  exit "$1"
}
trap 'on_exit $?' EXIT

# api_answers: whether the API answers /readyz through the kubeconfig, tried for five minutes, as a
# control plane just upgraded may still be on its way back into the load balancer's pool.
api_answers() {
  local tries
  for ((tries = 0; tries < 30; tries++)); do
    if kubectl get --raw /readyz --request-timeout=10s > /dev/null 2>&1; then
      return 0
    fi
    sleep 10
  done
  infra_error "the Kubernetes API does not answer /readyz at KUBE_API_ADDRESS"
  return 1
}

# ready_after SINCE NODE: waits until NODE's kubelet has reported Ready since SINCE, sixty tries ten
# seconds apart, and fails naming NODE, or the API when it does not answer through the kubeconfig.
ready_after() {
  local attempt not_ready
  for ((attempt = 1; ; attempt++)); do
    if not_ready=$(not_ready_since "$1" "$2"); then
      [[ -n $not_ready ]] || return 0
    else
      not_ready=
    fi
    if ((attempt >= 60)); then
      if [[ -n $not_ready ]]; then
        infra_error "$not_ready did not report Ready after the upgrade"
      else
        infra_error "the Kubernetes API does not answer through the kubeconfig"
      fi
      return 1
    fi
    sleep 10
  done
}

step="asking each node whether its Talos is behind"
behind=0
cluster_talman upgrade --dry-run --detailed-exit-code || behind=$?
case $behind in
  0)
    # A worker another run left out of BGP, which only the kubeconfig such a run fetched can tell;
    # without one no run of this checkout took a worker out. Nothing is asked here, so it is only
    # reported.
    if [[ -f $KUBECONFIG ]]; then
      bgp_check_left_out "with nothing behind nothing is asked, so it is not put back" || exit 1
    fi
    echo "cluster-upgrade: every node of $cluster runs its configured Talos"
    exit 0
    ;;
  2) ;;
  *) exit "$behind" ;;
esac

step="checking what the etcd snapshot needs"
complete=1
require_cluster recipient || complete=0
require_snapshot || complete=0
((complete))
prepare_snapshot

step="waiting for $cluster to be typed back"
((confirmed)) || confirm "$cluster" "upgrade Talos on" upgraded

step="fetching the kubeconfig"
"$here/cluster-kubeconfig" "$cluster" > /dev/null

step="checking that the Kubernetes API answers"
api_answers

take_etcd_snapshot
bgp_settle_left_out

hostnames=$(talman_nodes "$talman_file" | cut -d' ' -f1)
mapfile -t nodes <<< "$hostnames"
for node in "${nodes[@]}"; do
  step="asking $node whether its Talos is behind"
  behind=0
  cluster_talman upgrade -n "$node" --dry-run --detailed-exit-code > /dev/null || behind=$?
  case $behind in
    0) continue ;;
    2) ;;
    *) exit "$behind" ;;
  esac

  step="checking that the Kubernetes API answers before draining $node"
  api_answers
  # A worker leaves BGP before it is drained, so the edge routers withdraw its paths instead of
  # keeping them as stale while its Cilium agent is away. It is put back before the next node is
  # touched, so at most one worker is out of BGP. A control plane has no BGP.
  step="reading the role of $node in talman.yaml"
  role=$(NODE=$node yq '.nodes[] | select(.hostname == strenv(NODE)) | .role // ""' "$talman_file")
  case $role in
    worker) leave_bgp "$node" "$bgp_wait" ;;
    controlplane) ;;
    *)
      infra_error "talos/$cluster/talman.yaml gives $node the role ${role:-none}, neither controlplane nor worker, so it is not known whether it announces over BGP; $node is not drained"
      exit 1
      ;;
  esac
  step="draining $node"
  drain_node "$node"
  step="upgrading $node, which is drained"
  cluster_talman_drain_off upgrade -n "$node"
  # A Ready condition from before talman returned is the one etcd kept while the node was away, or
  # one the kubelet posted as the upgrade began; only a report after it shows the upgraded node.
  since=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  step="waiting for $node, which is drained, to report Ready after the upgrade"
  ready_after "$since" "$node"
  step="uncordoning $node"
  kubectl uncordon "$node"
  if [[ $role == worker ]]; then
    join_bgp "$node" "$since" "the upgrade"
  fi
done

# A worker that was out of BGP before the loop and not put back, as it was not both Ready and
# schedulable, is still out once the loop has skipped it as it runs its version.
step="checking that no worker is out of BGP"
for node in "${bgp_left_out[@]}"; do
  infra_error "$node is out of BGP and was not both Ready and schedulable when the run began, so it is not put back"
done
((${#bgp_left_out[@]} == 0)) || exit 1

step="checking that every node runs its configured Talos"
cluster_talman upgrade --dry-run --detailed-exit-code > /dev/null
echo "cluster-upgrade: every node of $cluster runs its configured Talos"
