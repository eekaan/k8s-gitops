#!/usr/bin/env bash
# Compares every tool pinned in mise.toml with the version its binary on PATH reports.
# Usage: tools-check [path/to/mise.toml]
# Pure bash on purpose: it has to give a clear answer on a machine where none of the tools exist.
set -euo pipefail

pins=${1:-${BASH_SOURCE[0]%/*}/../mise.toml}

# The first x.y.z in the output, with any pre-release suffix; build metadata such as +gabc123 is dropped.
version_re='[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?'
pin_re='^[[:space:]]*"?([^"=[:space:]]+)"?[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*(#.*)?$'

version_command() {
  case $1 in
    opentofu) cmd=(tofu version) ;;
    talosctl) cmd=(talosctl version --client) ;;
    kubectl) cmd=(kubectl version --client) ;;
    flux2) cmd=(flux version --client) ;;
    helm) cmd=(helm version --short) ;;
    kustomize) cmd=(kustomize version) ;;
    # Without the flag sops asks GitHub for the latest release.
    sops) cmd=(sops --version --disable-version-check) ;;
    cosign) cmd=(cosign version) ;;
    gitleaks) cmd=(gitleaks version) ;;
    *) cmd=("$1" --version) ;;
  esac
}

failed=0
checked=0
section=
while IFS= read -r line || [[ -n $line ]]; do
  if [[ $line =~ ^[[:space:]]*\[([^]]+)\] ]]; then
    section=${BASH_REMATCH[1]}
    continue
  fi
  [[ $section == tools ]] || continue
  [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
  if ! [[ $line =~ $pin_re ]]; then
    echo "$pins: cannot read a pinned version from: $line" >&2
    failed=1
    continue
  fi
  key=${BASH_REMATCH[1]}
  pinned=${BASH_REMATCH[2]}
  # Backend keys such as github:owner/name or pypi:name name the tool after the last segment.
  tool=${key##*:}
  tool=${tool##*/}
  version_command "$tool"
  checked=$((checked + 1))

  if ! command -v "${cmd[0]}" > /dev/null; then
    echo "$tool: pinned $pinned, but ${cmd[0]} is not on PATH; install the pinned tools with: just tools" >&2
    failed=1
    continue
  fi
  output=$("${cmd[@]}" 2>&1) || true
  found=unknown
  if [[ $output =~ $version_re ]]; then
    found=${BASH_REMATCH[0]}
  fi
  if [[ $found != "$pinned" ]]; then
    echo "$tool: pinned $pinned, found $found at $(command -v "${cmd[0]}"); install the pinned tools with: just tools" >&2
    failed=1
  fi
done < "$pins"

# A pin written in a form this check does not read must not pass as nothing to check.
if (( checked == 0 )); then
  echo "$pins: no pinned tools found; pins are name = \"version\" lines under [tools]" >&2
  exit 1
fi
if (( failed )); then
  exit 1
fi
echo "All $checked pinned tools match mise.toml."
