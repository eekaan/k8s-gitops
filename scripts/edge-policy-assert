#!/usr/bin/env bash
# Checks what the real-speaker proof of the edge routers' routing policy printed (tests/fixtures/
# edge-policy/proof.sh, run in FRR by edge-policy-check): of the five prefixes a speaker in the
# cluster's AS offered, only the /32 inside the service range is in the edge's table, with the
# speaker's own address as next hop; the speakers in another AS and outside the workers' block have
# no session; the edge advertised nothing back, the speaker holds no path learned from it, and the
# sessions never dropped; the edge offers graceful restart without the notification bit; and FRR's
# dry run accepts the edge's file and refuses one with an unknown command.
# Before those: every place a daemon writes took a new file from the daemons' user, every daemon
# ran, each wait for a state of the sessions was met within its bound, and the proof ran to its end. Prints pass or FAIL per item, then, after any FAIL, everything the
# proof printed, its waits with what they last saw and a stopped daemon's log among it, and exits
# non-zero on any FAIL.
# Usage: scripts/edge-policy-assert FILE, FILE being the proof's output
set -euo pipefail

if (($# != 1)) || [[ ! -s $1 ]]; then
  echo "usage: edge-policy-assert FILE, the proof's output" >&2
  exit 2
fi
out=$1
failed=0

# section NAME: what the proof printed under NAME.
section() {
  sed -n "/^== $1\$/,/^== /{/^== /d;p}" "$out"
}
# says DESCRIPTION SECTION LINE: passes when the section holds LINE.
says() {
  if section "$2" | grep -qxF -- "$3"; then
    printf 'pass  %s\n' "$1"
  else
    printf 'FAIL  %s\n' "$1"
    failed=1
  fi
}
# expect DESCRIPTION SECTION JQ_FILTER: passes when the filter is true of the section's JSON.
expect() {
  if section "$2" | jq -e "$3" > /dev/null 2>&1; then
    printf 'pass  %s\n' "$1"
  else
    printf 'FAIL  %s\n' "$1"
    failed=1
  fi
}

# met DESCRIPTION: passes when the proof's wait for DESCRIPTION was met within its bound.
met() {
  if section waits | grep -q -- "^met: $1, after "; then
    printf 'pass  %s, within the bound\n' "$1"
  else
    printf 'FAIL  %s, within the bound\n' "$1"
    failed=1
  fi
}

if [[ $(section places | grep -c ': takes a new file$') -eq 5 ]] && ! section places | grep -q ': takes no new file$'; then
  printf 'pass  every place a daemon writes takes a new file from the user the daemons run as\n'
else
  printf 'FAIL  every place a daemon writes takes a new file from the user the daemons run as\n'
  failed=1
fi
if [[ $(section daemons | grep -cE '^(edge|a|b|c): running$') -eq 4 ]]; then
  printf 'pass  every BGP daemon of the proof is running\n'
else
  printf 'FAIL  every BGP daemon of the proof is running\n'
  failed=1
fi
met "every daemon answers"
met "the speaker in the cluster's AS has its session established and has offered its five prefixes"
met "the edge has accepted a prefix from it"
met "the speaker in another AS has been refused for its AS"
met "the speaker outside the workers' block has reached the edge and not been taken"
says "the proof ran to its end" proof "ran to its end"
says "FRR's dry run accepts the edge's file as rendered" syntax "the edge's file is accepted"
says "FRR's dry run refuses a file with a command FRR does not have" syntax "a file with an unknown command is refused"
expect "the speaker offered all five prefixes" offered '.peers["127.0.0.1"].pfxSnt == 5'
expect "exactly one session is established, the speaker in the cluster's AS at a worker's address" sessions \
  '[.peers | to_entries[] | select(.value.state == "Established") | .key] == ["127.0.0.20"]'
expect "the speaker in another AS has no session" sessions '.peers | has("127.0.0.21") | not'
expect "the speaker of the node subnet outside the workers' block has no session" sessions '.peers | has("127.0.0.3") | not'
expect "the table holds the /32 inside the service range and nothing else" table \
  '(.routes | keys) == ["203.0.113.17/32"]'
expect "the edge accepted one prefix of the five" sessions '.peers["127.0.0.20"].pfxRcd == 1'
# The speaker announced its /32 with another address as next hop; the edge's path goes to the
# speaker that announced it.
expect "the accepted /32's one path has the announcing speaker's address as next hop" table \
  '[.routes["203.0.113.17/32"][].nexthops[].ip] == ["127.0.0.20"]'
# Graceful restart is on, without the notification bit (RFC 8538), so a hold timer expiry ends
# graceful restart's retention instead of starting it.
expect "the edge offers graceful restart without the notification bit" capability \
  '.["127.0.0.1"] | .neighborCapabilities.gracefulRestart == "advertisedAndReceived" and .gracefulRestartInfo.nBit == false'
expect "the edge advertised nothing" advertised '(.advertisedRoutes | length) == 0'
expect "the speaker received nothing from the edge" offered '.peers["127.0.0.1"].pfxRcd == 0'
# A statement that bypasses the outbound route map, default-originate, sends a default route that no
# count of advertised routes shows. What the speaker holds is the proof: of the paths in its table
# none was learned from the edge (its own, locally originated ones have no peer).
expect "the speaker holds no path learned from the edge, so the edge originated no default route" learned \
  '[.routes[][] | select(.peerId == "127.0.0.1")] | length == 0'
# A session that is reset over and over holds nothing at the moment it is read; both sessions stayed
# up from the first connection to the last reading, so the checks above read them as they were.
expect "the session between the edge and the speaker was established once and never dropped" sessions \
  '.peers["127.0.0.20"] | .connectionsEstablished == 1 and .connectionsDropped == 0'
expect "the speaker's session to the edge is established and was never dropped" offered \
  '.peers["127.0.0.1"] | .state == "Established" and .connectionsEstablished == 1 and .connectionsDropped == 0'
if ((failed)); then
  echo "-- what the proof printed:"
  cat "$out"
fi
exit "$failed"
