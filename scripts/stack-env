# shellcheck shell=bash
# Sourced with a stack, such as sto2/plumbing, by the scripts that run tofu on it:
#   . scripts/stack-env sto2/plumbing
# Resolves the stack's directory, reads .env when there is one, checks by name every variable the
# stack needs, and exports the state encryption settings and the inputs the stack takes from the
# environment. Sets stack, stack_dir, plan_file, errors_file and backend_config, the
# -backend-config arguments of tofu init: the committed backend file, the bucket and a state key
# from the stack's path. Returns non-zero, naming what is missing or refused, before anything else
# happens. The functions below then lock, initialise, plan and apply that stack.

# shellcheck source=scripts/lib/infra.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/infra.sh"

# stack_takes NAME: whether the stack declares the input variable NAME.
stack_takes() {
  grep -qsE "^variable \"$1\" \\{" "$stack_dir"/*.tf
}

# Exports TF_VAR_plumbing_state: where the plumbing stack of the stack's region keeps its state,
# with the backend settings every stack is initialised with.
export_plumbing_state() {
  local backend
  backend=$(yq -p hcl -o json "$infra_root/infra/openstack/backend.hcl") || return 1
  TF_VAR_plumbing_state=$(printf '%s' "$backend" |
    jq -c --arg key "${stack%%/*}/plumbing.tfstate" '. + {bucket: env.TF_STATE_BUCKET, key: $key}') || return 1
  export TF_VAR_plumbing_state
}

# Holds the stack's lock until the script exits, so a second operation on the stack in this checkout
# stops at once instead of racing the first for the state. The lock is a file in the checkout: it
# does not exclude CI or another checkout. The object storage's own locking is not used yet; see
# infra/openstack/backend.hcl.
lock_stack() {
  if ! command -v flock > /dev/null; then
    infra_error "flock is required to lock $stack and is not on PATH; it comes with util-linux"
    return 1
  fi
  mkdir -p "$stack_dir/.terraform"
  exec {infra_lock_fd}> "$stack_dir/.terraform/infra.lock"
  if ! flock -n "$infra_lock_fd"; then
    infra_error "$stack is busy: another operation on it is running"
    return 1
  fi
  : > "$errors_file"
}

# stack_tofu SUBCOMMAND [ARG...]: tofu on the stack. Its errors can name resources and hold
# attribute values and API endpoints, and CI logs are public, so with CI set they go to
# errors_file and only the failure and that file are named.
stack_tofu() {
  if [[ -z ${CI:-} ]]; then
    tofu -chdir="$stack_dir" "$@"
    return
  fi
  if ! tofu -chdir="$stack_dir" "$@" 2>> "$errors_file"; then
    infra_error "tofu $1 failed for $stack; its errors are in ${errors_file#"$infra_root"/}"
    return 1
  fi
}

init_stack() {
  stack_tofu init -input=false -reconfigure "${backend_config[@]}" > /dev/null
}

# plan_stack and plan_destroy save the plan to plan_file and print its summary. Plan output is
# public in CI and the full plan holds addresses and IDs, so tofu's own report is not shown.
plan_stack() {
  stack_tofu plan -input=false -out="$plan_file" > /dev/null
  stack_tofu show -json "$plan_file" | plan_summary
}

plan_destroy() {
  stack_tofu plan -destroy -input=false -out="$plan_file" > /dev/null
  stack_tofu show -json "$plan_file" | plan_summary
}

# Applies the saved plan. Apply's report names resources and their IDs, so it is not shown either.
apply_plan() {
  stack_tofu apply -input=false "$plan_file" > /dev/null
}

infra_stack_env() {
  stack=${1-}
  if [[ ! $stack =~ ^[a-z0-9-]+/[a-z0-9-]+$ || ! -d $infra_root/infra/openstack/stacks/$stack ]]; then
    infra_error "no stack ${stack:-given}: name one under infra/openstack/stacks, such as sto2/plumbing"
    return 1
  fi
  stack_dir=$infra_root/infra/openstack/stacks/$stack
  # The full plan is encrypted like state and stays beside the stack's other working files.
  plan_file=$stack_dir/.terraform/infra.tfplan
  errors_file=$stack_dir/.terraform/tofu-errors.log

  load_env || return 1
  local complete=1
  refuse_tofu_overrides || complete=0
  require_env TF_STATE_BUCKET AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY TF_STATE_PASSPHRASE || complete=0
  require_openstack_auth || complete=0
  if stack_takes api_allowed_cidrs; then
    export_api_allowed_cidrs || complete=0
  fi
  ((complete)) || return 1

  export_state_encryption || return 1
  if stack_takes plumbing_state; then
    export_plumbing_state || return 1
  fi
  backend_config=(
    -backend-config="$infra_root/infra/openstack/backend.hcl"
    -backend-config="bucket=$TF_STATE_BUCKET"
    -backend-config="key=$stack.tfstate"
  )
}

infra_stack_env "$@"
