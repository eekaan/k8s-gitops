#!/usr/bin/env bash
# Reboots one node of a cluster with talman while watching that the Kubernetes API keeps answering
# through its load balancer, as a check that a control plane can be away without the API going with
# it. The node is named by its hostname in the cluster's talman.yaml; any other name is refused
# before anything runs. A control plane is rebooted only while etcd is whole (etcd_whole): with
# another member down, or a member that is no control plane of talman.yaml, its reboot could leave
# etcd without a quorum, so the recipe stops before anything changes, saying why. Once the node's
# name is typed back, or with --yes, a probe asks /readyz
# through the kubeconfig, which points at the load balancer, once a second, each time for up to two
# seconds, while the recipe:
#   0. for a worker, takes it out of BGP (leave_bgp in scripts/lib/cluster.sh): sets the label the
#      cluster's BGP configuration excludes and waits, for up to BGP_WAIT seconds (120), until
#      its CiliumBGPNodeConfig is gone, after which the agent closes its sessions and the edge routers
#      withdraw its paths at once; it first records which of the node's sessions are established,
#      and stops, changing nothing, while another worker is out of BGP or when the configuration
#      cannot be read. --no-bgp-wait, for a worker whose Cilium agent is not running to take the
#      label up, sets it without reading the configuration or waiting, and says what that can cost;
#      a control plane has no BGP, and nothing here changes for it;
#   1. cordons the node and drains it with kubectl, as cluster-upgrade drains, so that nothing new
#      is placed on it while it goes down: a kubelet that is shutting down rejects every pod it is
#      given, and the scheduler would go on giving it the same replica. talosctl's own drain, which
#      reaches the API where only the nodes reach it, stays off;
#   2. reboots it with talman;
#   3. waits until it is a Ready Kubernetes node with a heartbeat from after the reboot and, for a
#      control plane, until etcd is whole again, for up to REBOOT_WAIT seconds (600) in all, checked
#      between attempts, so one attempt can run over. A
#      Talos control plane reports Ready without its etcd member, as its kubelet reaches the API
#      through the others, so one rebooted in with an etcd setting its member cannot start with is
#      Ready all the same, and another control plane rebooted after it would leave etcd without a
#      quorum.
# Then it prints how many probes it made, how many failed and the longest run of failures, in
# seconds; uncordons the node, unless it was unschedulable before the recipe ran, which it says;
# puts a worker back in BGP, waiting until its CiliumBGPNodeConfig is back and the sessions that were
# established before are again, or only until it is back when they are not known;
# and deletes the pods the shutdown left in phase Failed on it, rejected (NodeShutdown) or
# terminated (Terminated) as the node went down, which nothing else removes, saying how many. It
# exits 0 only when the node is Ready again, a control plane with its etcd member, and no probe
# failed; --tolerate <seconds> accepts runs of failures up to that long, for the operator to say
# what counts as an interruption. A run that stops once the node is cordoned leaves it cordoned and
# says so; one that stops while a worker is out of BGP leaves it out and says so last, with the
# command that puts it back, and a rerun recognises a worker that is out already.
#
# The probe runs in the background and keeps its counts in memory, so it writes no file. It is
# stopped on every exit: at the end, when a step fails, and when SIGINT or SIGTERM ends the recipe;
# it then stops the kubectl or sleep it is waiting for, so nothing of it keeps running. Of kubectl's
# output only the drain's passes through, as in cluster-upgrade: it names the pods it evicts and
# those it cannot. The rest is not printed, as it can name the API server's or the nodes' addresses.
# It holds the cluster's lock (lock_cluster in scripts/lib/cluster.sh) for the whole run, sharing it
# with cluster-talos --reboot when that runs it, and refuses while another recipe that drains,
# reboots, upgrades or applies to the cluster's nodes holds it.
# Usage: scripts/cluster-reboot <node> [cluster] [--yes] [--tolerate <seconds>] [--no-bgp-wait]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/cluster.sh
. "$here/lib/cluster.sh"

usage() {
  infra_error "usage: cluster-reboot <node> [cluster] [--yes] [--tolerate <seconds>] [--no-bgp-wait]"
  exit 2
}

node='' cluster='' confirmed=0 tolerate=0 bgp_wait=1
while (($#)); do
  case $1 in
    --yes) confirmed=1 ;;
    --no-bgp-wait) bgp_wait=0 ;;
    --tolerate)
      (($# > 1)) || usage
      tolerate=$2
      shift
      ;;
    --tolerate=*) tolerate=${1#*=} ;;
    -*) usage ;;
    *)
      if [[ -z $node ]]; then
        node=$1
      elif [[ -z $cluster ]]; then
        cluster=$1
      else
        usage
      fi
      ;;
  esac
  shift
done
[[ -n $node ]] || usage

# shellcheck source=scripts/cluster-env
. "$here/cluster-env" "$cluster"
complete=1
require_cluster talman secrets age-key || complete=0
require_kubeconfig || complete=0
require_commands talman kubectl jq yq || complete=0
if [[ ! $tolerate =~ ^[0-9]+$ ]]; then
  infra_error "--tolerate takes a whole number of seconds"
  complete=0
fi
if [[ ! ${REBOOT_WAIT:-600} =~ ^[0-9]+$ ]]; then
  infra_error "REBOOT_WAIT is not a whole number of seconds"
  complete=0
fi
require_bgp_wait || complete=0
((complete))
step="locking $cluster"
lock_cluster
tolerate=$((10#$tolerate))
ready_wait=$((10#${REBOOT_WAIT:-600}))

step="finding the node in talman.yaml"
hostnames=$(talman_nodes "$talman_file" | cut -d' ' -f1)
if ! grep -qxF -- "$node" <<< "$hostnames"; then
  known_nodes=$(paste -sd, - <<< "$hostnames" | sed 's/,/, /g')
  # An address would end up in the output, which may be a public log.
  if [[ $node =~ ^[0-9.]+$ ]]; then
    infra_error "a node is named by its hostname, not by its address: talos/$cluster/talman.yaml lists $known_nodes"
  else
    infra_error "$node is not a node of $cluster: talos/$cluster/talman.yaml lists $known_nodes"
  fi
  exit 1
fi

# The control planes, whose etcd members are checked around a control plane's reboot. A role that
# cannot be read, or is neither controlplane nor worker, could make a control plane pass for a
# worker, so it stops the recipe before anything is changed.
step="reading the roles of the nodes in talman.yaml"
if ! roles=$(yq '.nodes[] | .hostname + " " + (.role // "")' "$talman_file" 2> /dev/null) || [[ -z $roles ]]; then
  infra_error "cannot read the roles of the nodes in talos/$cluster/talman.yaml, so it is not known whether $node runs an etcd member; nothing was changed"
  exit 1
fi
control_planes=()
while read -r hostname role; do
  case $role in
    controlplane) control_planes+=("$hostname") ;;
    worker) ;;
    *)
      infra_error "talos/$cluster/talman.yaml gives $hostname the role ${role:-none}, neither controlplane nor worker, so its etcd member cannot be told; nothing was changed"
      exit 1
      ;;
  esac
done <<< "$roles"

say() {
  printf '%s: %s\n' "${0##*/}" "$1"
}

# etcd_whole: whether etcd has exactly the control planes of talman.yaml as healthy members, the
# node's among them: each member, asked through its own control plane's Talos API, follows the same
# leader in the same term as a voting member and reports no error, and the node's own member lists
# them and no other. When it does not, etcd_reason says why. talosctl sets no deadline of its own on
# these requests: each lasts until the nodes answer or gRPC gives up connecting. What talosctl
# prints names addresses, so nothing of it is printed.
etcd_whole() {
  local member status members
  local -a asked=()
  for member in "${control_planes[@]}"; do
    asked+=(-n "$member")
  done
  if ! status=$(talman talosctl "${asked[@]}" etcd status 2> /dev/null); then
    etcd_reason="not every control plane's etcd member answered etcd status"
    return 1
  fi
  if ! etcd_status_healthy "${#control_planes[@]}" <<< "$status"; then
    etcd_reason="etcd status shows a member that follows no leader or another leader or term, is a learner or reports an error"
    return 1
  fi
  if ! members=$(talman talosctl -n "$node" etcd members 2> /dev/null); then
    etcd_reason="$node's etcd member did not answer etcd members"
    return 1
  fi
  etcd_reason=$(etcd_members_are "${control_planes[@]}" <<< "$members")
}

# probe_api: runs in the background until SIGTERM: asks /readyz through the kubeconfig once a
# second, giving each probe two seconds, and says when it stops answering and when it answers again.
# On SIGTERM it prints how many probes it made, how many failed and the longest run of failures in
# seconds, on one line. kubectl and the second's sleep run as children it waits for, so SIGTERM is
# handled at once, and they are stopped with it.
probe_api() {
  local probe='' tick='' started
  probes=0 failed=0 longest=0 down_since=''
  trap 'end_probe' TERM
  while :; do
    started=$EPOCHSECONDS
    # The second runs alongside the probe, so the next probe starts a second after this one did,
    # or as soon as this one ends when it took longer.
    sleep 1 > /dev/null &
    tick=$!
    (exec_tool kubectl get --raw /readyz --request-timeout=2s) > /dev/null 2>&1 &
    probe=$!
    if wait "$probe"; then
      if [[ -n $down_since ]]; then
        end_run "$started"
        say "/readyz answers again" >&2
      fi
    else
      failed=$((failed + 1))
      if [[ -z $down_since ]]; then
        down_since=$started
        say "/readyz does not answer" >&2
      fi
    fi
    probes=$((probes + 1))
    wait "$tick"
  done
}

# end_run TIME: ends the run of failures under way, if any, at TIME, in seconds since the epoch, and
# keeps it when it is the longest. A run lasts at least a second, as the probes are a second apart.
end_run() {
  local run
  [[ -n $down_since ]] || return 0
  run=$(($1 - down_since))
  ((run > 0)) || run=1
  ((run <= longest)) || longest=$run
  down_since=''
}

# end_probe: probe_api's SIGTERM handler.
end_probe() {
  kill "$probe" "$tick" 2> /dev/null || true
  wait "$probe" "$tick" 2> /dev/null || true
  end_run "$EPOCHSECONDS"
  printf '%s %s %s\n' "$probes" "$failed" "$longest"
  exit 0
}

# start_probe: starts probe_api in the background, its report to be read from probe_out.
start_probe() {
  exec {probe_out}< <(probe_api)
  probe_pid=$!
}

# stop_probe: stops the probe if it runs, waits until it has ended, and reads its report into probes,
# failed and longest; probes is empty when it reported nothing.
stop_probe() {
  [[ -n ${probe_pid-} ]] || return 0
  kill -TERM "$probe_pid" 2> /dev/null || true
  read -r probes failed longest <&"$probe_out" || probes=''
  wait "$probe_pid" 2> /dev/null || true
  exec {probe_out}<&-
  probe_pid=''
}

# remove_shutdown_pods: deletes, by namespace and name, the pods the node's shutdown left in phase
# Failed on it: those its kubelet rejected while it was shutting down (reason NodeShutdown) and those
# it terminated as it went down (Terminated). They stay until they are deleted, and cluster-check
# fails on them. Every other pod stays, a Failed one among them. Says how many it deleted.
remove_shutdown_pods() {
  local pods left namespace rest count=0
  local -a names
  if ! pods=$(kubectl get pods --all-namespaces --output json --request-timeout=30s 2> /dev/null); then
    infra_error "kubectl could not read the pods through the kubeconfig"
    return 1
  fi
  # One line per namespace: the namespace, then the names of its pods to delete.
  left=$(jq -r --arg node "$node" '[.items[] | select(.spec.nodeName == $node and .status.phase == "Failed"
      and (.status.reason == "NodeShutdown" or .status.reason == "Terminated"))]
    | group_by(.metadata.namespace)[] | [.[0].metadata.namespace] + map(.metadata.name) | join(" ")' <<< "$pods")
  while read -r namespace rest; do
    [[ -n $namespace ]] || continue
    read -ra names <<< "$rest"
    if ! kubectl delete pod --namespace "$namespace" "${names[@]}" --ignore-not-found --wait=false > /dev/null 2>&1; then
      infra_error "kubectl could not delete the pods the shutdown left Failed on $node in $namespace"
      return 1
    fi
    count=$((count + ${#names[@]}))
  done <<< "$left"
  if ((count == 0)); then
    say "the shutdown left no pod Failed on $node"
  else
    say "removed $count pods the shutdown left Failed on $node"
  fi
}

# On every exit the probe is stopped first; then a failing run names its step, as
# report_failed_step has it do, and once the node is cordoned, says last that it stays so. Ctrl-C
# and SIGTERM end the recipe as a failure, even when talman handles the signal itself and exits 0,
# after which bash would otherwise go on.
cordoned=0 unschedulable=false
on_exit() {
  local status=$1
  stop_probe
  failed_step "$status"
  if ((status != 0 && cordoned)); then
    if [[ $unschedulable == true ]]; then
      infra_error "$node stays cordoned, as it was before"
    else
      infra_error "$node is left cordoned; once it is Ready, kubectl uncordon $node makes it schedulable again"
    fi
  fi
  bgp_report_out
  exit "$status"
}
trap 'on_exit $?' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

step="reading $node through the kubeconfig"
if ! unschedulable=$(kubectl get node "$node" --output json --request-timeout=10s 2> /dev/null |
  jq -r '.spec.unschedulable // false'); then
  infra_error "kubectl could not read the node $node through the kubeconfig; nothing was changed"
  exit 1
fi
if [[ $unschedulable == true ]]; then
  say "$node is cordoned already, and stays cordoned after the reboot"
fi

# A control plane is rebooted only while etcd is whole: with another member already down, its
# reboot would leave etcd without a quorum.
member=0
for each in "${control_planes[@]}"; do
  [[ $each != "$node" ]] || member=1
done
if ((member)); then
  step="asking etcd whether every control plane is a healthy member"
  if ! etcd_whole; then
    infra_error "etcd is not whole, so $node is not rebooted and nothing was changed: $etcd_reason. Rebooting a control plane while etcd lacks a healthy member, or holds one that is no control plane, can leave it without a quorum"
    exit 1
  fi
fi

step="waiting for $node to be typed back"
((confirmed)) || confirm "$node" reboot rebooted

say "draining and rebooting $node; /readyz is asked through the kubeconfig once a second until it is Ready again"
start_probe

# A worker leaves BGP first, so the edge routers withdraw its paths before the drain and the reboot
# rather than keeping them as stale while it is away. A control plane has no BGP.
if ((!member)); then
  leave_bgp "$node" "$bgp_wait"
fi

step="cordoning $node"
if ! kubectl cordon "$node" > /dev/null 2>&1; then
  infra_error "kubectl could not cordon $node; nothing was changed"
  exit 1
fi
cordoned=1
step="draining $node"
drain_node "$node"

step="rebooting $node with talman"
since=$(date -u +%Y-%m-%dT%H:%M:%SZ)
rebooted=0
cluster_talman_drain_off reboot -n "$node" --yes || rebooted=$?

back=0 ready=0
if ((rebooted == 0)); then
  step="waiting for $node to be Ready"
  if ((member)); then
    say "talman has rebooted $node; waiting up to ${ready_wait}s for it to report Ready and for etcd to have its member back"
  else
    say "talman has rebooted $node; waiting up to ${ready_wait}s for it to report Ready"
  fi
  deadline=$((SECONDS + ready_wait))
  while :; do
    if ((!ready)) && not_ready=$(not_ready_since "$since" "$node") && [[ -z $not_ready ]]; then
      ready=1
    fi
    if ((ready)) && { ((!member)) || etcd_whole; }; then
      back=1
      break
    fi
    ((SECONDS < deadline)) || break
    sleep 5
  done
fi

stop_probe
if [[ -z $probes ]]; then
  infra_error "the probe of /readyz reported nothing"
  exit 1
fi
say "/readyz asked $probes times, $failed failed; longest run of failures ${longest}s"
if ((rebooted != 0)); then
  step="rebooting $node with talman"
  exit "$rebooted"
fi
if ((!ready)); then
  infra_error "$node has not reported Ready since its reboot, after ${ready_wait}s; REBOOT_WAIT sets how long to wait"
  exit 1
fi
if ((!back)); then
  step="waiting for etcd to have $node's member back"
  infra_error "$node is Ready again, but etcd was not whole within ${ready_wait}s: $etcd_reason. Reboot no other control plane until it is: etcd keeps its quorum only while a majority of its members are up. REBOOT_WAIT sets how long to wait"
  exit 1
fi

step="uncordoning $node"
if [[ $unschedulable == true ]]; then
  say "$node was cordoned before the reboot and stays cordoned"
else
  if ! kubectl uncordon "$node" > /dev/null 2>&1; then
    infra_error "kubectl could not uncordon $node"
    exit 1
  fi
  cordoned=0
  say "$node is schedulable again"
fi

if ((!member)); then
  join_bgp "$node"
fi

step="removing the pods the shutdown left Failed on $node"
remove_shutdown_pods

step="checking that /readyz answered"
if ((failed > 0 && longest > tolerate)); then
  infra_error "$node is Ready again, but /readyz did not answer for up to ${longest}s while it rebooted; --tolerate $longest accepts a gap that long"
  exit 1
fi
if ((failed > 0)); then
  say "$node is Ready again; /readyz did not answer for up to ${longest}s, within the ${tolerate}s tolerated"
else
  say "$node is Ready again, and /readyz answered every probe"
fi
