#!/usr/bin/env bash
# Reboots one node of a cluster with talman while watching that the Kubernetes API keeps answering
# through its load balancer, as a check that a control plane can be away without the API going with
# it. The node is named by its hostname in the cluster's talman.yaml; any other name is refused
# before anything runs. Once the node's name is typed back, or with --yes, a probe asks /readyz
# through the kubeconfig, which points at the load balancer, once a second, each time for up to two
# seconds, while talman reboots the node and until the node is a Ready Kubernetes node with a
# heartbeat from after the reboot, for which the recipe waits up to REBOOT_WAIT seconds (600). Then
# it prints how many probes it made, how many failed and the longest run of failures, in seconds.
# It exits 0 only when the node is Ready again and no probe failed; --tolerate <seconds> accepts runs
# of failures up to that long, for the operator to say what counts as an interruption.
#
# The probe runs in the background and keeps its counts in memory, so it writes no file. It is
# stopped on every exit: at the end, when a step fails, and when SIGINT or SIGTERM ends the recipe;
# it then stops the kubectl or sleep it is waiting for, so nothing of it keeps running. Neither
# kubectl's output nor its errors are printed, as they can name the API server's address.
# Usage: scripts/cluster-reboot <node> [cluster] [--yes] [--tolerate <seconds>]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/cluster.sh
. "$here/lib/cluster.sh"

usage() {
  infra_error "usage: cluster-reboot <node> [cluster] [--yes] [--tolerate <seconds>]"
  exit 2
}

node='' cluster='' confirmed=0 tolerate=0
while (($#)); do
  case $1 in
    --yes) confirmed=1 ;;
    --tolerate)
      (($# > 1)) || usage
      tolerate=$2
      shift
      ;;
    --tolerate=*) tolerate=${1#*=} ;;
    -*) usage ;;
    *)
      if [[ -z $node ]]; then
        node=$1
      elif [[ -z $cluster ]]; then
        cluster=$1
      else
        usage
      fi
      ;;
  esac
  shift
done
[[ -n $node ]] || usage

# shellcheck source=scripts/cluster-env
. "$here/cluster-env" "$cluster"
complete=1
require_cluster talman secrets age-key || complete=0
require_kubeconfig || complete=0
require_commands talman kubectl jq || complete=0
if [[ ! $tolerate =~ ^[0-9]+$ ]]; then
  infra_error "--tolerate takes a whole number of seconds"
  complete=0
fi
if [[ ! ${REBOOT_WAIT:-600} =~ ^[0-9]+$ ]]; then
  infra_error "REBOOT_WAIT is not a whole number of seconds"
  complete=0
fi
((complete))
tolerate=$((10#$tolerate))
ready_wait=$((10#${REBOOT_WAIT:-600}))

step="finding the node in talman.yaml"
hostnames=$(talman_nodes "$talman_file" | cut -d' ' -f1)
if ! grep -qxF -- "$node" <<< "$hostnames"; then
  known_nodes=$(paste -sd, - <<< "$hostnames" | sed 's/,/, /g')
  # An address would end up in the output, which may be a public log.
  if [[ $node =~ ^[0-9.]+$ ]]; then
    infra_error "a node is named by its hostname, not by its address: talos/$cluster/talman.yaml lists $known_nodes"
  else
    infra_error "$node is not a node of $cluster: talos/$cluster/talman.yaml lists $known_nodes"
  fi
  exit 1
fi

say() {
  printf '%s: %s\n' "${0##*/}" "$1"
}

# probe_api: runs in the background until SIGTERM: asks /readyz through the kubeconfig once a
# second, giving each probe two seconds, and says when it stops answering and when it answers again.
# On SIGTERM it prints how many probes it made, how many failed and the longest run of failures in
# seconds, on one line. kubectl and the second's sleep run as children it waits for, so SIGTERM is
# handled at once, and they are stopped with it.
probe_api() {
  local probe='' tick='' started
  probes=0 failed=0 longest=0 down_since=''
  trap 'end_probe' TERM
  while :; do
    started=$EPOCHSECONDS
    # The second runs alongside the probe, so the next probe starts a second after this one did,
    # or as soon as this one ends when it took longer.
    sleep 1 > /dev/null &
    tick=$!
    kubectl get --raw /readyz --request-timeout=2s > /dev/null 2>&1 &
    probe=$!
    if wait "$probe"; then
      if [[ -n $down_since ]]; then
        end_run "$started"
        say "/readyz answers again" >&2
      fi
    else
      failed=$((failed + 1))
      if [[ -z $down_since ]]; then
        down_since=$started
        say "/readyz does not answer" >&2
      fi
    fi
    probes=$((probes + 1))
    wait "$tick"
  done
}

# end_run TIME: ends the run of failures under way, if any, at TIME, in seconds since the epoch, and
# keeps it when it is the longest. A run lasts at least a second, as the probes are a second apart.
end_run() {
  local run
  [[ -n $down_since ]] || return 0
  run=$(($1 - down_since))
  ((run > 0)) || run=1
  ((run <= longest)) || longest=$run
  down_since=''
}

# end_probe: probe_api's SIGTERM handler.
end_probe() {
  kill "$probe" "$tick" 2> /dev/null || true
  wait "$probe" "$tick" 2> /dev/null || true
  end_run "$EPOCHSECONDS"
  printf '%s %s %s\n' "$probes" "$failed" "$longest"
  exit 0
}

# start_probe: starts probe_api in the background, its report to be read from probe_out.
start_probe() {
  exec {probe_out}< <(probe_api)
  probe_pid=$!
}

# stop_probe: stops the probe if it runs, waits until it has ended, and reads its report into probes,
# failed and longest; probes is empty when it reported nothing.
stop_probe() {
  [[ -n ${probe_pid-} ]] || return 0
  kill -TERM "$probe_pid" 2> /dev/null || true
  read -r probes failed longest <&"$probe_out" || probes=''
  wait "$probe_pid" 2> /dev/null || true
  exec {probe_out}<&-
  probe_pid=''
}

# On every exit the probe is stopped first; then a failing run names its step, as
# report_failed_step has it do. Ctrl-C ends the recipe even when talman handles SIGINT itself and
# exits 0, after which bash would otherwise go on.
on_exit() {
  local status=$1
  stop_probe
  failed_step "$status"
  exit "$status"
}
trap 'on_exit $?' EXIT
trap 'exit 130' INT

step="waiting for $node to be typed back"
((confirmed)) || confirm "$node" reboot rebooted

step="rebooting $node with talman"
say "rebooting $node with talman; /readyz is asked through the kubeconfig once a second until it is Ready again"
since=$(date -u +%Y-%m-%dT%H:%M:%SZ)
start_probe
rebooted=0
cluster_talman reboot -n "$node" --yes || rebooted=$?

back=0
if ((rebooted == 0)); then
  step="waiting for $node to be Ready"
  say "talman has rebooted $node; waiting up to ${ready_wait}s for it to report Ready"
  deadline=$((SECONDS + ready_wait))
  while :; do
    if not_ready=$(not_ready_since "$since" "$node") && [[ -z $not_ready ]]; then
      back=1
      break
    fi
    ((SECONDS < deadline)) || break
    sleep 5
  done
fi

stop_probe
if [[ -z $probes ]]; then
  infra_error "the probe of /readyz reported nothing"
  exit 1
fi
say "/readyz asked $probes times, $failed failed; longest run of failures ${longest}s"
if ((rebooted != 0)); then
  step="rebooting $node with talman"
  exit "$rebooted"
fi
if ((!back)); then
  infra_error "$node has not reported Ready since its reboot, after ${ready_wait}s; REBOOT_WAIT sets how long to wait"
  exit 1
fi
step="checking that /readyz answered"
if ((failed > 0 && longest > tolerate)); then
  infra_error "$node is Ready again, but /readyz did not answer for up to ${longest}s while it rebooted; --tolerate $longest accepts a gap that long"
  exit 1
fi
if ((failed > 0)); then
  say "$node is Ready again; /readyz did not answer for up to ${longest}s, within the ${tolerate}s tolerated"
else
  say "$node is Ready again, and /readyz answered every probe"
fi
