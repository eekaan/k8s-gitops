#!/usr/bin/env bash
# The tools image: the container with the tools pinned in mise.toml that just ci runs the checks in
# (.dagger/modules/ci), built once for each change of its inputs, published to this repository's
# container registry and signed, so a CI job pulls it instead of installing the tools. Its inputs
# are ci_tools_base and ci_tools_packages in versions.yaml, the Dagger module that builds it, whole,
# and mise.toml; their key names it: the image's tag, the annotation its signature carries, and what
# versions.yaml records beside its digest. Bash, coreutils and awk only, as just ci runs it on a host
# without the pinned tools.
#
#   key         Prints the key of the checkout's inputs.
#   ci-args     Prints the arguments just ci hands the module, one per line: the inputs, and the
#               image versions.yaml records when it was built for these inputs, by digest. Says on
#               stderr which. Refuses a record of any image but this repository's tools image.
#   publish     Runs only in the tools image workflow on main. Logs in to ghcr.io with the job's token
#               on standard input, into a Docker configuration of the run's own, which dagger and
#               cosign read too and which is removed when the run ends; no other command gets the
#               token. Unless an image signed for the key is there already, builds the tools with
#               the pinned Dagger, pushes them tagged with the key, signs the digest the push reports
#               keyless with the key as an annotation, and verifies that signature against this
#               workflow's identity on main in this repository. Prints its steps on stderr, with why
#               no image was found to reuse, and then the digest, alone, on stdout. Reads what
#               GitHub Actions sets: GITHUB_ACTIONS, ACTIONS_ID_TOKEN_REQUEST_URL and
#               ACTIONS_ID_TOKEN_REQUEST_TOKEN (a job with id-token: write), GITHUB_REF and
#               GITHUB_ACTOR; and REGISTRY_TOKEN, the job's token with packages: write.
#   pin DIGEST  Records the image at DIGEST in versions.yaml with the checkout's key, once its
#               signature verifies as the tools image workflow's on main in this repository for that
#               key. The verification uses no credentials, so it also proves that the checks can
#               pull the image. Otherwise versions.yaml stays as it is.
# Usage: scripts/tools-image key | ci-args | publish | pin DIGEST
set -euo pipefail
# A failure inside $(...) stops the run too, not only the substitution.
shopt -s inherit_errexit
# The registry token leaves the environment before any command starts, so it reaches docker login on
# standard input and nothing else, and nothing a command prints can hold it.
registry_token=${REGISTRY_TOKEN-}
unset REGISTRY_TOKEN

# The image, and the signature a pin accepts: the tools image workflow of this repository on main, as
# GitHub's token issuer names it, in a run of this repository, so a run elsewhere that called the
# workflow is no match. Renaming the workflow file changes the identity.
repository=eekaan/k8s-gitops
image=ghcr.io/$repository/ci-tools
identity=https://github.com/$repository/.github/workflows/tools-image.yaml@refs/heads/main
issuer=https://token.actions.githubusercontent.com

root=$(cd "$(dirname "$0")/.." && pwd)
versions=$root/versions.yaml
module=.dagger/modules/ci/main.dang

say() {
  printf 'tools-image: %s\n' "$1" >&2
}

fail() {
  say "$1"
  exit 1
}

# setting NAME: the value on the one line NAME: VALUE of versions.yaml; "" stands for empty. Refuses a
# name on no line or on several, and a value that YAML would read otherwise than as written.
setting() {
  local lines value continued
  lines=$(grep -E "^$1:( |$)" "$versions" || true)
  if [[ -z $lines || $lines == *$'\n'* ]]; then
    fail "versions.yaml must set $1 on exactly one line"
  fi
  value=${lines#"$1:"}
  value=${value# }
  case $value in
    '""') value= ;;
    # What YAML reads as a quote, an indicator or a comment, or drops.
    [\"\'\&\*\!\|\>%@\`\{\[\#]* | *' #'* | *$'\t'* | *': '* | *[[:space:]])
      fail "versions.yaml: $1 must be a value without quotes, tabs or a comment, or \"\""
      ;;
  esac
  # YAML reads an indented line under a value, blank lines between or not, as more of it.
  continued=$(awk -v name="$1" '
    after && /^[ \t]*$/ { next }
    after { print (/^[ \t]/ ? "yes" : "no"); exit }
    $0 == name ":" || index($0, name ": ") == 1 { after = 1 }
  ' "$versions")
  if [[ $continued == yes ]]; then
    fail "versions.yaml: $1 must be on one line, with no indented line under it"
  fi
  printf '%s' "$value"
}

# inputs: sets base and packages from versions.yaml.
inputs() {
  base=$(setting ci_tools_base)
  packages=$(setting ci_tools_packages)
  if [[ -z $base || -z $packages ]]; then
    fail "versions.yaml must set ci_tools_base and ci_tools_packages"
  fi
}

# sha256: the SHA-256 of standard input, in hexadecimal.
sha256() {
  if command -v sha256sum > /dev/null; then sha256sum; else shasum -a 256; fi | cut -d' ' -f1
}

# key: the SHA-256 of the inputs, one line each: the two values after their names, then the SHA-256 of
# the Dagger module and of mise.toml after their paths. The whole module counts, as what the layer
# holds can depend on any of it; a change to it costs one build. A value holds no newline, so no
# two sets of inputs hash the same text.
key() {
  local base packages
  inputs
  {
    printf 'ci_tools_base: %s\nci_tools_packages: %s\n' "$base" "$packages"
    printf '%s: %s\n' "$module" "$(sha256 < "$root/$module")" mise.toml "$(sha256 < "$root/mise.toml")"
  } | sha256
}

# recorded: sets recorded_key and recorded_image from versions.yaml: both empty, or a key and this
# repository's tools image named by its digest alone.
recorded() {
  local digest
  recorded_key=$(setting ci_tools_inputs)
  recorded_image=$(setting ci_tools_image)
  if [[ -z $recorded_key && -z $recorded_image ]]; then
    return 0
  fi
  if [[ ! $recorded_key =~ ^[0-9a-f]{64}$ ]]; then
    fail "versions.yaml: ci_tools_inputs must be a key as just tools-image-key prints it, with ci_tools_image, or both \"\""
  fi
  # A merged record is what every later run on main executes in, the self-hosted runner's among them,
  # so it names the image the pin verified and nothing else. A tag can move; only the digest names
  # the bytes that were signed and verified.
  digest=${recorded_image#"$image@"}
  if [[ $recorded_image != "$image@$digest" || ! $digest =~ ^sha256:[0-9a-f]{64}$ ]]; then
    fail "versions.yaml: ci_tools_image must be $image@sha256:<digest>, the tools image of this repository by its digest"
  fi
}

ci_args() {
  local base packages current recorded_key recorded_image
  inputs
  current=$(key)
  recorded
  printf '%s\n' "--tools-base=$base" "--tools-packages=$packages"
  if [[ -z $recorded_image ]]; then
    say "the tools are built from the pins: versions.yaml records no tools image"
  elif [[ $recorded_key != "$current" ]]; then
    say "the tools are built from the pins: versions.yaml records a tools image for other inputs, $recorded_key, not $current"
  else
    say "the checks run in $recorded_image, the tools image versions.yaml records for these inputs"
    printf '%s\n' "--tools-image=$recorded_image"
  fi
}

# check_digest DIGEST MESSAGE: fails with MESSAGE unless DIGEST is sha256: and 64 hexadecimal digits.
check_digest() {
  if [[ ! $1 =~ ^sha256:[0-9a-f]{64}$ ]]; then
    fail "$2"
  fi
}

publish() {
  local name base packages key verified reason digest pushed
  # Keyless signing needs the job's identity token, which only a workflow run can request; nobody
  # publishes from a laptop.
  if [[ ${GITHUB_ACTIONS:-} != true || -z ${ACTIONS_ID_TOKEN_REQUEST_URL:-} || -z ${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-} ]]; then
    fail "refusing to publish outside the tools image workflow: it needs GitHub Actions and the job's identity token"
  fi
  for name in GITHUB_REF GITHUB_ACTOR; do
    [[ -n ${!name:-} ]] || fail "$name is not set; the tools image workflow sets it"
  done
  [[ -n $registry_token ]] || fail "REGISTRY_TOKEN is not set; the tools image workflow sets it"
  # A pin accepts only main's signature, and a branch's run would move the key's tag.
  if [[ $GITHUB_REF != refs/heads/main ]]; then
    fail "refusing to publish from $GITHUB_REF: only a run on refs/heads/main publishes"
  fi
  inputs
  key=$(key)

  DOCKER_CONFIG=$(mktemp -d)
  export DOCKER_CONFIG
  step="starting"
  trap 'finish $?' EXIT

  begin "logging in to ghcr.io"
  printf '%s' "$registry_token" | docker login ghcr.io --username "$GITHUB_ACTOR" --password-stdin > /dev/null
  registry_token=

  begin "looking for $image:$key, signed for these inputs"
  if verified=$(cosign verify --certificate-identity "$identity" --certificate-oidc-issuer "$issuer" \
    --certificate-github-workflow-repository "$repository" -a "tools-key=$key" "$image:$key" \
    2> "$DOCKER_CONFIG/lookup.err"); then
    digest=$(jq -r '[.[].critical.image["docker-manifest-digest"]] | unique | if length == 1 then .[0] else "" end' <<< "$verified")
    check_digest "$digest" "the signature of $image:$key names no single sha256 digest"
    say "$image:$key is $digest, signed and verified; nothing to build. Record it with: just tools-image-pin $digest"
    printf '%s\n' "$digest"
    return 0
  fi
  # No tag, another signature, or no answer from the registry or the transparency log: all build anew,
  # and the run says which it was.
  reason=$(grep -v '^[[:space:]]*$' "$DOCKER_CONFIG/lookup.err" | tail -n 1 || true)
  say "found none to reuse: ${reason:-cosign said nothing}"

  begin "building the tools and pushing them as $image:$key"
  pushed=$(dagger api call --progress=plain ci tools-layer --base="$base" --packages="$packages" \
    publish --address="$image:$key")
  digest=${pushed##*@}
  if [[ $pushed != "$image:$key@$digest" ]]; then
    fail "the push reported $pushed, not $image:$key with a digest, so nothing is signed"
  fi
  check_digest "$digest" "the push reported no sha256 digest, so nothing is signed"
  say "pushed $digest"

  begin "signing $digest"
  cosign sign --yes --oidc-provider github-actions -a "tools-key=$key" "$image@$digest"

  begin "verifying $digest"
  # The verified signatures are printed as JSON; the run reports only that they verified.
  cosign verify --certificate-identity "$identity" --certificate-oidc-issuer "$issuer" \
    --certificate-github-workflow-repository "$repository" -a "tools-key=$key" "$image@$digest" > /dev/null

  say "published $image@$digest for $key. Record it with: just tools-image-pin $digest"
  printf '%s\n' "$digest"
}

# begin STEP: names the step the run is in, here and in the line a failure ends with.
begin() {
  step=$1
  say "$step"
}

finish() {
  rm -rf "${DOCKER_CONFIG:?}"
  if (($1)); then
    say "failed while $step"
  fi
}

pin() {
  local digest=$1 key written
  check_digest "$digest" "pin takes the digest the tools image workflow printed, sha256: and 64 hexadecimal digits, not $digest"
  key=$(key)
  # The lines the pin rewrites are there, once each.
  setting ci_tools_inputs > /dev/null
  setting ci_tools_image > /dev/null

  # No credentials, so an image the checks could not pull anonymously is not pinned: a Docker
  # configuration of the run's own with no login in it, which cosign reads in place of any other.
  # Without one it would look for podman's logins, in $REGISTRY_AUTH_FILE or containers/auth.json.
  anonymous=$(mktemp -d)
  trap 'rm -rf "$anonymous"' EXIT
  printf '{}\n' > "$anonymous/config.json"
  say "verifying $image@$digest as the tools image workflow's on main for $key"
  if ! env -u REGISTRY_AUTH_FILE DOCKER_CONFIG="$anonymous" cosign verify --certificate-identity "$identity" \
    --certificate-oidc-issuer "$issuer" --certificate-github-workflow-repository "$repository" \
    -a "tools-key=$key" "$image@$digest" > /dev/null; then
    fail "versions.yaml is unchanged: $image@$digest has no signature of the tools image workflow on main for these inputs, $key, or cannot be pulled without credentials; is the package public?"
  fi

  written=$(sed -E -e "s|^ci_tools_inputs:.*$|ci_tools_inputs: $key|" \
    -e "s|^ci_tools_image:.*$|ci_tools_image: $image@$digest|" "$versions")
  printf '%s\n' "$written" > "$versions"
  say "versions.yaml records $image@$digest for $key"
}

cd "$root"
case ${1-}:$# in
  key:1) key ;;
  ci-args:1) ci_args ;;
  publish:1) publish ;;
  pin:2) pin "$2" ;;
  *)
    echo "usage: scripts/tools-image key | ci-args | publish | pin DIGEST" >&2
    exit 1
    ;;
esac
