#!/usr/bin/env bash
# Destroys the cluster stack and then the plumbing stack, whose network and image the cluster stack
# builds on. Each stack's destroy is planned and summarised first, and runs only once the stack's
# name is typed back, or with --yes (CI). The plumbing stack is left alone when the cluster stack
# is not destroyed. State objects stay. Once the cluster stack is destroyed, the files generated for
# its cluster that hold the nodes' and the API's addresses are removed, as the cloud may give those
# addresses to someone else. Given one of the two stacks, or the ci stack, it destroys that one
# only, the same way, as cluster-destroy does with the cluster stack. The ci stack is destroyed by
# name only: the CI host outlives the cluster, and is destroyed before the plumbing stack, whose
# network it is on.
# The plumbing stack's subnet and router interface cannot be removed while a port or a floating IP
# of another stack uses them, so before anything is changed, a run that would destroy the plumbing
# stack reads the state of every other stack of its region that the run does not destroy first, and
# refuses while one holds a resource, naming the recipe that destroys that stack. Neither a
# resource's address nor any value of the state is printed.
# Usage: scripts/infra-destroy [stack] [--yes]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/infra.sh
. "$here/lib/infra.sh"

stacks=(sto2/cluster sto2/plumbing)
named=("${stacks[@]}" sto2/ci)

usage() {
  infra_error "usage: infra-destroy [stack] [--yes]; the stack is one of ${named[*]}"
  exit 2
}

confirmed=0 only=''
for arg; do
  case $arg in
    --yes) confirmed=1 ;;
    -*) usage ;;
    *)
      [[ -z $only && " ${named[*]} " == *" $arg "* ]] || usage
      only=$arg
      ;;
  esac
done
if [[ -n $only ]]; then
  stacks=("$only")
fi

# Hook for removing the load balancers and volumes the cluster creates itself, outside OpenTofu,
# which would keep the network from being deleted. It is not done; the hook says so.
remove_cluster_made_load_balancers_and_volumes() {
  infra_error "not implemented: removing the load balancers and volumes the cluster created outside OpenTofu; they are left in place"
}

# cluster_name: the name of the cluster the stack's talman_yaml output configures, empty when the
# stack has none. tofu's JSON holds every output's value; only jq and yq read it.
cluster_name() {
  local outputs name
  outputs=$(stack_tofu output -json) || return 1
  name=$(jq -r '.talman_yaml.value // ""' <<< "$outputs" | yq '.clusterName // ""')
  # The name becomes a path under talos/, so it is a plain name that cannot lead out of it.
  if [[ -n $name && ! $name =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
    infra_error "the clusterName in $stack's talman_yaml is not a name of lower-case letters, digits and hyphens"
    return 1
  fi
  printf '%s' "$name"
}

# remove_generated CLUSTER: removes the files generated for CLUSTER that hold the addresses of its
# nodes and its API: talman.yaml, and the talosconfig and kubeconfig talman writes into
# clusterconfig/. A later bootstrap or onboarding would otherwise send machine configuration to
# whoever answers at those addresses. Only a file that git ignores, and so neither tracks nor would
# commit, is removed; the secrets bundle and etcd snapshots stay. Names what it removes, never what
# the files held.
remove_generated() {
  local path
  local -a removed=()
  for path in "talos/$1/talman.yaml" "talos/$1/clusterconfig/talosconfig" "talos/$1/clusterconfig/kubeconfig"; do
    [[ -e $infra_root/$path || -L $infra_root/$path ]] || continue
    if git -C "$infra_root" check-ignore -q -- "$path"; then
      rm -f -- "${infra_root:?}/$path"
      removed+=("$path")
    else
      infra_error "$path is not a file git ignores, so it is left in place; it may hold the destroyed cluster's addresses"
    fi
  done
  if ((${#removed[@]} > 0)); then
    echo "removed what held the destroyed cluster's addresses: ${removed[*]}"
  fi
}

# holds_resources STACK: whether STACK's state holds a managed resource: 0 when it does, 1 when it
# holds none, 2 when the state cannot be read. A stack never applied has no state and holds none;
# data sources are not resources. Run in a subshell, so STACK's inputs and lock do not carry over.
# Reading state evaluates no variable, but stack-env requires every input the stack declares, so the
# ones the ci stack takes from the environment are filled in for it.
holds_resources() {
  (
    export CI_HOST_IMAGE=${CI_HOST_IMAGE:-state-read-only}
    export CI_HOST_SSH_PUBLIC_KEY=${CI_HOST_SSH_PUBLIC_KEY:-state-read-only}
    # shellcheck source=scripts/stack-env
    . "$here/stack-env" "$1" || exit 2
    lock_stack || exit 2
    init_stack || exit 2
    state=$(stack_tofu show -json) || exit 2
    jq -e '[.values.root_module? // empty | .. | objects | select(.mode? == "managed")] | length > 0' \
      <<< "$state" > /dev/null || exit 1
  )
}

# require_nothing_on_plumbing: fails, naming the recipe that destroys it, for each stack beside a
# plumbing stack this run destroys whose state holds a resource, except the stacks this run
# destroys before it.
require_nothing_on_plumbing() {
  local plumbing other region status refused=0 recipe
  for plumbing in "${stacks[@]}"; do
    [[ $plumbing == */plumbing ]] || continue
    region=${plumbing%%/*}
    # shellcheck disable=SC2031 # lib/infra.sh sets infra_root once; stack-env only sources it again
    for other in "$infra_root/infra/openstack/stacks/$region"/*/; do
      other=$region/$(basename "$other")
      if [[ $other == "$plumbing" || " ${stacks[*]} " == *" $other "* ]]; then
        continue
      fi
      status=0
      holds_resources "$other" || status=$?
      case $status in
        0)
          recipe="just infra-destroy $other"
          [[ $other != */cluster ]] || recipe="just cluster-destroy"
          infra_error "$other still holds resources on the network of $plumbing, which cannot be destroyed while a port or a floating IP uses it; destroy $other first with: $recipe"
          refused=1
          ;;
        1) ;;
        *)
          infra_error "cannot read the state of $other, which may hold resources on the network of $plumbing; nothing was destroyed"
          refused=1
          ;;
      esac
    done
  done
  ((!refused))
}

require_nothing_on_plumbing

for stack in "${stacks[@]}"; do
  # One subshell per stack, so neither its inputs nor its lock carry over to the next.
  (
    # shellcheck source=scripts/stack-env
    . "$here/stack-env" "$stack"
    lock_stack
    init_stack
    echo "$stack:"
    plan_destroy
    ((confirmed)) || confirm "$stack" destroy destroyed
    cluster=
    if [[ $stack == */cluster ]]; then
      remove_cluster_made_load_balancers_and_volumes
      # Read before the destroy, which takes the outputs with it.
      cluster=$(cluster_name)
    fi
    apply_plan
    echo "$stack destroyed"
    if [[ -n $cluster ]]; then
      remove_generated "$cluster"
    fi
  )
done
