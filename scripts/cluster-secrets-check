#!/usr/bin/env bash
# Fails when a secrets.sops.yaml anywhere under talos/ that git tracks or would commit is not
# SOPS-encrypted: when it carries no SOPS metadata, or any value in it is not sops ciphertext. The
# recipient in talos/.sops.yaml is not read, so its placeholder neither passes nor fails a bundle.
# Prints one line per bundle that fails, naming it and nothing of its content, and exits non-zero;
# otherwise one line with how many it checked.
set -euo pipefail

# shellcheck source=scripts/lib/cluster.sh
. "$(dirname "$0")/lib/cluster.sh"
cd "$(git rev-parse --show-toplevel)"

checked=0 failed=0
while IFS= read -r -d '' path; do
  # A tracked file deleted from the working tree leaves nothing to commit.
  [[ -f $path ]] || continue
  checked=$((checked + 1))
  if ! bundle_encrypted "$path"; then
    echo "cluster-secrets-check: $path is not SOPS-encrypted; encrypt it, or remove it without committing it" >&2
    failed=1
  fi
done < <(git ls-files -z --cached --others --exclude-standard -- ':(glob)talos/**/secrets.sops.yaml')
if ((failed)); then
  exit 1
fi
echo "cluster-secrets-check: $checked secrets bundle(s) under talos/, all SOPS-encrypted"
