#!/usr/bin/env bash
# Builds a cluster from nodes waiting in maintenance mode, in this order: waits until every node in
# its talman.yaml answers on the Talos API port; talman apply --bootstrap, which configures the
# first control plane, starts etcd on it and then configures the others, onboarding every node;
# fetches the kubeconfig with cluster-kubeconfig; installs Cilium with install-cilium; applies what
# Flux needs before it starts with cluster-config, the approver's values among it; installs the
# kubelet serving-certificate approver with install-app, as the kubelets' serving certificates wait
# for it; and waits until every node in talman.yaml is a Ready Kubernetes node.
#
# A cluster that is built already is refused by talman, which bootstraps only when every control
# plane answers and none runs etcd, as a second bootstrap would split the cluster. No health check
# runs: talosctl health, reaching the nodes through their floating addresses, compares those with
# the addresses the nodes hold on the node network, which differ by design, so it never passes.
# Usage: scripts/cluster-bootstrap [cluster]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/cluster-env
. "$here/cluster-env" "${1-}"
complete=1
require_cluster talman secrets age-key api-address wait || complete=0
# Once etcd runs, this cannot run again, so what cluster-config needs is checked before that too.
require_pre_flux "$cluster" "$talman_file" || complete=0
((complete))

step="waiting for every node to answer on the Talos API port"
wait_for_talos_api "$talman_file"

step="bootstrapping the cluster with talman apply"
talman apply --bootstrap --onboard-new-nodes

step="fetching the kubeconfig"
"$here/cluster-kubeconfig" "$cluster"

step="installing Cilium"
"$here/install-cilium"

step="applying the objects Flux needs before it starts"
"$here/cluster-config" "$cluster"

step="installing the kubelet serving-certificate approver"
"$here/install-app" "$infra_root/kubernetes/apps/base/kube-system/kubelet-csr-approver"

step="waiting for every node to be Ready"
hostnames=$(talman_nodes "$talman_file" | cut -d' ' -f1)
mapfile -t nodes <<< "$hostnames"
kubectl wait --for=create --for=condition=Ready --timeout=15m "${nodes[@]/#/node/}"
echo "cluster-bootstrap: every node of $cluster is Ready"
