#!/usr/bin/env bash
# Rotates one secret of an application: replaces the key KEY of the secret at PATH under secrets/
# in OpenBao with a value it makes itself, and proves that every pod that mounts it is a new pod
# that holds the new value, and that none holds the value from before. The cluster is lab-sto2.
#
# Before it reaches the cluster it stops unless secret-rotation.yaml, at the repository's root,
# lists the key as generated, the one rotation any new random value will do for; an entry that
# names the key goes before its path's entry without one. It takes a path and a key as bao-put
# does and repeats none it refuses, as a value given where an argument goes by mistake would
# otherwise be printed.
#
# Then, reading only:
#   - every ExternalSecret, in any namespace, that reads the key from the ClusterSecretStore
#     openbao, by the path in any form External Secrets reads as that path. Each must read it as
#     one entry of spec.data with the path and the property, plain,
#     and write a Secret without a template, so the Secret holds the value as it is written; be
#     one External Secrets refreshes when an annotation changes (not CreatedOnce, no refresh
#     interval of zero); and be Ready;
#   - for each, the Deployments, StatefulSets and DaemonSets of its namespace whose pod template
#     names its Secret. Each must take it as a secret volume that holds the key, mounted whole in
#     a container; carry an annotation by which Reloader restarts it for that Secret, read as
#     Reloader reads them (ShouldReload in pkg/common/common.go at v1.4.24), though a name in
#     secret.reloader.stakater.com/reload counts only where it is the Secret's own, not a pattern
#     for it; be able to roll every pod; and be settled;
#   - their running pods, and from each the SHA-256 digest of the file, taken in the pod by
#     sha256sum, which answers with a digest and never the content.
# Anything else is refused, naming what and why, and nothing is changed.
#
# It prints the plan, and goes on once the path is typed back, or with --yes:
#   1. makes the value, 32 random bytes of the kernel as 64 hexadecimal digits, and stops if it
#      is one a pod already holds;
#   2. writes it by running scripts/bao-put with the value on its standard input, the only write:
#      this script sends OpenBao nothing itself;
#   3. sets the annotation force-sync of each ExternalSecret to a value no other run has set, the
#      time and eight random bytes, and reads each until its status.syncedResourceVersion is
#      another than it was right before the annotation, for up to the wait; one that is not Ready
#      then stops the run;
#   4. reads each workload until its generation has passed the one read before, which Reloader's
#      change to the pod template moves, then waits for kubectl rollout status, both within the
#      wait;
#   5. proves: every running pod that is not being deleted is none of the pods read before, by
#      UID, and the digest of its file is the digest of the value written; with step 1, none of
#      them holds a value from before.
# The proof is made of digests because the operator role may create and patch a key and never
# read one: neither the old value nor the new one can be read back from the store, and the Secret
# is never read. The new value reaches a pod only from the store, through the ExternalSecret, so a
# pod whose digest is the written value's holds what the store served.
#
# Neither the value nor a digest is printed, passed as an argument, exported or written to a
# file: they stay in this shell's memory and on pipes, and kubectl's errors are shown as
# bao_kubectl shows them (scripts/lib/openbao.sh). The script makes no file. Standard input is
# the operator's, for the one answer: every command it starts gets /dev/null in its place, or a
# pipe of its own, as bao-put gets the value's.
#
# A run that stops after the write says what the store holds. Until every ExternalSecret has
# refreshed, the Secret follows at its next refresh by itself and Reloader restarts the workloads
# then; once they have, the Secrets hold it too, the files of the running pods take it within the
# kubelet's sync period, and a restart Reloader has not made once it has seen the change does not
# come by itself. Either way, a second run writes another value and proves that one.
# Usage: scripts/secret-rotate <path> <key> [--yes] [--wait <seconds>]
set -euo pipefail

# The libraries and the environment are read like every command below: with /dev/null where the
# operator's standard input was.
{
  here=$(dirname "$0")
  # shellcheck source=scripts/lib/openbao.sh
  . "$here/lib/openbao.sh"
  # An empty argument, so cluster-env takes lab-sto2 and not this script's own arguments.
  # shellcheck source=scripts/cluster-env
  . "$here/cluster-env" ""
} < /dev/null

list=$infra_root/secret-rotation.yaml
docs="docs/kubernetes.md, Rotating an application's secret"
store=openbao
external_secrets=externalsecrets.external-secrets.io

# What this run has reached: whether it has read the cluster, what the store holds of the new
# value (no, unknown while bao-put has not answered, yes), whether every ExternalSecret has
# refreshed its Secret since, and whether the proof is made.
reading=0 stored=no followed=0 proved=0
# What stands in the way of the rotation was found: refuse says each, and the run stops after all.
refused=0

# The ExternalSecrets that read the key: namespace, name, the Secret each writes, that Secret's
# key, and the syncedResourceVersion of before the annotation.
es_namespace=() es_name=() es_secret=() es_secret_key=() es_synced=()
# The workloads that mount those Secrets: kind, namespace, name, the generation of before the
# write, the labels that select the pods, the container and the file the proof reads, the
# annotation Reloader restarts it by, and the number of running pods.
wl_kind=() wl_namespace=() wl_name=() wl_generation=() wl_selector=() wl_container=() wl_file=() wl_annotation=() wl_pods=()
# The pods read before the write, and the digest of what each held.
uids_before=() digests_before=()

usage() {
  infra_error "give the path and the key of a secret that secret-rotation.yaml lists as generated: just secret-rotate <path> <key> [--yes] [--wait <seconds>]"
  exit 1
}

# refuse MESSAGE: says one thing that stands in the way of the rotation; the run goes on looking
# for the others, and stops before it changes anything.
refuse() {
  infra_error "$1"
  refused=1
}

# counted NUMBER: NUMBER pods, in words.
counted() {
  if (($1 == 1)); then echo "1 pod"; else echo "$1 pods"; fi
}

# resource_of KIND: the resource kubectl names a workload kind by.
resource_of() {
  case $1 in
    Deployment) echo deployments.apps ;;
    StatefulSet) echo statefulsets.apps ;;
    DaemonSet) echo daemonsets.apps ;;
  esac
}

# on_exit STATUS: a run that fails says what it left: nothing changed, a write bao-put did not
# confirm, the store holding a value the Secrets have not all refreshed to, or the store and the
# Secrets holding a value the pods were not proved to hold; then the step it was in. A Secret that
# has not refreshed brings Reloader's restart with it when it does; one that has refreshed brings
# no further restart, as Reloader acts on a change when it sees it, and the files of the running
# pods follow it.
on_exit() {
  local status=$1
  trap '' INT TERM HUP
  if ((status != 0)); then
    case $stored in
      no) ((!reading)) || infra_error "nothing was written or changed" ;;
      unknown) infra_error "bao-put did not confirm the write: the store holds the value from before or the new one, which the Secret follows at its next refresh; a second run rotates again and proves it" ;;
      yes)
        if ((proved)); then
          :
        elif ((followed)); then
          infra_error "the store holds the new value of $key at $bao_mount/$path, and so do the Secrets: the running pods' files take it within the kubelet's sync period, and a second run rotates again and proves it"
        else
          infra_error "the store holds the new value of $key at $bao_mount/$path: the Secret follows at the next refresh by itself, Reloader restarts the workloads once it has, and a second run rotates again and proves it"
        fi
        ;;
    esac
  fi
  failed_step "$status"
  exit "$status"
}

# listed: stops unless secret-rotation.yaml lists the key as generated. An entry that names the
# key decides before its path's entry without one.
listed() {
  local entries entry rotation reason
  # shellcheck disable=SC2016 # $path and $key are jq variables.
  if ! entries=$(yq --output-format json --indent 0 '.secrets' "$list" 2> /dev/null) ||
    ! entry=$(printf '%s' "$entries" | jq -c --arg path "$path" --arg key "$key" '
      if type == "array" and all(.[]; type == "object") then . else error("no list of entries") end
      | (map(select(.path == $path and .key == $key)) + map(select(.path == $path and (has("key") | not))))[0] // {}' 2> /dev/null); then
    infra_error "secret-rotation.yaml is not there or is no list of the store's keys; nothing is rotated without it"
    exit 1
  fi
  rotation=$(printf '%s' "$entry" | jq -r '.rotation // "" | tostring')
  reason=$(printf '%s' "$entry" | jq -r '.reason // "" | tostring' | printable)
  case $rotation in
    generated) ;;
    "")
      infra_error "secret-rotation.yaml names no such key at that path; add its entry, saying how the key is rotated, before rotating it ($docs)"
      exit 1
      ;;
    re-encryption | issued)
      infra_error "secret-rotation.yaml lists that key as $rotation, not as generated, so no new value is made for it: $reason; $docs says how a key of that rotation is rotated"
      exit 1
      ;;
    *)
      infra_error "secret-rotation.yaml gives that key no rotation this recipe knows: generated, re-encryption or issued"
      exit 1
      ;;
  esac
}

# What the ExternalSecrets of the cluster make of the path and the key, one line for each that
# reads them from the store, its fields apart by the unit separator, which keeps an empty one: a
# refusal and its words, or read with the namespace, the name, the Secret, the Secret's key, the
# syncedResourceVersion and the Ready condition's status, reason and message. An entry of
# spec.data or spec.dataFrom reads the store its own sourceRef names, or else the ExternalSecret's
# secretStoreRef, and one that reads a generator reads no store. A key names the path as bao-put
# takes it, or with the mount and the key-value API's data in front, which External Secrets'
# Vault provider takes off (buildPath in providers/v1/vault/client_get.go at v2.15.0). remoteRef's
# defaults are plain.
# shellcheck disable=SC2016 # the dollars are jq variables.
es_filter='
  def plain: . == null or IN("", "None", "Default");
  def at_path: IN($path, $mount + "/" + $path, $mount + "/data/" + $path);
  .items[] | . as $es
  | ($es.spec.secretStoreRef // {}) as $default
  | def here: .sourceRef.generatorRef == null
      and ((.sourceRef.storeRef // $default) | .kind == "ClusterSecretStore" and .name == $store);
    [$es.spec.data[]? | select(here and (.remoteRef.key | at_path))] as $data
  | [$data[] | select(.remoteRef.property == $key)] as $exact
  | [$data[] | select((.remoteRef.property // "") == "")] as $whole
  | [$es.spec.dataFrom[]? | select(here)] as $from
  | select(($exact + $whole | length) != 0 or any($from[]; (.extract.key | at_path) or .find != null))
  | "ExternalSecret \($es.metadata.namespace)/\($es.metadata.name)" as $who
  | ($es.spec.target // {}) as $target
  | ($es.spec.refreshPolicy // "Periodic") as $policy
  | ($es.status.conditions // [] | map(select(.type == "Ready"))[0] // {}) as $ready
  | (if ($whole | length) != 0 then
      "\($who) reads the whole secret at the path, with no property, so its Secret would not hold the value as it was written"
    elif any($from[]; .extract.key | at_path) then
      "\($who) reads every key at the path through a dataFrom extract, so the recipe cannot tell which key of its Secret holds the value"
    elif any($from[]; .find != null) then
      "\($who) finds keys by a pattern, which may match the path, so the recipe cannot tell what its Secret holds"
    elif ($exact | length) != 1 then
      "\($who) reads the key in more than one entry of spec.data, so the recipe cannot tell which key of its Secret the proof is for"
    elif ($exact[0].remoteRef | [.version, .decodingStrategy, .conversionStrategy, .metadataPolicy] | all(plain) | not) then
      "\($who) reads the key with a version, a decoding, a conversion or a metadata policy, so its Secret would not hold the value as it was written"
    elif $target.template != null then
      "\($who) writes its Secret through a template, so the Secret would not hold the value as it was written"
    elif $target.manifest != null then
      "\($who) writes a target that is no Secret, which no pod mounts"
    elif $target.creationPolicy == "None" then
      "\($who) creates no Secret (creationPolicy None), so nothing would follow a new value"
    elif $target.immutable == true then
      "\($who) writes an immutable Secret, which no refresh changes"
    elif $policy == "CreatedOnce" or ($policy == "Periodic" and ($es.spec.refreshInterval // "1h" | test("^-") or (test("[1-9]") | not))) then
      "\($who) is not refreshed again once it has synced (refreshPolicy CreatedOnce, or a refresh interval of zero), so its annotation would not make it read the new value"
    else "" end) as $refusal
  | if $refusal != "" then ["refuse", $refusal]
    else ["read", $es.metadata.namespace, $es.metadata.name, ($target.name // $es.metadata.name), $exact[0].secretKey,
      ($es.status.syncedResourceVersion // ""), ($ready.status // ""), ($ready.reason // ""), ($ready.message // "")] end
  | map(tostring | gsub("[\\n\\r\u001f]"; " ")) | join("\u001f")'

# What the workloads of a namespace make of a Secret and its key, one line for each whose pod
# template names the Secret, as es_filter writes its lines: a refusal and its words, or workload
# with the kind, the name, the generation, the labels that select its pods, the first container
# that mounts the Secret's volume whole, the file the key is there, and the annotation Reloader
# restarts it by. The annotations are read as Reloader v1.4.24 reads them: those of the workload
# itself, or its pod template's when the workload carries neither the reload annotation, either
# automatic one nor reloader.stakater.com/search; a Secret the workload's own exclusion names is
# left alone; then the Secret's name in the list of the reload annotation, and either automatic
# annotation with a value Go parses as true. Reloader matches each entry of the list as a regular
# expression; here only the Secret's own name counts.
# shellcheck disable=SC2016 # the dollars are jq variables.
workload_filter='
  def named($name): (. // "") | split(",") | map(gsub("^\\s+|\\s+$"; "")) | index($name) != null;
  def truthy: . != null and IN("1", "t", "T", "TRUE", "true", "True");
  .items[] | . as $w
  | "\($w.kind) \($w.metadata.namespace)/\($w.metadata.name)" as $who
  | $w.spec.template.spec as $pod
  | ($pod.containers // []) as $containers
  | ($containers + ($pod.initContainers // [])) as $all
  | [$pod.volumes[]? | select(.secret.secretName == $secret)] as $volumes
  | [$volumes[].name] as $names
  | [$all[] | . as $c | .env[]? | select(.valueFrom.secretKeyRef.name == $secret) | $c.name] as $env
  | [$all[] | . as $c | .envFrom[]? | select(.secretRef.name == $secret) | $c.name] as $envFrom
  | [$pod.volumes[]? | select(any(.projected.sources[]?; .secret.name == $secret)) | .name] as $projected
  | select(($names + $env + $envFrom + $projected | length) != 0)
  | [$all[] | . as $c | .volumeMounts[]? | select(.name as $n | $names | index($n) != null)
      | select((.subPath // "") != "" or (.subPathExpr // "") != "") | $c.name] as $sub
  | ([$containers[] | . as $c | .volumeMounts[]? | select(.name as $n | $names | index($n) != null)
      | {container: $c.name, volume: .name, path: .mountPath}][0]) as $mount
  | ([$volumes[] | select(.name == $mount.volume)][0].secret) as $source
  | (if $mount == null then null elif $source.items == null then $key
     else ([$source.items[] | select(.key == $key)][0].path) end) as $file
  | ($w.metadata.annotations // {}) as $own
  | (if ($own | has("secret.reloader.stakater.com/reload") or has("reloader.stakater.com/auto")
        or has("secret.reloader.stakater.com/auto") or has("reloader.stakater.com/search"))
     then $own else ($w.spec.template.metadata.annotations // {}) end) as $read
  | (if ($own["secrets.exclude.reloader.stakater.com/reload"] | named($secret)) then "excluded"
     elif ($read["secret.reloader.stakater.com/reload"] | named($secret)) then "secret.reloader.stakater.com/reload"
     elif ($read["reloader.stakater.com/auto"] | truthy) then "reloader.stakater.com/auto"
     elif ($read["secret.reloader.stakater.com/auto"] | truthy) then "secret.reloader.stakater.com/auto"
     else "" end) as $annotation
  | ($w.spec.selector.matchLabels // {} | to_entries | map("\(.key)=\(.value)") | join(",")) as $selector
  | (if ($env | length) != 0 then
      "\($who) takes the Secret \($secret) through the environment of its container \($env[0]), which the proof cannot read"
    elif ($envFrom | length) != 0 then
      "\($who) takes the Secret \($secret) through envFrom of its container \($envFrom[0]), which the proof cannot read"
    elif ($projected | length) != 0 then
      "\($who) takes the Secret \($secret) in a projected volume, which this recipe does not read"
    elif ($sub | length) != 0 then
      "\($who) mounts the Secret \($secret) with a subPath in its container \($sub[0]), a copy the kubelet never updates"
    elif $mount == null then
      "\($who) mounts the Secret \($secret) in no container that keeps running, so the proof has no file to read"
    elif $file == null then
      "\($who) mounts the Secret \($secret) without its key \($key), so the proof has no file to read"
    elif ($w.spec.selector.matchExpressions // [] | length) != 0 or $selector == "" then
      "\($who) selects its pods with matchExpressions, or with no label, which this recipe does not follow"
    elif $w.kind == "Deployment" and $w.spec.paused == true then
      "\($who) is paused, so a restart would not roll out"
    elif $w.kind != "Deployment" and $w.spec.updateStrategy.type == "OnDelete" then
      "\($who) replaces its pods only when they are deleted (updateStrategy OnDelete), so a restart would not reach them"
    elif $w.kind == "StatefulSet" and ($w.spec.updateStrategy.rollingUpdate.partition // 0) != 0 then
      "\($who) keeps the pods below its partition as they are, so a restart would not reach them"
    elif $annotation == "excluded" then
      "\($who) names the Secret \($secret) in secrets.exclude.reloader.stakater.com/reload, so Reloader leaves it as it is"
    elif $annotation == "" then
      "\($who) carries no annotation by which Reloader restarts it when the Secret \($secret) changes: secret.reloader.stakater.com/reload naming it, secret.reloader.stakater.com/auto or reloader.stakater.com/auto"
    else "" end) as $refusal
  | if $refusal != "" then ["refuse", $refusal]
    else ["workload", $w.kind, $w.metadata.name, $w.metadata.generation, $selector, $mount.container,
      (($mount.path | sub("/+$"; "")) + "/" + $file), $annotation] end
  | map(tostring | gsub("[\\n\\r\u001f]"; " ")) | join("\u001f")'

# read_external_secrets: fills the es_ arrays with every ExternalSecret that reads the key, and
# refuses each that reads it another way than the proof can follow, and each that is not Ready.
read_external_secrets() {
  local all rows row kind a b c d e f g h
  local -a each
  all=$(bao_kubectl get "$external_secrets" --all-namespaces --output json --request-timeout=30s)
  rows=$(printf '%s' "$all" | jq -r --arg path "$path" --arg key "$key" --arg store "$store" --arg mount "$bao_mount" "$es_filter")
  all=""
  if [[ -z $rows ]]; then
    refuse "no ExternalSecret reads $key of $bao_mount/$path from the ClusterSecretStore $store, so no Secret would follow a new value"
    return 0
  fi
  mapfile -t each < <(printf '%s\n' "$rows")
  for row in "${each[@]}"; do
    IFS=$'\x1f' read -r kind a b c d e f g h < <(printf '%s\n' "$row")
    if [[ $kind == refuse ]]; then
      refuse "$a"
      continue
    fi
    if [[ $f != True ]]; then
      refuse "ExternalSecret $a/$b is not Ready ($(printf '%s' "${g:-no condition}: $h" | printable)); if the store does not hold the key yet, just bao-put $path $key seeds it"
    fi
    es_namespace+=("$a") es_name+=("$b") es_secret+=("$c") es_secret_key+=("$d") es_synced+=("$e")
  done
}

# read_workloads: fills the wl_ arrays with every workload that mounts a Secret one of the
# ExternalSecrets writes, and refuses each that takes the Secret another way than as a file the
# proof can read, that Reloader would not restart, or whose pods would not all be replaced.
read_workloads() {
  local i all rows row kind a b c d e f g
  local -a each
  for i in "${!es_name[@]}"; do
    all=$(bao_kubectl get deployments.apps,statefulsets.apps,daemonsets.apps --namespace "${es_namespace[i]}" --output json --request-timeout=30s)
    rows=$(printf '%s' "$all" | jq -r --arg secret "${es_secret[i]}" --arg key "${es_secret_key[i]}" "$workload_filter")
    all=""
    if [[ -z $rows ]]; then
      refuse "no Deployment, StatefulSet or DaemonSet of ${es_namespace[i]} uses the Secret ${es_secret[i]}, so there is no pod to prove the new value in"
      continue
    fi
    mapfile -t each < <(printf '%s\n' "$rows")
    for row in "${each[@]}"; do
      IFS=$'\x1f' read -r kind a b c d e f g < <(printf '%s\n' "$row")
      if [[ $kind == refuse ]]; then
        refuse "$a"
        continue
      fi
      wl_kind+=("$a") wl_namespace+=("${es_namespace[i]}") wl_name+=("$b") wl_generation+=("$c") wl_selector+=("$d")
      wl_container+=("$e") wl_file+=("$f") wl_annotation+=("$g") wl_pods+=(0)
    done
  done
}

# running_pods INDEX: sets pod_names and pod_uids to the workload's pods that run and are not
# being deleted, by name.
running_pods() {
  local rows row
  local -a each=()
  pod_names=() pod_uids=()
  rows=$(bao_kubectl get pods --namespace "${wl_namespace[$1]}" --selector "${wl_selector[$1]}" --output json --request-timeout=30s |
    jq -r '[.items[] | select(.status.phase == "Running" and .metadata.deletionTimestamp == null)]
      | sort_by(.metadata.name)[] | "\(.metadata.name)\u001f\(.metadata.uid)"')
  [[ -z $rows ]] || mapfile -t each < <(printf '%s\n' "$rows")
  for row in "${each[@]}"; do
    pod_names+=("${row%%$'\x1f'*}") pod_uids+=("${row#*$'\x1f'}")
  done
}

# unhex: the lines on standard input with every run of 20 or more hexadecimal digits and hyphens
# replaced, as redact_stream replaces them, but before redact_stream cuts each line at 300
# characters, which could leave the first digits of a digest that stands further in.
unhex() {
  sed -E 's#[0-9A-Fa-f-]{20,}#<token>#g'
}

# kubectl_within SECONDS ARG...: kubectl ARG..., stopped once SECONDS have passed by the clock,
# and then exits 124. As scripts/network-drops bounds its exec, kubectl is the process whose id
# call holds, so the bound stops kubectl itself, and whichever of it and the timer ends first, the
# other is stopped. The timer holds none of the caller's descriptors, so its last second keeps no
# pipe open. Both start in the background, where an interrupt does not reach them, so an
# interrupt, or a signal to stop, of this subshell stops them before it ends.
kubectl_within() (
  limit=$1 call="" timer="" status=0
  shift
  # stop_both STATUS: stops kubectl and the timer, those of them that have started, and exits
  # STATUS.
  # shellcheck disable=SC2329 # It runs from the traps below.
  stop_both() {
    [[ -z $call ]] || kill "$call" 2> /dev/null
    [[ -z $timer ]] || kill "$timer" 2> /dev/null
    exit "$1"
  }
  trap 'stop_both 130' INT
  trap 'stop_both 143' TERM
  trap 'stop_both 129' HUP
  (exec_tool kubectl "$@") &
  call=$!
  (
    end=$((SECONDS + limit))
    while ((SECONDS < end)); do sleep 1; done
  ) > /dev/null 2>&1 &
  timer=$!
  wait -n "$call" "$timer" || true
  if kill -0 "$timer" 2> /dev/null; then
    kill "$timer" 2> /dev/null || true
    wait "$timer" 2> /dev/null || true
    wait "$call" || status=$?
    exit "$status"
  fi
  kill "$call" 2> /dev/null || true
  wait "$call" 2> /dev/null || true
  exit 124
)

# pod_digest NAMESPACE POD CONTAINER FILE: sets digest to the SHA-256 digest of FILE as the pod
# holds it, which sha256sum takes in the container: what leaves the pod is the digest, never the
# content. When it cannot, returns 1 with kubectl's errors, shown as bao_kubectl shows them, in
# digest_errors, and digest_unanswered set where kubectl had not answered within its 30 seconds.
# The digest is kept in this shell and nowhere else.
pod_digest() {
  local out rest line status=0
  digest="" digest_errors="" digest_unanswered=0
  # kubectl's standard output as it is and its errors through redact_stream, both into out: the
  # digest is the one line of 64 hexadecimal digits, which redact_stream would leave of no error.
  # The exec is given 30 seconds, as every other request to the API server is.
  out=$({
    kubectl_within 30 exec --namespace "$1" "$2" --container "$3" -- sha256sum "$4" 2>&1 1>&3 3>&- |
      unhex | redact_stream
    exit "${PIPESTATUS[0]}"
  } 3>&1) || status=$?
  ((status != 124)) || digest_unanswered=1
  rest=$out
  while [[ -n $rest ]]; do
    line=${rest%%$'\n'*}
    if [[ $rest == *$'\n'* ]]; then rest=${rest#*$'\n'}; else rest=""; fi
    if [[ -z $digest && $line =~ ^([0-9a-f]{64})[[:blank:]] ]]; then
      digest=${BASH_REMATCH[1]}
    elif [[ -n $line ]]; then
      digest_errors+=$line$'\n'
    fi
  done
  out="" line=""
  if ((status != 0)) || [[ -z $digest ]]; then
    digest=""
    return 1
  fi
}

# undigested POD CONTAINER FILE: sets problem to what pod_digest's failure says: no file there
# yet, with how one comes to be there, an exec that did not answer in time, or a container that
# cannot run sha256sum on it, after kubectl's own words. Those pass through redact_stream once
# more, as the lines that came on kubectl's standard output have not, and one could hold a digest
# in another form.
undigested() {
  local line
  if [[ $digest_errors == *"sha256sum: "*": No such file or directory"* ]]; then
    problem="$1 holds no file $3 yet: just bao-put $path $key seeds a key the store does not hold, and the kubelet fills the file within its sync period once the Secret holds the key"
    return 0
  fi
  while IFS= read -r line; do
    [[ -z $line ]] || infra_error "kubectl: $line"
  done < <(printf '%s' "$digest_errors" | unhex | redact_stream)
  if ((digest_unanswered)); then
    problem="the container $2 of $1 did not answer within 30s when asked to digest $3"
  else
    problem="the container $2 of $1 cannot digest $3 with sha256sum"
  fi
}

# read_pods: for each workload, refuses one that is in the middle of a rollout, as the restart
# this run waits for could not be told from it, or that has no running pod; and keeps each
# running pod's UID and the digest of what it holds.
read_pods() {
  local j k who
  for j in "${!wl_name[@]}"; do
    who="${wl_kind[j]} ${wl_namespace[j]}/${wl_name[j]}"
    # A settled workload answers at once; ten seconds are for the answer to arrive.
    if ! bao_kubectl rollout status "$(resource_of "${wl_kind[j]}")/${wl_name[j]}" --namespace "${wl_namespace[j]}" --timeout=10s > /dev/null; then
      refuse "$who is in the middle of a rollout, or kubectl cannot follow its rollouts; run again once it has settled"
      continue
    fi
    running_pods "$j"
    if ((${#pod_names[@]} == 0)); then
      refuse "$who has no running pod to prove the new value in"
      continue
    fi
    wl_pods[j]=${#pod_names[@]}
    for k in "${!pod_names[@]}"; do
      if pod_digest "${wl_namespace[j]}" "${pod_names[k]}" "${wl_container[j]}" "${wl_file[j]}"; then
        uids_before+=("${pod_uids[k]}") digests_before+=("$digest")
      else
        undigested "pod ${wl_namespace[j]}/${pod_names[k]}" "${wl_container[j]}" "${wl_file[j]}"
        refuse "$problem"
      fi
    done
  done
  digest=""
}

# plan: what the run will do, before it asks.
plan() {
  local i j
  infra_say "$key of $bao_mount/$path gets a new value, made here from 32 random bytes of the kernel and written with bao-put"
  for i in "${!es_name[@]}"; do
    infra_say "ExternalSecret ${es_namespace[i]}/${es_name[i]} writes it into the Secret ${es_namespace[i]}/${es_secret[i]}, as its key ${es_secret_key[i]}, and is asked to refresh"
  done
  for j in "${!wl_name[@]}"; do
    infra_say "${wl_kind[j]} ${wl_namespace[j]}/${wl_name[j]}, $(counted "${wl_pods[j]}"), is restarted by Reloader through its annotation ${wl_annotation[j]}"
    infra_say "the proof reads ${wl_file[j]} in the container ${wl_container[j]} of each of its pods"
  done
}

# prepare ARG...: everything before the question: the arguments, the list, the cluster as it is,
# and the plan. Changes nothing.
prepare() {
  local complete=1
  local -a named=()
  path="" key="" confirmed=0 limit=300
  while (($#)); do
    case $1 in
      --yes) confirmed=1 ;;
      --wait)
        (($# != 1)) || usage
        limit=$2
        shift
        ;;
      --wait=*) limit=${1#*=} ;;
      -*) usage ;;
      *) named+=("$1") ;;
    esac
    shift
  done
  ((${#named[@]} == 2)) || usage
  path=${named[0]} key=${named[1]}
  if ! bao_valid_path "$path"; then
    infra_error "the path is not a key-value path: names of letters, digits, '_', '.' and '-', not starting with '.' or '-', joined by '/'"
    complete=0
  fi
  if ! bao_valid_key "$key"; then
    infra_error "the key is not one name: letters, digits, '_', '.' and '-', not starting with '.' or '-'"
    complete=0
  fi
  require_seconds --wait "$limit" || complete=0
  # curl and base64 are bao-put's, which would otherwise miss them only once the run has been
  # confirmed.
  require_commands kubectl curl jq yq base64 head od tr sha256sum sed date sleep || complete=0
  require_kubeconfig || complete=0
  ((complete))
  limit=$((10#$limit))

  step="reading secret-rotation.yaml"
  listed

  reading=1
  step="reading the ExternalSecrets that read $key of $bao_mount/$path"
  read_external_secrets
  step="reading the workloads that use their Secrets"
  read_workloads
  step="reading the pods and digesting what each holds"
  read_pods
  if ((refused)); then
    exit 1
  fi
  plan
}

# refreshed INDEX: reads one ExternalSecret again: sets synced to its syncedResourceVersion, ready
# to its Ready condition's status and condition to that condition's reason and message, free of
# control characters.
refreshed() {
  local row reason message
  row=$(bao_kubectl get "$external_secrets" "${es_name[$1]}" --namespace "${es_namespace[$1]}" --output json --request-timeout=30s |
    jq -r '(.status.conditions // [] | map(select(.type == "Ready"))[0] // {}) as $ready
      | [(.status.syncedResourceVersion // ""), ($ready.status // ""), ($ready.reason // ""), ($ready.message // "")]
      | map(tostring | gsub("[\\n\\r\u001f]"; " ")) | join("\u001f")')
  IFS=$'\x1f' read -r synced ready reason message < <(printf '%s\n' "$row")
  condition=$(printf '%s' "${reason:-no condition}: $message" | printable)
}

# rotate: everything after the question: the value, the write, the refresh, the restart, the
# proof and the closing line.
rotate() {
  local value written each stamp i j k who resource generation deadline left pod total=0 failed=0
  local -a held=()

  step="making the new value"
  value=$(head -c 32 /dev/urandom | od -An -vtx1 | tr -d ' \n')
  if [[ ! $value =~ ^[0-9a-f]{64}$ ]]; then
    infra_error "the kernel gave no 32 random bytes"
    exit 1
  fi
  written=$(printf '%s' "$value" | sha256sum)
  written=${written%% *}
  # A value a pod holds already would rotate nothing, and the proof below could not tell a pod
  # that has it from one that never changed.
  for each in "${digests_before[@]}"; do
    if [[ $each == "$written" ]]; then
      infra_error "the value made is one a pod already holds, so writing it would rotate nothing; run again"
      exit 1
    fi
  done
  digests_before=()

  step="writing $key of $bao_mount/$path with bao-put"
  stored=unknown
  printf '%s\n' "$value" | "$here/bao-put" "$path" "$key"
  value=""
  stored=yes

  step="asking the ExternalSecrets to refresh"
  # The time, for whoever reads the annotation, and eight random bytes, as two runs can start in
  # the same second: External Secrets refreshes only when the annotations are others than before.
  stamp=$(date -u +%Y%m%dT%H%M%SZ)-$(od -An -N8 -vtx1 /dev/urandom | tr -d ' \n')
  for i in "${!es_name[@]}"; do
    # Read again right before the annotation: the field moves with any change to the labels or
    # annotations, such as Flux taking off an earlier run's force-sync, and a refresh that change
    # brought about since the plan is not the one asked for here.
    refreshed "$i"
    es_synced[i]=$synced
    bao_kubectl annotate "$external_secrets" "${es_name[i]}" --namespace "${es_namespace[i]}" "force-sync=$stamp" --overwrite --request-timeout=30s > /dev/null
  done
  deadline=$((SECONDS + limit))
  for i in "${!es_name[@]}"; do
    who="ExternalSecret ${es_namespace[i]}/${es_name[i]}"
    step="waiting for $who to refresh"
    while :; do
      refreshed "$i"
      if [[ $ready != True ]]; then
        infra_error "$who turned not Ready when it was asked to refresh ($condition)"
        exit 1
      fi
      [[ $synced == "${es_synced[i]}" ]] || break
      if ((deadline <= SECONDS)); then
        infra_error "$who did not refresh within ${limit}s of its annotation"
        exit 1
      fi
      sleep 1
    done
    infra_say "$who has refreshed the Secret ${es_namespace[i]}/${es_secret[i]}"
  done
  followed=1

  deadline=$((SECONDS + limit))
  for j in "${!wl_name[@]}"; do
    who="${wl_kind[j]} ${wl_namespace[j]}/${wl_name[j]}"
    resource=$(resource_of "${wl_kind[j]}")
    step="waiting for Reloader to restart $who"
    # kubectl rollout status is satisfied by the generation of before the restart as well, so the
    # generation is seen to move first.
    while :; do
      generation=$(bao_kubectl get "$resource" "${wl_name[j]}" --namespace "${wl_namespace[j]}" --output 'jsonpath={.metadata.generation}' --request-timeout=30s)
      if [[ ! $generation =~ ^[0-9]+$ ]]; then
        infra_error "$who gave no generation"
        exit 1
      fi
      ((generation <= wl_generation[j])) || break
      # Reloader restarts for the Secret's update as it sees it, retries a restart that fails five
      # times, 5 to 80 milliseconds apart, and takes a Secret it finds when it starts as created,
      # not changed (Update, Add and handleErr in internal/pkg/controller/controller.go at v1.4.24,
      # reloadOnCreate off): once Reloader has seen the change this run made, it brings no restart
      # later.
      if ((deadline <= SECONDS)); then
        infra_error "Reloader did not restart $who within ${limit}s of the refresh: its generation did not move, and Reloader acts on a change of a Secret when it sees it, so once Reloader has seen this change it will not restart the workload for it by itself, and one that has not seen it yet may still"
        exit 1
      fi
      sleep 1
    done
    step="waiting for the rollout of $who"
    # kubectl reads a timeout of zero as none.
    left=$((deadline - SECONDS))
    ((1 <= left)) || left=1
    if ! bao_kubectl rollout status "$resource/${wl_name[j]}" --namespace "${wl_namespace[j]}" --timeout="${left}s"; then
      infra_error "the rollout of $who did not finish within the ${limit}s the restart is given"
      exit 1
    fi
  done

  step="proving that every pod is new and holds the new value"
  for j in "${!wl_name[@]}"; do
    who="${wl_kind[j]} ${wl_namespace[j]}/${wl_name[j]}"
    running_pods "$j"
    if ((${#pod_names[@]} == 0)); then
      infra_error "$who has no running pod after the restart"
      failed=1
      continue
    fi
    for k in "${!pod_names[@]}"; do
      pod="pod ${wl_namespace[j]}/${pod_names[k]}"
      for each in "${uids_before[@]}"; do
        if [[ $each == "${pod_uids[k]}" ]]; then
          infra_error "$pod is a pod from before the rotation"
          failed=1
          continue 2
        fi
      done
      if ! pod_digest "${wl_namespace[j]}" "${pod_names[k]}" "${wl_container[j]}" "${wl_file[j]}"; then
        undigested "$pod" "${wl_container[j]}" "${wl_file[j]}"
        infra_error "$problem"
        failed=1
      elif [[ $digest != "$written" ]]; then
        infra_error "$pod holds another value than the one written"
        failed=1
      fi
    done
    total=$((total + ${#pod_names[@]}))
    held+=("$(counted "${#pod_names[@]}") of $who")
  done
  digest="" written=""
  if ((failed)); then
    exit 1
  fi
  proved=1

  who=${held[0]}
  for each in "${held[@]:1}"; do
    who+=" and $each"
  done
  if ((total == 1)); then
    who+=" is new and holds the new value"
  else
    who+=" are new and hold the new value"
  fi
  infra_say "$key of $bao_mount/$path is rotated: $who, none the value from before; $((SECONDS - confirmed_at))s from the confirmation to the proof"
}

trap 'on_exit $?' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

prepare "$@" < /dev/null
step="waiting for $path to be typed back"
((confirmed)) || confirm "$path" rotate rotated
confirmed_at=$SECONDS
rotate < /dev/null
