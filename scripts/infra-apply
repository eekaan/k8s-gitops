#!/usr/bin/env bash
# Plans a stack and prints the plan's summary as infra-plan does; once the stack's name is typed
# back, or with --yes (CI), applies exactly that saved plan. Its state is written encrypted to the
# object storage. After a cluster stack, it writes the cluster's talman.yaml as infra-talman does.
# Usage: scripts/infra-apply <region>/<stack> [--yes], such as scripts/infra-apply sto2/plumbing;
# --yes may come before the stack too. A plan for sto2/edge that replaces both edge routers is
# refused: scripts/edge-rollout replaces them one at a time. One that replaces or deletes one edge
# is refused while the other does not pass scripts/edge-check.
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/infra.sh
. "$here/lib/infra.sh"
# shellcheck source=scripts/infra-talman
. "$here/infra-talman"
# shellcheck source=scripts/lib/edge.sh
. "$here/lib/edge.sh"

named='' confirmed=0
for arg; do
  case $arg in
    --yes) confirmed=1 ;;
    *)
      if [[ $arg == -* || -n $named ]]; then
        infra_error "usage: infra-apply <region>/<stack> [--yes]"
        exit 2
      fi
      named=$arg
      ;;
  esac
done
if [[ -z $named ]]; then
  infra_error "usage: infra-apply <region>/<stack> [--yes]"
  exit 2
fi

# shellcheck source=scripts/stack-env
. "$here/stack-env" "$named"
lock_stack
init_stack
echo "$stack:"
plan_stack
# One plan replacing both edge routers would leave none serving; edge-rollout does it one at a time.
# One that takes one edge down is applied only while the other serves.
edge_replaced_numbers=() edge_created_numbers=() forgotten=()
if [[ $stack == */edge ]]; then
  edge_refuse_double_replace
  edge_require_other_serves
  mapfile -t edge_created_numbers < <(edge_created)
fi
((confirmed)) || confirm "$stack" apply applied
# An edge's new instance, a replacement or one created again, has new SSH host keys at the address
# the old one had, so the recorded ones go before the apply; edge-check records the new ones,
# showing their fingerprints. A stack applied for the first time has none recorded.
if ((${#edge_created_numbers[@]} > 0)) && edge_applied; then
  edge_load
  edge_forget_keys "${edge_created_numbers[@]}"
  forgotten=("${edge_created_numbers[@]}")
fi
apply_plan
echo "$stack applied"
for number in "${forgotten[@]}"; do
  echo "edge $number's SSH host keys are no longer recorded; just edge-check --edge $number shows the new ones and records them once yes is typed"
done
# The apply can change the nodes and their addresses, so talman.yaml is written again from the
# state it left, under this run's lock.
if [[ $stack == */cluster ]]; then
  write_talman
fi
