#!/usr/bin/env bash
# Rolls a change out to the edge routers one edge at a time. Both edges render from one template,
# and a change to the rendered user data replaces an instance, so one plan would replace both at
# once, which scripts/infra-apply refuses. A newer image replaces nothing by itself, as the vm
# module ignores a change to an instance's boot device: --replace replaces each edge's instance
# anyway, and with it its boot volume, which Nova makes again from the image EDGE_IMAGE names. The
# edge's port stays, and with it its address and floating IP.
#
# Plans the stack and prints the summary; once the stack's name is typed back (--yes: without
# asking), replaces edge 1, waits until scripts/edge-check passes for it, and only then replaces
# edge 2. Before it replaces an edge it checks that the other one passes, so an edge is never
# replaced while the other is not serving. A replaced edge has SSH host keys of its own at the same
# address, so the recorded keys are dropped before it is replaced, and the new ones are recorded
# before its check runs: without a prompt when every key the address offers is one its instance
# printed on its console, which is read through the OpenStack client within the wait below, by
# the identifier the stack's outputs give once the edge is applied; outputs that still give the
# replaced instance's stop the rollout; a key the console does not hold stops it at once, nothing
# recorded, --yes or not; and when the console holds no fingerprints by the end of the wait the
# fingerprints are shown and yes typed, and keys that are not accepted stop the rollout at once.
# The waits are timed with date +%s. A check that does not pass within
# EDGE_ROLLOUT_WAIT seconds (900 when unset), tried every EDGE_ROLLOUT_INTERVAL seconds (15), stops
# the rollout there: an edge after it is not touched. The last step plans the whole stack again and
# prints what is left, which only scripts/infra-apply applies: each edge's plan holds that edge's
# own resources alone.
#
# --edge N replaces edge N alone, after the same check of the other edge. With --other-down it goes
# on when the other edge does not pass either, once a sentence that names both edges is typed back,
# --yes or not: with both edges down nothing serves anyway, and replacing one is the way back.
#
# What is typed, the stack's name, that sentence and yes for a host key, is read one line at a
# time, in the order it is asked, from the script's standard input: a terminal, or a pipe or a file
# written before it started. No program the script starts has that input as its standard input
# (reserve_answers in scripts/lib/infra.sh), so the ssh of a check reads nothing of an answer that
# waits for a later prompt. The two exceptions are stated where they are made: dirname, below, and
# the edge-check of edge_check_passes in scripts/lib/edge.sh, which asks for yes itself.
# Usage: scripts/edge-rollout [--replace] [--edge 1|2 [--other-down]] [--yes]
set -euo pipefail

# reserve_answers comes with the libraries, so until they are sourced dirname, here and where the
# libraries find each other, runs with the script's own standard input, of which it reads nothing.
here=$(dirname "$0")
# shellcheck source=scripts/lib/edge.sh
. "$here/lib/edge.sh"
reserve_answers

usage() {
  infra_error "usage: edge-rollout [--replace] [--edge 1|2 [--other-down]] [--yes]"
  exit 2
}

confirmed=0 forced=0 only='' other_down=0
while (($#)); do
  case $1 in
    --yes) confirmed=1 ;;
    --replace) forced=1 ;;
    --other-down) other_down=1 ;;
    --edge)
      [[ ${2-} == 1 || ${2-} == 2 ]] || usage
      only=$2
      shift
      ;;
    *) usage ;;
  esac
  shift
done
# Going on with the other edge down is for one named edge only.
if ((other_down)) && [[ -z $only ]]; then
  usage
fi
numbers=(1 2)
if [[ -n $only ]]; then
  numbers=("$only")
fi

# shellcheck source=scripts/stack-env
. "$here/stack-env" sto2/edge
# The waits may be in .env, which stack-env has read now, and are refused before the stack is
# locked or touched.
wait_seconds=${EDGE_ROLLOUT_WAIT:-900} interval=${EDGE_ROLLOUT_INTERVAL:-15}
# Read in base 10, as arithmetic would read a leading zero as octal and 08 as an error, and of at
# most 9 digits, which arithmetic holds without overflow.
if [[ ! $wait_seconds =~ ^[0-9]{1,9}$ ]]; then
  infra_error "EDGE_ROLLOUT_WAIT is not a whole number of seconds of at most 9 digits"
  exit 1
fi
if [[ ! $interval =~ ^[0-9]{1,9}$ ]]; then
  infra_error "EDGE_ROLLOUT_INTERVAL is not a whole number of seconds of at most 9 digits"
  exit 1
fi
wait_seconds=$((10#$wait_seconds)) interval=$((10#$interval))
# The edge-check runs below read it.
host_console_wait || exit 1
lock_stack
export EDGE_STACK_LOCKED=$infra_lock_fd
init_stack
edge_load
echo "$stack:"
plan_stack
if ((forced)); then
  echo "and, with --replace, the instance and boot volume of edge ${numbers[*]}, one edge at a time; ports stay"
fi
((confirmed)) || confirm "$stack" "roll out" "rolled out"

# check NUMBER: scripts/edge-check for edge NUMBER, under this run's lock.
check() {
  edge_check_passes "$1"
}

# other_down_typed NUMBER OTHER: whether the operator, told that OTHER does not serve either, types
# the sentence that names both edges, --yes or not: replacing NUMBER then leaves no edge serving
# until it passes its check. The sentence is one line of the operator's input, as confirm's answer
# is (scripts/lib/infra.sh).
other_down_typed() {
  local expected="replace edge $1 with edge $2 down" answer=
  printf 'Edge %s does not serve either, so no edge serves until edge %s passes its check. Type "%s" to replace it anyway: ' "$2" "$1" "$expected" >&2
  read -r -u "${answers_fd:-0}" answer || true
  [[ $answer == "$expected" ]]
}

# records_new_keys NUMBER: records the host keys edge NUMBER offers, which ssh_host_trust compares
# with the console of the edge's instance, by the identifier edge_load read after the apply, and,
# when that holds no fingerprints, shows and records once yes is typed. It tries again while the
# new instance does not answer until the wait is over, and reads the console within what is left
# of the same wait. Returns ssh_host_trust's status: 2, keys that were not accepted, and 3, a key
# the instance did not print, stop the rollout at once. The waits here are timed with host_clock.
records_new_keys() {
  local now deadline status
  now=$(host_clock) || now=0
  deadline=$((now + wait_seconds))
  while :; do
    status=0
    ssh_host_trust "${edge_addresses[$1 - 1]}" "$edge_known_hosts" "edge router ${edge_names[$1 - 1]}" \
      "${edge_instances[$1 - 1]}" "$((deadline > now ? deadline - now : 0))" "$interval" || status=$?
    # Recorded, declined or refused.
    if ((status != 1)); then
      return "$status"
    fi
    now=$(host_clock) || return 1
    ((now < deadline)) || return 1
    sleep "$interval"
    now=$(host_clock) || return 1
  done
}

# passes NUMBER: whether edge-check passes for edge NUMBER, tried until the wait is over.
passes() {
  local now deadline
  now=$(host_clock) || now=0
  deadline=$((now + wait_seconds))
  while :; do
    if check "$1"; then
      return 0
    fi
    now=$(host_clock) || return 1
    ((now < deadline)) || return 1
    sleep "$interval"
  done
}

# Each edge with its floating IP association, as the instance's replacement leaves the port and the
# address in place; what the edge depends on, the shared group and key pair, comes with it. With
# --replace, the edge's instance is replaced whatever the plan says: its boot volume, which Nova
# makes from the image and deletes with the instance, goes with it, and its port, which holds the
# fixed address and the floating IP's association, is kept, so the new instance boots on the same
# port, at the same addresses.
replaced_numbers=()
for number in "${numbers[@]}"; do
  other=$((3 - number))
  echo "edge $number: checking that edge $other serves before it is replaced"
  if ! check "$other"; then
    if ((!other_down)); then
      infra_error "edge $other does not pass its check, so edge $number is not replaced; to replace edge $number while edge $other is down, run: just edge-rollout --replace --edge $number --other-down"
      exit 1
    fi
    if ! other_down_typed "$number" "$other"; then
      infra_error "edge $number is not replaced while edge $other is down, as that was not typed back"
      exit 1
    fi
  fi
  echo "edge $number: replacing"
  replace=()
  if ((forced)); then
    replace=("-replace=module.edge[\"$number\"].openstack_compute_instance_v2.this")
  fi
  stack_tofu plan -input=false -out="$plan_file" "-target=module.edge[\"$number\"]" \
    "-target=openstack_networking_floatingip_associate_v2.edge[\"$number\"]" "${replace[@]}" > /dev/null
  stack_tofu show -json "$plan_file" | plan_summary
  # Only an instance the plan creates, replacing the old one or not, has new host keys; an edge the
  # plan changes in place keeps the recorded ones, which are never dropped and asked for again
  # without cause.
  created=$(edge_created)
  if [[ $'\n'$created$'\n' == *$'\n'$number$'\n'* ]]; then
    edge_forget_keys "$number"
    before=${edge_instances[number - 1]}
    apply_plan
    replaced_numbers+=("$number")
    echo "edge $number: applied; its SSH host keys are new"
    # The apply made a new server, with a new identifier, and deleted the one before it: its
    # console is read by the identifier the outputs give now. The same identifier as before the
    # apply means the outputs do not describe what the apply made, and that console is not the
    # new instance's word.
    edge_load
    if [[ -n $before && ${edge_instances[number - 1]} == "$before" ]]; then
      infra_error "edge $number's instance was created again, but the stack's outputs still give the identifier of the one before it, so they are stale and its console is not read; nothing was recorded, the rollout stops here and no later edge was touched; when just infra-plan sto2/edge lists update: output instances and no other change, just infra-apply sto2/edge writes the outputs (a pending change to the other edge lists update: output instances as well); once just infra-plan sto2/edge lists no change to output instances, so the outputs name the new instance, just edge-check --edge $number records its keys"
      exit 1
    fi
    status=0
    records_new_keys "$number" || status=$?
    if ((status == 3)); then
      infra_error "edge $number's address offers an SSH host key its instance did not print; the rollout stops here and no later edge was touched"
      exit 1
    elif ((status != 0)); then
      infra_error "edge $number's new SSH host key was not recorded within ${wait_seconds}s or was not accepted; the rollout stops here and no later edge was touched"
      exit 1
    fi
  else
    apply_plan
    echo "edge $number: applied; its instance was not replaced, so its SSH host keys stay"
  fi
  echo "edge $number: waiting for its check to pass"
  if ! passes "$number"; then
    infra_error "edge $number does not pass its check within ${wait_seconds}s; the rollout stops here and no later edge was touched"
    exit 1
  fi
done

if ((${#replaced_numbers[@]} == 0)); then
  echo "$stack: no edge was replaced, and edge ${numbers[*]} passes; what is left of the plan:"
else
  echo "$stack: edge ${replaced_numbers[*]} replaced, and edge ${numbers[*]} passes; what is left of the plan:"
fi
plan_stack
echo "what is left is not applied: the rollout applies each edge's own part alone; just infra-apply sto2/edge applies the rest"
