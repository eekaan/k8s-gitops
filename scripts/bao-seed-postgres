#!/usr/bin/env bash
# Seeds the key postgres-backups of OpenBao's key-value mount (secrets/postgres-backups), which every
# PostgreSQL cluster's ExternalSecret from components/cnpg-cluster reads (ADR 0008): the customer key
# of SSE-C, 32 random bytes of the kernel as base64, with which the object storage encrypts every
# base backup and WAL file of the cluster's databases. The provider does not store it and cannot read
# an object without it, so a key that is lost loses every backup and archive, and one key serves all
# databases: the recipe stays one small file, and a database's backups stay apart by their path, not
# by their key. It cannot be replaced in place: objects written under one key are unreadable under
# another, so a new key goes with a new destination path (docs/runbooks/postgres-restore.md).
# It keeps the key outside the cluster before the cluster holds it: in FILE, outside the repository,
# encrypted with age to the Talos age key's recipient in talos/.sops.yaml, written, opened again with
# the operator's Talos age key to what was written, and never put over a file that exists, as
# bao-seed-volsync orders its custody file. Only then does it create the key, and only if no key
# exists: nothing here replaces one. The operator role may create and patch keys and never read or
# update them, so the recipe asks before it makes anything: an empty patch with check-and-set 0 of
# the key is answered 404 where there is no key, and refused for its check-and-set where there is
# one, and writes nothing either way. OpenBao answers a write to a key that exists with permission
# denied, which is why the key is created only after that answer.
# An existing FILE is read only where no one but this user can have written it (bao_custody_trusted
# in scripts/lib/openbao.sh): age authenticates no writer, so the place vouches for the file, and a
# new one goes only where it would be read.
# A run that fails after FILE is written and before OpenBao holds the key says so, and the next run
# with the same FILE reads the key back from it, makes no other, and goes on. So does any run given
# an existing FILE while OpenBao holds no key, as on a rebuilt cluster, whose store is new: the key
# FILE holds is the one the archive was written with. A run that finds the key already there changes
# nothing and makes no file; a file that was there is kept.
# Nothing of the key is printed, passed as an argument or written unencrypted: it stays in memory
# and on pipes between jq, age and curl. Works through the session of scripts/lib/openbao.sh as the
# operator role.
# Usage: scripts/bao-seed-postgres <file> [cluster]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/openbao.sh
. "$here/lib/openbao.sh"

# The key the component's ExternalSecret reads, and the property that holds the customer key.
postgres_key=postgres-backups

usage() {
  echo "bao-seed-postgres: give the file to write, outside the repository: just bao-seed-postgres <file> [cluster]. For a store that held the key before, as on a rebuilt cluster, <file> is the existing custody file, never a new one" >&2
  exit 1
}

(($# >= 1 && $# <= 2)) || usage
# Nothing that reads as an option is a file.
[[ $1 != -* ]] || usage
file=$1
shift

# shellcheck source=scripts/cluster-env
. "$here/cluster-env" "${1-}"
complete=1
require_commands kubectl curl jq mktemp age base64 head tr sha256sum date stat || complete=0
require_kubeconfig || complete=0
# The Talos age key's recipient and the operator's key, which FILE must open with before OpenBao
# holds the key.
require_age_key || complete=0
recipient=$(sops_recipient)
if is_placeholder "$recipient" || [[ ! $recipient =~ ^age1[0-9a-z]+$ ]]; then
  infra_error "talos/.sops.yaml holds no age recipient yet; just cluster-age-key writes it"
  complete=0
fi
# The key of a run that goes on from FILE, and whether this run goes on from it.
sse_key="" resume=0 dir=""
dir=$(dirname -- "$file")
if inside_repository "$file"; then
  infra_error "$file lies inside the repository; the customer key is kept outside it"
  complete=0
elif [[ -L $file ]] || [[ -e $file && ! -f $file ]]; then
  infra_error "$file is not a file"
  complete=0
elif [[ -f $file ]]; then
  # An earlier run wrote it: this run goes on from it, if it is where only this user can have
  # written it, and this recipe's, for this cluster.
  if ! bao_custody_trusted "$file"; then
    complete=0
  elif ((complete)) && custody=$(bao_decrypt "$file" 2> /dev/null) &&
    printf '%s' "$custody" | jq -e --arg cluster "$cluster" \
      '.cluster == $cluster and (.postgres.sse_c_key // "" | test("^[A-Za-z0-9+/]{43}=$"))' > /dev/null; then
    sse_key=$(printf '%s' "$custody" | jq -r '.postgres.sse_c_key')
    resume=1
  else
    infra_error "$file exists and is no custody file of the PostgreSQL backup key for $cluster that the Talos age key opens; it is never replaced"
    complete=0
  fi
  custody=
elif [[ ! -d $dir || ! -w $dir ]]; then
  infra_error "$dir is not a directory this user can write to"
  complete=0
elif ! bao_custody_place "$file"; then
  # A later run reads the file only from such a place.
  complete=0
fi
((complete))

# have_file is 1 once FILE holds the key, made by this run or read from FILE; stored is 1 once
# OpenBao holds the key; holds is 1 when OpenBao already holds one. partial is the file being
# written.
have_file=$resume stored=0 holds=0 partial=""

# bao_abort: removes a partial file, and on a failure after FILE holds the key and before OpenBao
# holds it says which state that left and how the next run goes on. A run that found the key already
# there has changed nothing and made no file, and keeps one that was there.
bao_abort() {
  if [[ -n $partial ]]; then
    # Stopped right after the link: FILE is the partial file under its own name, and holds the key.
    [[ ! $partial -ef $file ]] || have_file=1
    rm -f -- "$partial"
  fi
  if ((holds)); then
    if ((have_file)); then
      infra_error "OpenBao already holds the key $postgres_key; nothing in it changed, and $file is kept, as it may hold that key"
    else
      infra_error "OpenBao already holds the key $postgres_key; nothing was made and nothing in it changed"
    fi
    return 0
  fi
  ((have_file && !stored)) || return 0
  infra_error "OpenBao may not hold the key $postgres_key yet, and $file holds its customer key; run this again with the same file: it goes on from the file, with the same key, and says so if OpenBao holds the key by then"
}

bao_open
bao_login

# Whether the key exists, before a key is made: the patch is answered 404 where there is none.
step="asking whether OpenBao holds the key $postgres_key"
probed=0
printf '%s' '{"data":{},"options":{"cas":0}}' |
  bao_request PATCH "$bao_mount/data/$postgres_key" application/merge-patch+json > /dev/null 2> "$work_dir/refusal" || probed=$?
if ((probed == 0)); then
  infra_error "OpenBao took an empty patch with check-and-set 0 of the key $postgres_key; it was not meant to"
  exit 1
elif ((probed != 44)); then
  if grep -q 'check-and-set' "$work_dir/refusal"; then
    holds=1
  else
    cat "$work_dir/refusal" >&2
  fi
  exit 1
fi

if ((!resume)); then
  step="generating the customer key"
  sse_key=$(head -c 32 /dev/urandom | base64 | tr -d '\n')
  if [[ ! $sse_key =~ ^[A-Za-z0-9+/]{43}=$ ]]; then
    infra_error "the kernel gave no 32 random bytes"
    exit 1
  fi
  step="writing $file"
  custody=$(printf '%s' "$sse_key" | jq -Rsc --arg cluster "$cluster" --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{cluster: $cluster, created: $created, postgres: {sse_c_key: .}}')
  partial=$(mktemp "$dir/.${file##*/}.XXXXXXXXXX")
  printf '%s' "$custody" | age --encrypt --recipient "$recipient" --output "$partial"
  # The file opens with the operator's age key, to what was written, or nothing is written to
  # OpenBao: a recipient in talos/.sops.yaml that is not the operator's key would make a key nobody
  # can read.
  step="opening $file with the Talos age key"
  if [[ $(bao_decrypt "$partial" | sha256sum) != "$(printf '%s' "$custody" | sha256sum)" ]]; then
    infra_error "$file does not open with the Talos age key to what was written; check the recipient in talos/.sops.yaml"
    exit 1
  fi
  custody=
  step="putting $file in place"
  bao_place "$partial" "$file" "nothing is written to OpenBao" || exit 1
  have_file=1
  rm -- "$partial"
  partial=""
fi

step="creating the key $postgres_key"
body=$(printf '%s' "$sse_key" | jq -Rsc '{data: {SSE_C_KEY: .}, options: {cas: 0}}')
sse_key=
# Only while there is nothing at the key, as the patch above found: with a key made since, OpenBao
# refuses this write, and the next run finds the key.
written=0
printf '%s' "$body" | bao_request POST "$bao_mount/data/$postgres_key" > /dev/null || written=$?
body=
((written == 0)) || exit 1
stored=1

if ((resume)); then
  echo "bao-seed-postgres: wrote the key $postgres_key of $bao_mount with the customer key in $file, which an earlier run wrote"
else
  echo "bao-seed-postgres: wrote the key $postgres_key of $bao_mount with a new customer key; it is also in $file, encrypted to the Talos age key's recipient $recipient"
  echo "bao-seed-postgres: if a store of this cluster held the key before, as before a rebuild, its backups open only with the key in the custody file written then: docs/runbooks/postgres-restore.md says how to seed the store again from that file"
fi
echo "bao-seed-postgres: keep $file outside the cluster; it holds the only copy of the customer key that outlives it, and without it every PostgreSQL backup is unreadable (docs/runbooks/postgres-restore.md)"
