#!/usr/bin/env bash
# Says whether a cluster is healthy, reading only, through its kubeconfig, which points at the API
# load balancer. Prints pass, FAIL or skip for each check, with one line of why, and exits 0 only
# when none fails:
#   /readyz               the API answers /readyz;
#   nodes Ready           every node is Ready; a FAIL names those that are not;
#   node count            there are as many nodes as the cluster's talman.yaml lists; a FAIL names
#                         those it lists that are missing and those there that it does not list;
#   workers in BGP        no Ready worker carries the label that takes it out of BGP
#                         (bgp_out_label in scripts/lib/cluster.sh), which the recipes that drain or
#                         reboot a worker set and remove; a FAIL names the workers and the command
#                         that puts each back, as a worker left out silently is capacity lost;
#   no kube-proxy         no kube-proxy pod runs in any namespace, as Cilium takes its place;
#   pods in kube-system   every pod there is Running or Succeeded; a FAIL names the others;
#   pods in flux-system   the same, skipped, saying so, while the namespace does not exist, as before
#                         Flux is installed;
#   certificate requests  no certificate signing request is Pending, neither approved nor denied;
#   pod logs              kubectl fetches the last log line of a Running pod in kube-system, which the
#                         API server reads from the pod's kubelet, over the kubelet's serving
#                         certificate;
#   scrape targets        no target of the jobs that scrape the cluster's own components (the API
#                         server, controller manager, scheduler, etcd, kubelets and node-exporter,
#                         named in scripts/lib/cluster.sh) is down in Prometheus, asked through the
#                         API server's service proxy; a FAIL names each job and the nodes it is down
#                         on. Skipped, saying why, while the monitoring stack's Service does not
#                         exist and when Prometheus does not answer: its silence is not a pass;
#   encryption            while the ConfigMap cilium-config in kube-system turns WireGuard on
#                         (enable-wireguard "true"), the Running Cilium agent on every node the API
#                         lists reports, asked with cilium-dbg encrypt status, the mode Wireguard, no
#                         message, which is where the agent's and the kernel's states of the device
#                         disagreeing show, the one device cilium_wg0, and as many peers as there
#                         are other nodes, counted, not matched to them; an answer that is not one
#                         JSON object is no answer. A FAIL names each node and why. Skipped, saying
#                         so, while cilium-config does not turn WireGuard on; one that cannot be
#                         read fails it.
# It runs kubectl get and kubectl logs, and, while cilium-config turns WireGuard on, one kubectl exec
# in each Cilium agent's container cilium-agent, of cilium-dbg encrypt status --output json, stopped
# after 20 seconds, so the kubeconfig then needs exec on the agents' pods in kube-system, more than a
# reading recipe otherwise needs. It prints node and object names, never an address, a log line, a
# public key or kubectl's own errors, which can name the API server's or a node's address.
# Usage: scripts/cluster-check [cluster]
set -euo pipefail

here=$(dirname "$0")
# shellcheck source=scripts/lib/cluster.sh
. "$here/lib/cluster.sh"

if (($# > 1)) || [[ ${1-} == -* ]]; then
  infra_error "usage: cluster-check [cluster]"
  exit 2
fi

# shellcheck source=scripts/cluster-env
. "$here/cluster-env" "${1-}"
complete=1
require_cluster talman || complete=0
require_kubeconfig || complete=0
require_commands kubectl jq yq || complete=0
((complete))

step="reading talman.yaml"
hostnames=$(talman_nodes "$talman_file" | cut -d' ' -f1)
mapfile -t listed <<< "$hostnames"

failures=0 checks=0 skipped=()
# result VERDICT CHECK WHY: one check's result, pass, FAIL or skip, with its name and why.
result() {
  printf '%-4s  %s: %s\n' "$1" "$2" "$3"
  checks=$((checks + 1))
  case $1 in
    FAIL) failures=$((failures + 1)) ;;
    skip) skipped+=("$2") ;;
  esac
}

# get ARG...: kubectl get ARG... as JSON. Its errors are left out, as they can name the API server's
# address.
get() {
  kubectl get "$@" --output json --request-timeout=10s 2> /dev/null
}

# joined: the lines on standard input, joined with commas.
joined() {
  paste -sd, - | sed 's/,/, /g'
}

step="checking the cluster"
if kubectl get --raw /readyz --request-timeout=10s > /dev/null 2>&1; then
  result pass /readyz "the API answers through the kubeconfig"
else
  result FAIL /readyz "no answer through the kubeconfig"
fi

if nodes=$(get nodes); then
  count=$(jq '.items | length' <<< "$nodes")
  not_ready=$(jq -r '.items[] | select(any(.status.conditions[]?; .type == "Ready" and .status == "True") | not)
    | .metadata.name' <<< "$nodes" | joined)
  if [[ -z $not_ready ]]; then
    result pass "nodes Ready" "$count nodes, every one Ready"
  else
    result FAIL "nodes Ready" "not Ready: $not_ready"
  fi
  missing=$(jq -r '[.items[].metadata.name] as $there | $ARGS.positional[] | select(IN($there[]) | not)' \
    --args "${listed[@]}" <<< "$nodes" | joined)
  unlisted=$(jq -r '.items[].metadata.name | select(IN($ARGS.positional[]) | not)' \
    --args "${listed[@]}" <<< "$nodes" | joined)
  if [[ -z $missing && -z $unlisted && $count == "${#listed[@]}" ]]; then
    result pass "node count" "$count nodes, as talos/$cluster/talman.yaml lists"
  else
    why="$count nodes, and talos/$cluster/talman.yaml lists ${#listed[@]}"
    [[ -z $missing ]] || why+="; not in the cluster: $missing"
    [[ -z $unlisted ]] || why+="; not in talman.yaml: $unlisted"
    result FAIL "node count" "$why"
  fi
  # A worker left out of BGP announces nothing, so its share of the traffic goes to the others: capacity
  # lost without a sign unless it is looked for. A worker that is not Ready is down for another reason,
  # which the check above names.
  out=$(jq -r --arg key "$bgp_out_label" '.items[]
    | select((.metadata.labels // {}) | has("node-role.kubernetes.io/control-plane") | not)
    | select((.metadata.labels // {}) | has($key))
    | select(any(.status.conditions[]?; .type == "Ready" and .status == "True"))
    | .metadata.name' <<< "$nodes")
  if [[ -z $out ]]; then
    result pass "workers in BGP" "no Ready worker carries the label that takes it out of BGP"
  else
    why="out of BGP: $(joined <<< "$out"); put back with"
    while read -r node; do
      why+=" kubectl label node $node $bgp_out_label-;"
    done <<< "$out"
    result FAIL "workers in BGP" "${why%;}"
  fi
else
  result FAIL "nodes Ready" "kubectl could not read the nodes"
  result FAIL "node count" "kubectl could not read the nodes"
  result FAIL "workers in BGP" "kubectl could not read the nodes"
fi

# pods_not_running NAMESPACE: each pod in NAMESPACE that is neither Running nor Succeeded, as
# namespace/name and its phase.
pods_not_running() {
  jq -r --arg namespace "$1" '.items[] | select(.metadata.namespace == $namespace)
    | select(.status.phase != "Running" and .status.phase != "Succeeded")
    | "\(.metadata.namespace)/\(.metadata.name) (\(.status.phase // "no phase"))"' <<< "$pods" | joined
}

# pods_in NAMESPACE: the check of the pods in NAMESPACE.
pods_in() {
  local others count
  others=$(pods_not_running "$1")
  count=$(jq --arg namespace "$1" '[.items[] | select(.metadata.namespace == $namespace)] | length' <<< "$pods")
  if [[ -z $others ]]; then
    result pass "pods in $1" "every one Running or Succeeded, $count in all"
  else
    result FAIL "pods in $1" "not Running or Succeeded: $others"
  fi
}

flux=''
flux_read=1
flux=$(kubectl get namespace flux-system --ignore-not-found --output name --request-timeout=10s 2> /dev/null) || flux_read=0
if pods=$(get pods --all-namespaces); then
  proxies=$(jq -r '.items[] | select((.metadata.name | startswith("kube-proxy"))
      or .metadata.labels["k8s-app"] == "kube-proxy")
    | "\(.metadata.namespace)/\(.metadata.name)"' <<< "$pods" | joined)
  if [[ -z $proxies ]]; then
    result pass "no kube-proxy" "no kube-proxy pod runs"
  else
    result FAIL "no kube-proxy" "kube-proxy runs: $proxies"
  fi
  pods_in kube-system
  if ((!flux_read)); then
    result FAIL "pods in flux-system" "kubectl could not read the namespace flux-system"
  elif [[ -z $flux ]]; then
    result skip "pods in flux-system" "the namespace flux-system does not exist, as before what Flux needs is applied"
  else
    pods_in flux-system
  fi
else
  for check in "no kube-proxy" "pods in kube-system" "pods in flux-system"; do
    result FAIL "$check" "kubectl could not read the pods"
  done
fi

if requests=$(get certificatesigningrequests); then
  pending=$(jq -r '.items[] | select([.status.conditions[]?.type] | any(. == "Approved" or . == "Denied" or . == "Failed") | not)
    | .metadata.name' <<< "$requests" | joined)
  if [[ -z $pending ]]; then
    result pass "certificate requests" "none is Pending"
  else
    result FAIL "certificate requests" "Pending: $pending"
  fi
else
  result FAIL "certificate requests" "kubectl could not read the certificate signing requests"
fi

if [[ -z ${pods-} ]]; then
  result FAIL "pod logs" "kubectl could not read the pods"
else
  pod=$(jq -r 'first(.items | sort_by(.metadata.name)[] | select(.metadata.namespace == "kube-system"
    and .status.phase == "Running") | .metadata.name) // ""' <<< "$pods")
  if [[ -z $pod ]]; then
    result FAIL "pod logs" "no pod in kube-system is Running to fetch logs from"
  elif kubectl logs --namespace kube-system "$pod" --all-containers --tail=1 --request-timeout=10s > /dev/null 2>&1; then
    result pass "pod logs" "fetched the logs of kube-system/$pod"
  else
    result FAIL "pod logs" "kubectl could not fetch the logs of kube-system/$pod; the kubelet's serving certificate may not be approved"
  fi
fi

# scrape_targets_down: the targets of the cluster's own components that Prometheus reports down, from
# the answer in targets, one per line as the job and, where the target names one, the node it runs
# on: the node's name, never the address of the target.
scrape_targets_down() {
  jq -r --args '[.data.activeTargets[] | select(.labels.job | IN($ARGS.positional[])) | select(.health == "down")
      | {job: .labels.job, node: (.discoveredLabels["__meta_kubernetes_endpoint_node_name"]
        // .discoveredLabels["__meta_kubernetes_pod_node_name"] // .labels.node // "")}]
    | group_by(.job)[] | .[0].job + (map(.node | select(. != "")) | unique | if length > 0 then " on " + join(", ") else "" end)' \
    "${scrape_jobs[@]}" <<< "$targets"
}

# scrape_targets_unscraped: the component jobs, one per line, that no active target in targets
# belongs to. Prometheus that has just started, or a monitor that selects nothing, answers
# successfully without them, and a job nothing scrapes is not a job whose targets are up.
scrape_targets_unscraped() {
  jq -r --args '[.data.activeTargets[].labels.job] as $seen | $ARGS.positional[] | select(IN($seen[]) | not)' \
    "${scrape_jobs[@]}" <<< "$targets"
}

# scrape_targets_seen: how many active targets belong to the component jobs.
scrape_targets_seen() {
  jq -r --args '[.data.activeTargets[] | select(.labels.job | IN($ARGS.positional[]))] | length' \
    "${scrape_jobs[@]}" <<< "$targets"
}

# Prometheus is asked through the API server's service proxy, as nothing reaches it from outside the
# cluster. The answer is read into a variable whole, so that no reader of kubectl's output ends the
# pipe early.
targets_path=/api/v1/namespaces/$prometheus_namespace/services/$prometheus_service:$prometheus_port/proxy/api/v1/targets
if ! service=$(kubectl get service "$prometheus_service" --namespace "$prometheus_namespace" --ignore-not-found \
  --output name --request-timeout=10s 2> /dev/null); then
  result skip "scrape targets" "kubectl could not look for Prometheus's Service, so it was not asked"
elif [[ -z $service ]]; then
  result skip "scrape targets" "the monitoring stack is not installed: no Service $prometheus_service in $prometheus_namespace"
elif ! targets=$(kubectl get --raw "$targets_path?state=active" --request-timeout=20s 2> /dev/null) ||
  ! jq -e '.status == "success" and (.data.activeTargets | type == "array")' <<< "$targets" > /dev/null 2>&1; then
  result skip "scrape targets" "Prometheus did not answer through the API server's service proxy with its targets"
elif ! down=$(scrape_targets_down); then
  result skip "scrape targets" "Prometheus did not answer with targets this check could read"
elif [[ -n $down ]]; then
  result FAIL "scrape targets" "down: $(paste -sd';' - <<< "$down" | sed 's/;/; /g')"
elif ! unscraped=$(scrape_targets_unscraped) || ! target_count=$(scrape_targets_seen); then
  result skip "scrape targets" "Prometheus did not answer with targets this check could read"
elif [[ -n $unscraped ]]; then
  result skip "scrape targets" "Prometheus has no active target for $(joined <<< "$unscraped"), so nothing says whether they are up"
else
  result pass "scrape targets" "none of the $target_count targets of the ${#scrape_jobs[@]} component jobs is down"
fi

# encryption_verdict PEERS: why the answer of cilium-dbg encrypt status --output json on standard
# input is not that of an agent that encrypts with WireGuard through cilium_wg0 with PEERS peers, in
# a word or two, or nothing when it is. An answer that is not exactly one JSON object, an empty
# answer among them, is no answer, and one that is not JSON at all fails. Of the answer it prints
# the mode, when that is a word, and the number of peers alone: the answer also holds the device's
# public key, and its message names keys. The pinned cilium-dbg leaves the peer count out when it
# is 0.
encryption_verdict() {
  jq -rs --argjson peers "$1" 'if length != 1 then "no answer" else .[0] |
    if type != "object" then "no answer"
    elif .mode != "Wireguard" then
      if (.mode | type) == "string" and (.mode | test("^[A-Za-z]{1,20}$")) then "mode \(.mode)" else "no mode" end
    elif (.msg // "") != "" then "agent and kernel disagree"
    elif [.wireguard.interfaces[]?.name] != ["cilium_wg0"] then "no single device cilium_wg0"
    elif (.wireguard.interfaces[0]["peer-count"] // 0 | type) != "number" then "no answer"
    elif (.wireguard.interfaces[0]["peer-count"] // 0) != $peers then "\(.wireguard.interfaces[0]["peer-count"] // 0) of \($peers) peers"
    else "" end end'
}

# stop_encryption_calls STATUS: the agent's call and its timer stopped, when they still run, and the
# answers removed, however the script ends; it takes the place of report_failed_step's EXIT trap, so
# a run that ends with STATUS other than 0 still names the step it failed in.
# shellcheck disable=SC2329 # It runs from the EXIT trap.
stop_encryption_calls() {
  local pid
  for pid in ${call:+"$call"} ${timer:+"$timer"}; do
    kill "$pid" 2> /dev/null || true
  done
  rm -rf -- "$answers"
  failed_step "$1"
}

# Each agent is asked by its own cilium-dbg through kubectl exec, as scripts/network-drops asks its
# hubble, and each call is stopped after encryption_bound seconds: kubectl is the process whose id
# call holds, and whichever of it and the timer ends first, the other is stopped.
encryption_bound=20
if ! config=$(get configmap cilium-config --namespace kube-system); then
  result FAIL encryption "kubectl could not read the ConfigMap cilium-config in kube-system"
elif [[ $(jq -r '.data["enable-wireguard"] // ""' <<< "$config") != true ]]; then
  result skip encryption 'cilium-config does not turn WireGuard on, as its enable-wireguard is not "true", so no agent was asked'
elif [[ -z ${nodes-} ]]; then
  result FAIL encryption "kubectl could not read the nodes"
elif [[ -z ${pods-} ]]; then
  result FAIL encryption "kubectl could not read the pods"
elif ! count=$(jq '.items | length' <<< "$nodes") || ((count == 0)); then
  result FAIL encryption "the API lists no node"
else
  peer_count=$((count - 1))
  failing=()
  answers=$(mktemp -d)
  call='' timer=''
  trap 'stop_encryption_calls $?' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  while IFS= read -r node; do
    agent=$(jq -r --arg node "$node" 'first(.items[] | select(.metadata.namespace == "kube-system"
      and .metadata.labels["k8s-app"] == "cilium" and .spec.nodeName == $node and .status.phase == "Running")
      | .metadata.name) // ""' <<< "$pods")
    # A name read from the cluster reaches kubectl only once it has the shape of a pod's.
    if [[ ! $agent =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]]; then
      failing+=("$node: no agent running")
      continue
    fi
    (exec_tool kubectl exec --namespace kube-system --container cilium-agent "$agent" -- \
      cilium-dbg encrypt status --output json) > "$answers/answer" 2> /dev/null &
    call=$!
    sleep "$encryption_bound" &
    timer=$!
    wait -n "$call" "$timer" || true
    kill "$call" "$timer" 2> /dev/null || true
    if wait "$call" && verdict=$(encryption_verdict "$peer_count" < "$answers/answer" 2> /dev/null); then
      [[ -z $verdict ]] || failing+=("$node: $verdict")
    else
      failing+=("$node: no answer")
    fi
    wait "$timer" 2> /dev/null || true
    call='' timer=''
  done < <(jq -r '.items[].metadata.name' <<< "$nodes")
  if ((${#failing[@]} == 0)); then
    result pass encryption "the agents of all $count nodes encrypt with WireGuard through cilium_wg0, each with a peer for each of the other $peer_count"
  else
    result FAIL encryption "$(printf '%s\n' "${failing[@]}" | paste -sd';' - | sed 's/;/; /g')"
  fi
fi

if ((failures > 0)); then
  infra_error "$failures of $checks checks failed"
  exit 1
fi
summary="every check of $cluster passes"
if ((${#skipped[@]} > 0)); then
  summary+="; skipped: $(printf '%s\n' "${skipped[@]}" | joined)"
fi
echo "cluster-check: $summary"
