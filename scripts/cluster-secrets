#!/usr/bin/env bash
# Generates a cluster's Talos secrets bundle, the certificate authorities and keys that are the
# cluster's identity, with talman, which encrypts it with sops by the rule in talos/.sops.yaml into
# talos/<cluster>/secrets.sops.yaml. Refuses when the bundle exists, as the cluster's nodes trust
# only the one they were configured with. Afterwards checks that the bundle is encrypted; when it is
# not, the run fails and the file is left in place, for the operator to remove without committing.
# Usage: scripts/cluster-secrets [cluster]
set -euo pipefail

# shellcheck source=scripts/cluster-env
. "$(dirname "$0")/cluster-env" "${1-}"
require_cluster talman recipient
if [[ -e $secrets_file ]]; then
  infra_error "talos/$cluster/secrets.sops.yaml exists; a new bundle would replace the certificate authorities and keys the cluster's nodes trust"
  exit 1
fi

step="generating the secrets bundle"
talman secrets generate

step="checking that the secrets bundle is encrypted"
if ! bundle_encrypted "$secrets_file"; then
  infra_error "talos/$cluster/secrets.sops.yaml is not encrypted; it is left in place: remove it, and do not commit it"
  exit 1
fi
echo "talos/$cluster/secrets.sops.yaml is SOPS-encrypted; commit it"
