#!/usr/bin/env bash
# Offline check of the kubernetes/ tree, for what the cluster would refuse or never reconcile:
# every kustomization builds, Flux builds each cluster's root Kustomization and each application
# with strict substitution, and the layout rules in docs/kubernetes.md hold, among them:
#   - an application keeps manifests only where its build reads them, in app/;
#   - on what Flux builds, every dependsOn of a Kustomization names one the cluster's overlay (or
#     its cluster directory) builds, and that one waits (wait or health checks, after the root's
#     patches are applied).
# Reports every failure, naming the file and the rule, then exits non-zero. Never contacts a
# cluster and fetches nothing: the publish run runs it in the job that signs (scripts/publish).
# What the tree holds is data: each value read from a ks.yaml is one field, a control character or
# a '|' in it read as '?'. Before it reads or builds anything else, the check refuses a tree from
# which a build would read outside kubernetes/, or that a tool would read otherwise than the check,
# and then builds nothing (scripts/lib/tree-paths.sh): a link that resolves outside it; a
# kustomization that is not one mapping, that names an entry that is not a plain relative path of
# the tree, or that holds a key that is not exactly a field kustomize reads there; a root whose
# spec.path is not a plain path of a directory of the tree as it resolves; a ks.yaml the check
# builds that holds a key flux build would read as a field it is not spelled as, or whose
# spec.components names anything but a plain path of the tree, so no entry it accepts is a URL.
# Its builds run in a second layer under that rule: git is a stand-in that refuses, and the proxies
# a closed port of the loopback. An application's spec.path is compared with the one its directory
# fixes, and what is built is that directory.
#
# KUBERNETES_CHECK_BUILT, an existing empty directory, receives what each Flux build yielded, for
# scripts/kubernetes-validate: N.yaml, and in its file builds the record N.yaml, LABEL and APP_DIR,
# each ended by a NUL byte, which no path holds: LABEL is what the output calls the build and APP_DIR
# the application directory the objects come from, empty for a cluster directory or root.
#
# Usage: scripts/kubernetes-check [DIR]   (DIR holds kubernetes/; defaults to this repository)
set -euo pipefail
# Text is matched, sorted and shown byte by byte, whatever the caller's locale.
export LC_ALL=C
shopt -s nullglob

# shellcheck source=scripts/lib/tree-paths.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/tree-paths.sh"

keep="${KUBERNETES_CHECK_BUILT:-}"
if [[ -n $keep ]]; then
  # A directory that already holds builds would get a second set added to them.
  if [[ ! -d $keep || -n $(find "$keep" -mindepth 1 -print -quit) ]]; then
    echo "kubernetes-check: KUBERNETES_CHECK_BUILT must name an existing empty directory, not $keep" >&2
    exit 1
  fi
  keep="$(cd "$keep" && pwd)"
fi
cd "${1:-$(dirname "${BASH_SOURCE[0]}")/..}"

# No kubeconfig and no in-cluster address: a tool that tried to reach a cluster fails instead.
export KUBECONFIG=/dev/null
unset KUBERNETES_SERVICE_HOST KUBERNETES_SERVICE_PORT

for tool in kustomize yq jq flux; do
  command -v "$tool" >/dev/null || { echo "kubernetes-check: $tool not found on PATH" >&2; exit 1; }
done
[[ -d kubernetes && ! -L kubernetes ]] || { echo "kubernetes-check: no kubernetes/ directory in $PWD" >&2; exit 1; }
tree_root="$(realpath -e kubernetes)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
# kustomize and flux build run with a git that refuses and a closed proxy (tree_paths_offline).
tree_paths_offline "$tmp/offline"

failures=0
fail() {
  echo "kubernetes-check: $*" >&2
  failures=$((failures + 1))
}

# What the builds read is the tree's alone, read as the check reads it, or nothing is built. Each
# Kustomization the check builds with Flux is checked as flux build reads it, its spec.components
# from the directory it is built from: a root's spec.path, an application's app/. A ks.yaml or a
# directory that leads outside the tree is a link refused here, and is not read.
while IFS= read -r line; do
  fail "$line"
done < <(tree_paths_refused "$tree_root")
# kustomization_from KS DIR: fails each thing of the Flux Kustomization in KS that flux build, building
# it from the directory DIR, would read otherwise than the check, or outside the tree.
kustomization_from() {
  local ks=$1 dir line
  tree_paths_inside "$tree_root" "$(realpath -e -- "$ks" 2>/dev/null)" || return 0
  dir="$(realpath -e -- "$2" 2>/dev/null)" || return 0
  tree_paths_inside "$tree_root" "$dir" || return 0
  while IFS= read -r line; do
    [[ -z $line ]] || fail "$ks: $line"
  done <<<"$(kustomization_refused "$ks" "$dir" "$tree_root")"
}
for ks in kubernetes/clusters/*/ks.yaml; do
  tree_paths_inside "$tree_root" "$(realpath -e -- "$ks" 2>/dev/null)" || continue
  refusal="$(root_path_refused "$ks" "$tree_root")"
  if [[ -n $refusal ]]; then
    fail "$refusal"
    continue
  fi
  path="$(yq ea '[select(. != null)] | .[0].spec.path // "" | tostring' "$ks" 2>/dev/null)" || continue
  kustomization_from "$ks" "kubernetes/${path#./}"
done
for dir in kubernetes/apps/base/*/*/ kubernetes/clusters/*/*/*/; do
  dir="${dir%/}"
  [[ -f $dir/ks.yaml && -d $dir/app ]] || continue
  kustomization_from "$dir/ks.yaml" "$dir/app"
done
if ((failures > 0)); then
  echo "kubernetes-check: $failures failure(s); nothing was built, as a build of this tree would read outside it" >&2
  exit 1
fi

# Every ks.yaml is a Flux Kustomization in flux-system with a sourceRef: substituteFrom has no
# namespace field, so a Kustomization anywhere else cannot read cluster-config or cluster-secrets.
# An application's Kustomization also names the namespace it deploys into.
ks_files=0
declare -A ks_name_file=()
ks_list="$(find kubernetes -name ks.yaml | sort)"
while IFS= read -r ks; do
  [[ -n $ks ]] || continue
  ks_files=$((ks_files + 1))
  # Empty documents, such as one after a trailing ---, hold nothing to check. Each value is one
  # field of one line: a control character or a '|' in it reads as '?'.
  if ! docs="$(yq -N 'select(. != null) | [document_index, .apiVersion // "", .kind // "",
    .metadata.name // "", .metadata.namespace // "", .spec.targetNamespace // "",
    .spec.sourceRef.kind // "", .spec.sourceRef.name // "", .spec.path // "",
    .metadata.labels["k8s-gitops/defaults"] // "",
    ([((.spec // {}) | keys | .[] | select(. == "interval" or . == "retryInterval" or
        . == "timeout" or . == "prune" or . == "deletionPolicy" or . == "decryption" or
        . == "patches")),
      ((.spec.postBuild // {}) | keys | .[] | select(. == "substituteFrom") | "postBuild." + .)]
      | join(","))] | map(tostring | sub("[\x00-\x1f\x7f|]"; "?")) | join("|")' "$ks" 2>&1)"; then
    fail "$ks: not valid YAML: $docs"
    continue
  fi
  while IFS='|' read -r doc api kind name ns target src_kind src_name ks_path defaults overridden; do
    # The document's index goes into yq expressions below.
    [[ $doc =~ ^[0-9]+$ ]] || continue
    if [[ $api != kustomize.toolkit.fluxcd.io/* || $kind != Kustomization ]]; then
      fail "$ks: document $doc must be a Flux Kustomization (kustomize.toolkit.fluxcd.io), found ${api:-no apiVersion} ${kind:-no kind}"
      continue
    fi
    # The file a built Kustomization came from, for the messages about what Flux builds.
    ks_name_file[$name]="$ks"
    [[ $ns == flux-system ]] ||
      fail "$ks: Kustomization $name must be in namespace flux-system, found ${ns:-none} (substituteFrom reads cluster-config from the Kustomization's own namespace)"
    [[ -n $src_kind && -n $src_name ]] ||
      fail "$ks: Kustomization $name must have a sourceRef with kind and name"
    if [[ $ks =~ ^kubernetes/apps/base/([^/]+)/([^/]+)/ks\.yaml$ ]]; then
      # The artifact generator names each artifact after the application directory and publishes
      # its app/ at the same path; the Kustomization finds it only under those names.
      app_ns="${BASH_REMATCH[1]}" app="${BASH_REMATCH[2]}"
      [[ $name == "$app" ]] ||
        fail "$ks: metadata.name must be $app, the application directory's name, found ${name:-none}"
      [[ $src_name == "$app" ]] ||
        fail "$ks: sourceRef.name must be $app, the artifact published for this directory, found ${src_name:-none}"
      [[ $target == "$app_ns" ]] ||
        fail "$ks: targetNamespace must be $app_ns, the namespace directory, found ${target:-none}"
      app_path="${ks_path#./}"
      [[ ${app_path%/} == "apps/base/$app_ns/$app/app" ]] ||
        fail "$ks: spec.path must be ./apps/base/$app_ns/$app/app, the application's own app/ directory, found ${ks_path:-none}"
      # components/volsync names the backup repository after APP: two applications with one APP
      # would share a repository, which VolSync does not support, and could restore each other's
      # data. The application's name is unique, so APP is that name.
      backups="$(yq "select(document_index == $doc) | [(.spec.components // [])[]
        | select(test(\"(^|/)components/volsync/?\$\"))] | length" "$ks" 2>/dev/null)" || backups=0
      if [[ $backups =~ ^[1-9] ]]; then
        backup_app="$(yq "select(document_index == $doc) | .spec.postBuild.substitute.APP // \"\"" "$ks" 2>/dev/null)" ||
          backup_app=""
        [[ $backup_app == "$name" ]] ||
          fail "$ks: postBuild.substitute.APP must be $name, the Kustomization's own name, as components/volsync names the backup repository after APP; found ${backup_app:-none}"
      fi
      # The root's defaults replace these fields on every child that has not opted out, so a value
      # set here would be lost without a word.
      if [[ $defaults != disabled && -n $overridden ]]; then
        IFS=, read -ra fields <<<"$overridden"
        for field in "${fields[@]}"; do
          fail "$ks: spec.$field is overwritten by the root Kustomization's defaults; remove it, or opt the application out with the label k8s-gitops/defaults: disabled"
        done
      fi
    elif [[ $ks =~ ^kubernetes/(clusters/[^/]+)/([^/]+)/([^/]+)/ks\.yaml$ ]]; then
      # Flux's own applications in a cluster directory. The artifact generator publishes only
      # apps/base, so these read their app/ from the cluster's sync source.
      cluster_path="${BASH_REMATCH[1]}" app_ns="${BASH_REMATCH[2]}" app="${BASH_REMATCH[3]}"
      [[ $name == "$app" ]] ||
        fail "$ks: metadata.name must be $app, the application directory's name, found ${name:-none}"
      [[ $src_kind == OCIRepository && $src_name == flux-system ]] ||
        fail "$ks: sourceRef must be OCIRepository flux-system, the cluster's sync source, found ${src_kind:-none} ${src_name:-none}"
      [[ $target == "$app_ns" ]] ||
        fail "$ks: targetNamespace must be $app_ns, the namespace directory, found ${target:-none}"
      app_path="${ks_path#./}"
      [[ ${app_path%/} == "$cluster_path/$app_ns/$app/app" ]] ||
        fail "$ks: spec.path must be ./$cluster_path/$app_ns/$app/app, the application's own app/ directory, found ${ks_path:-none}"
      # Not a child of the root, so it decrypts and substitutes only with what it sets itself; the
      # check builds it with the cluster's variables, as it does the root's children.
      for field in decryption postBuild.substituteFrom; do
        want="$(yq ea -o json -I0 "[select(. != null)] | .[0].spec.$field" "kubernetes/$cluster_path/ks.yaml" 2>/dev/null)" ||
          continue
        got="$(yq -o json -I0 "select(document_index == $doc) | .spec.$field" "$ks")"
        [[ $got == "$want" ]] ||
          fail "$ks: spec.$field must be $want, as the root ks.yaml sets it, found $got; Flux applies this Kustomization from the cluster directory, not as a child of the root"
      done
    elif [[ $ks == kubernetes/apps/* && -z $target ]]; then
      fail "$ks: Kustomization $name must set targetNamespace for what it deploys"
    fi
  done <<<"$docs"
done <<<"$ks_list"

# reached: the kustomization files and the files they list, as paths from here, filled by reach.
declare -A reached=()

# reach DIR: marks the kustomization file in DIR and every file it lists as reached, and goes on into
# each directory it lists. The lists are the fields kustomize reads a file or directory from.
reach() {
  local dir=$1 kfile entry path
  for kfile in "$dir/kustomization.yaml" "$dir/kustomization.yml" "$dir/Kustomization"; do
    [[ -f $kfile ]] && break
    kfile=""
  done
  [[ -n $kfile && -z ${reached[$kfile]:-} ]] || return 0
  reached[$kfile]=1
  while IFS= read -r entry; do
    [[ $entry != *://* && $entry != git@* ]] || continue
    path="$(realpath -m --relative-to=. -- "$dir/$entry")"
    if [[ -d $path ]]; then
      reach "$path"
    else
      reached[$path]=1
    fi
  done < <(yq -N '[(.resources // [])[], (.components // [])[], (.crds // [])[], (.configurations // [])[],
      ((.patchesStrategicMerge // [])[] | select(tag == "!!str")),
      ((.patches // [])[] | .path // ""), ((.patchesJson6902 // [])[] | .path // ""),
      ((.replacements // [])[] | select(tag == "!!map") | .path // ""),
      (.openapi.path // ""), ((.helmCharts // [])[] | .valuesFile // ""),
      (((.configMapGenerator // []) + (.secretGenerator // []))[]
        | ((.files // [])[] | sub("^[^=]*="; "")), (.envs // [])[], (.env // ""))]
    | .[] | select(. != "" and (contains("\n") | not))' "$kfile" 2>/dev/null)
}

# app_manifests DIR: every Kubernetes manifest (a document with an apiVersion and a kind) in the
# application directory DIR is one its app/kustomization.yaml reaches. The artifact generator
# publishes only app/, and the build reads only what the kustomization lists, so any other
# manifest is in Git, passes the build and never reaches the cluster.
app_manifests() {
  local dir=$1 file count
  reached=()
  reach "$dir/app"
  while IFS= read -r file; do
    [[ $file != "$dir/ks.yaml" && -z ${reached[$file]:-} ]] || continue
    count="$(yq ea '[select(tag == "!!map" and (.apiVersion // "") != "" and (.kind // "") != "")] | length' "$file" 2>/dev/null)" ||
      continue
    [[ $count =~ ^[1-9] ]] || continue
    if [[ $file != "$dir"/app/* ]]; then
      fail "$file: a Kubernetes manifest outside app/, which is all the artifact generator publishes, so the cluster never gets it; move it into $dir/app/ and list it in app/kustomization.yaml"
    else
      fail "$file: a Kubernetes manifest that $dir/app/kustomization.yaml does not reach through resources, components, patches or generators, so the build leaves it out; list it, or delete it"
    fi
  done < <(find "$dir" -type f \( -name '*.yaml' -o -name '*.yml' \) | sort)
}

# An application directory holds its Flux Kustomization in ks.yaml and its manifests in app/,
# which is also what the artifact generator publishes. Flux's own applications in a cluster
# directory have the same shape.
apps=0
declare -A app_dirs=()
for dir in kubernetes/apps/base/*/*/ kubernetes/clusters/*/*/*/; do
  dir="${dir%/}"
  [[ -f $dir/ks.yaml || -d $dir/app ]] || continue
  apps=$((apps + 1))
  [[ -f $dir/ks.yaml && -d $dir/app ]] ||
    fail "$dir: an application directory needs both ks.yaml and app/"
  app_manifests "$dir"
  # The directory name becomes the name of the application's Kustomization and artifact, which
  # all live in flux-system, enabled or not. A cluster's own applications share that namespace
  # with every application in apps/base, but not with another cluster's.
  app="${dir##*/}"
  [[ ${#app} -le 63 && $app =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] ||
    fail "$dir: application name $app must be a DNS label: lowercase letters, digits and '-', at most 63 characters"
  key="$app"
  if [[ $dir =~ ^kubernetes/clusters/([^/]+)/ ]]; then
    key="${BASH_REMATCH[1]}/$app"
    [[ -z ${app_dirs[$app]:-} ]] ||
      fail "$dir: application name $app is also used by ${app_dirs[$app]}; the cluster's own applications share the flux-system namespace with every application"
  fi
  if [[ -n ${app_dirs[$key]:-} ]]; then
    fail "$dir: application name $app is also used by ${app_dirs[$key]}; every application's Kustomization and artifact share the flux-system namespace"
  else
    app_dirs[$key]="$dir"
  fi
done

# A cluster directory builds to its root Kustomization and the Kustomizations of Flux's own two
# applications, flux-operator and flux-instance, and nothing else. Without a kustomization.yaml
# Flux generates one from every YAML file there, the example key lists included.
for dir in kubernetes/clusters/*/; do
  dir="${dir%/}"
  if [[ ! -f $dir/kustomization.yaml ]]; then
    fail "$dir: needs a kustomization.yaml that lists ks.yaml and Flux's own ks.yaml files; without one Flux builds every YAML file in the directory, the example key lists included"
    continue
  fi
  # A build that fails is reported with the other kustomize builds below, and a ks.yaml that
  # cannot be read with the ks.yaml rules above.
  built="$(offline kustomize build --load-restrictor LoadRestrictionsNone "$dir" 2>/dev/null)" || continue
  # Compared by API group, so a new Kustomization API version still counts.
  if ! found="$(yq -N '(.apiVersion | sub("/[^/]*$"; "")) + " " + .kind + "/" + .metadata.name' <<<"$built" 2>&1)"; then
    fail "$dir: cannot read what kustomize build yields: $found"
    continue
  fi
  root="$(yq '.metadata.name' "$dir/ks.yaml" 2>/dev/null)" || root=""
  wanted="$(printf 'kustomize.toolkit.fluxcd.io Kustomization/%s\n' "$root" flux-operator flux-instance | sort)"
  while IFS= read -r object; do
    fail "$dir: kustomize build yields $object; a cluster directory builds only its root Kustomization from ks.yaml and the Kustomizations flux-operator and flux-instance"
  done < <(comm -13 <(echo "$wanted") <(sort <<<"$found"))
  while IFS= read -r object; do
    fail "$dir: does not build ${object#* }; a cluster directory builds its root Kustomization from ks.yaml and the Kustomizations flux-operator and flux-instance, which describe Flux itself"
  done < <(comm -23 <(echo "$wanted") <(sort <<<"$found"))
done

# Without load restrictions, as Flux builds: the overlay lists ks.yaml files outside its own root.
kustomize_builds=0
declare -A broken=()
build_list="$(find kubernetes -name kustomization.yaml -exec dirname {} \; | sort)"
while IFS= read -r dir; do
  [[ -n $dir ]] || continue
  kustomize_builds=$((kustomize_builds + 1))
  if err="$(offline kustomize build --load-restrictor LoadRestrictionsNone "$dir" 2>&1 >/dev/null)"; then
    echo "built $dir"
  else
    broken[$dir]=1
    fail "$dir/kustomization.yaml: kustomize build failed: $err"
  fi
done <<<"$build_list"

# Flux decides what a variable is: it substitutes after the build, so generator inputs count, and
# it leaves comments, $${VAR} and objects marked kustomize.toolkit.fluxcd.io/substitute: disabled
# alone. The example key lists stand in for cluster-config and cluster-secrets, which --dry-run
# cannot read; an application's own postBuild.substitute is added to them.
values="$tmp/values.yaml"
examples=(kubernetes/clusters/*/cluster-config.example.yaml kubernetes/clusters/*/cluster-secrets.example.yaml)
echo '{}' >"$values"
if ((${#examples[@]} > 0)); then
  # shellcheck disable=SC2016 # $list is a yq variable.
  if merged="$(yq ea '. as $list ireduce ({}; . * ($list // {})) | with_entries(.value |= tostring)' \
    "${examples[@]}" 2>&1)"; then
    printf '%s\n' "$merged" >"$values"
  else
    fail "${examples[*]}: must be plain key lists: $merged"
  fi
fi

# hint VAR [GREP_OPTION...] PATH...: "file:line" of the first mention of ${VAR} under PATH, for the
# message. Every PATH starts with kubernetes/, so none is taken for an option.
hint() {
  local var=$1 hits file line
  shift
  hits="$(grep -rlE -e '\$\{#?'"$var"'([^A-Za-z0-9_]|$)' "$@" 2>/dev/null)" || return 0
  file="${hits%%$'\n'*}"
  line="$(grep -nE -m1 -e '\$\{#?'"$var"'([^A-Za-z0-9_]|$)' -- "$file" | cut -d: -f1)"
  echo "$file:$line"
}

flux_builds=0
mkdir "$tmp/built"
last_built=""
# flux_build KS PATH LABEL APP_DIR HINT_ARG...: builds the Kustomization in KS from PATH as Flux does,
# with strict substitution, and names where an unset variable is used, passing HINT_ARG to hint.
# LABEL is what the output calls the build, and APP_DIR the application directory the objects come
# from, if they come from one; the result is in last_built when it succeeded.
flux_build() {
  local ks=$1 path=$2 label=$3 app_dir=$4 name err var where refused line
  shift 4
  last_built=""
  # A ks.yaml that cannot be read is reported with the ks.yaml rules above.
  name="$(yq ea '[select(. != null)] | .[0].metadata.name' "$ks" 2>/dev/null)" || return 0
  # shellcheck disable=SC2016 # $values is a yq variable.
  yq ea 'select(fileIndex == 0) as $values | select(fileIndex == 1 and . != null)
    | .spec.postBuild.substitute = ($values * (.spec.postBuild.substitute // {}))' \
    "$values" "$ks" >"$tmp/ks.yaml" 2>/dev/null || return 0
  # What flux build is handed, as it reads it: the guard above checked the files it comes from.
  refused="$(kustomization_refused "$tmp/ks.yaml" "$(realpath -e -- "$path")" "$tree_root")"
  if [[ -n $refused ]]; then
    while IFS= read -r line; do
      fail "$label: $line"
    done <<<"$refused"
    return 0
  fi
  flux_builds=$((flux_builds + 1))
  if err="$(offline flux build kustomization "$name" --path "$path" --kustomization-file "$tmp/ks.yaml" \
    --dry-run --strict-substitute --in-memory-build 2>&1 >"$tmp/built/$flux_builds.yaml")"; then
    echo "built $label"
    last_built="$tmp/built/$flux_builds.yaml"
    if [[ -n $keep ]]; then
      cp "$last_built" "$keep/$flux_builds.yaml"
      printf '%s\0%s\0%s\0' "$flux_builds.yaml" "$label" "$app_dir" >>"$keep/builds"
    fi
  elif [[ $err =~ variable\ not\ set\ \(strict\ mode\):\ \"([A-Za-z_][A-Za-z0-9_]*)\" ]]; then
    var="${BASH_REMATCH[1]}"
    where="$(hint "$var" "$@")"
    fail "${where:-$label}: variable $var is not set: list it in a cluster's cluster-config.example.yaml or cluster-secrets.example.yaml, set it in the application's postBuild.substitute, or give it a default (\${$var:=value})"
  else
    fail "$label: flux build of $path failed: $err"
  fi
}

# What flux_build built for each cluster directory: the directory as the instance's sync
# Kustomization applies it, and its root Kustomization's overlay.
declare -A sync_built=() root_built=()

# The instance's sync Kustomization applies each cluster directory with the root's decryption and
# substitution (tests/flux.bats proves they match), so the root's and Flux's own ks.yaml files are
# substituted as well. A stand-in named after the namespace, as the instance names its sync
# objects, builds the directory the same way.
for dir in kubernetes/clusters/*/; do
  dir="${dir%/}"
  [[ -f $dir/kustomization.yaml && -f $dir/ks.yaml && -z ${broken[$dir]:-} ]] || continue
  sync_path="./${dir#kubernetes/}" yq ea '[select(. != null)] | .[0]
    | {"apiVersion": .apiVersion, "kind": .kind,
       "metadata": {"name": "flux-system", "namespace": "flux-system"},
       "spec": {"path": strenv(sync_path), "sourceRef": {"kind": "OCIRepository", "name": "flux-system"},
         "decryption": .spec.decryption, "postBuild": {"substituteFrom": .spec.postBuild.substituteFrom}}}' \
    "$dir/ks.yaml" >"$tmp/sync.yaml" 2>/dev/null || continue
  flux_build "$tmp/sync.yaml" "$dir" "$dir as the instance's sync Kustomization" "" --exclude-dir=app "$dir"
  [[ -z $last_built ]] || sync_built[$dir]="$last_built"
done

# The root applies its patches to the children; only a Flux build shows they still apply. It also
# substitutes into the ks.yaml files and namespace directories it lists.
for ks in kubernetes/clusters/*/ks.yaml; do
  path="$(yq ea '[select(. != null)] | .[0].spec.path' "$ks" 2>/dev/null)" || continue
  path="kubernetes/${path#./}"
  path="${path%/}"
  # A directory of the tree as it resolves, checked before anything was built.
  [[ -z ${broken[$path]:-} ]] || continue
  hints=()
  for dir in kubernetes/apps kubernetes/components; do
    [[ -d $dir ]] && hints+=("$dir")
  done
  flux_build "$ks" "$path" "$ks" "" --exclude-dir=app "${hints[@]}"
  [[ -z $last_built ]] || root_built[${ks%/ks.yaml}]="$last_built"
done

# Every application, enabled or not, and Flux's own, with its own substitution.
for dir in kubernetes/apps/base/*/*/ kubernetes/clusters/*/*/*/; do
  dir="${dir%/}"
  [[ -f $dir/ks.yaml && -d $dir/app && -z ${broken[$dir/app]:-} ]] || continue
  hints=("$dir/app")
  [[ -d kubernetes/components ]] && hints+=(kubernetes/components)
  flux_build "$dir/ks.yaml" "$dir/app" "$dir/ks.yaml" "$dir" "${hints[@]}"
done

# kustomizations FILE: the Flux Kustomizations among the objects FILE holds, one JSON object a line.
kustomizations() {
  yq -N -o json -I0 'select(. != null and .kind == "Kustomization" and ((.apiVersion // "") | test("^kustomize\.toolkit\.fluxcd\.io/")))' "$1"
}

# What a Kustomization that names another in dependsOn needs, judged on what Flux builds, so the
# root's patches count: the other is one the cluster applies, which is one its overlay lists or one
# its cluster directory builds, and it is Ready only once what it applies is, through wait or health
# checks; otherwise the dependent never reconciles, or starts before its dependency's objects exist.
dependencies=0
for dir in kubernetes/clusters/*/; do
  dir="${dir%/}"
  [[ -n ${root_built[$dir]:-} && -n ${sync_built[$dir]:-} ]] || continue
  overlay="$(yq ea '[select(. != null)] | .[0].spec.path' "$dir/ks.yaml" 2>/dev/null)" || continue
  overlay="kubernetes/${overlay#./}"
  overlay="${overlay%/}"
  kustomizations "${root_built[$dir]}" >"$tmp/dependents.jsonl"
  kustomizations "${sync_built[$dir]}" >>"$tmp/dependents.jsonl"
  if ! jq -rs 'def ns: .metadata.namespace // "default";
    def ready: .spec.wait == true or ((.spec.healthChecks // []) | length > 0) or ((.spec.healthCheckExprs // []) | length > 0);
    . as $all
    | (reduce $all[] as $k ({}; .[($k | ns) + "/" + $k.metadata.name] = $k)) as $by
    | $all[] | . as $k | (.spec.dependsOn // [])[]
    | ((.namespace // ($k | ns)) + "/" + .name) as $key
    | [(if $by[$key] == null then "missing" elif ($by[$key] | ready) then "ok" else "nowait" end),
       $k.metadata.name, (if .namespace then $key else .name end)] | join("|")' "$tmp/dependents.jsonl" >"$tmp/dependency-verdicts"; then
    fail "$dir/ks.yaml: cannot read the Kustomizations built for $overlay, so their dependsOn were not checked"
    continue
  fi
  while IFS='|' read -r verdict dependent dep; do
    dependencies=$((dependencies + 1))
    file="${ks_name_file[$dependent]:-$dir/ks.yaml}"
    case $verdict in
      missing)
        fail "$file: Kustomization $dependent names $dep in dependsOn, but $overlay does not enable $dep, nor does $dir build it, so $dependent would never reconcile; list the ks.yaml of $dep in $overlay/kustomization.yaml, or drop the dependency"
        ;;
      nowait)
        fail "$file: Kustomization $dependent names $dep in dependsOn, but $dep does not wait, as built for $overlay: it sets none of wait: true, healthChecks and healthCheckExprs, so $dependent starts before the objects of $dep are ready; set wait: true on $dep"
        ;;
    esac
  done <"$tmp/dependency-verdicts"

  # A Kustomization that chooses, with PUBLIC_ISSUER, an issuer other than the cluster's own CA
  # chooses one of acme-issuers, so it names that application in dependsOn, and the check above then
  # requires the cluster to enable it: otherwise its certificate is requested from an issuer that
  # does not exist, or before it does. The name is one of the ClusterIssuers that application
  # defines, so a mistyped name is refused here and not left to a Certificate that is never Ready.
  # The application's files are listed first: a tree without it makes no issuer, and yq is not run,
  # as with no file to read it reads standard input, or prints its usage where the names are read.
  issuer_files=(kubernetes/apps/base/*/acme-issuers/app/*.yaml)
  acme_issuers='[]'
  if ((${#issuer_files[@]} > 0)); then
    acme_issuers=$(yq -N 'select(.kind == "ClusterIssuer") | .metadata.name' "${issuer_files[@]}" | jq -R . | jq -sc .) ||
      fail "$dir/ks.yaml: cannot read the ClusterIssuers of acme-issuers, so the issuer choices were not checked"
  fi
  if ! jq -r --argjson known "${acme_issuers:-[]}" 'def clean: tostring | gsub("[^A-Za-z0-9._-]"; "?");
    select((.spec.postBuild.substitute.PUBLIC_ISSUER // "cluster-ca") != "cluster-ca") as $k
    | ($k.spec.postBuild.substitute.PUBLIC_ISSUER) as $issuer
    | (if (($k.spec.dependsOn // []) | map(.name) | index("acme-issuers")) == null then "dependency" else empty end,
       if ($known | index($issuer)) == null then "unknown" else empty end)
    | . + "|" + ($k.metadata.name | clean) + "|" + ($issuer | clean)' \
    "$tmp/dependents.jsonl" >"$tmp/issuer-choices"; then
    fail "$dir/ks.yaml: cannot read the Kustomizations built for $overlay, so their issuer choices were not checked"
    continue
  fi
  while IFS='|' read -r verdict dependent issuer; do
    file="${ks_name_file[$dependent]:-$dir/ks.yaml}"
    case $verdict in
      dependency)
        fail "$file: Kustomization $dependent chooses the issuer $issuer, which the application acme-issuers makes, but does not name acme-issuers in dependsOn, so its certificate can be requested before the issuer exists; name acme-issuers in dependsOn, in the same patch that chooses the issuer in $overlay/kustomization.yaml"
        ;;
      unknown)
        fail "$file: Kustomization $dependent chooses the issuer $issuer, but the application acme-issuers makes no issuer of that name, so its certificate would never be issued; choose one the application defines, or leave the choice out for the cluster's own CA"
        ;;
    esac
  done <"$tmp/issuer-choices"

  # A Kustomization that takes the cnpg-cluster component builds a database that archives through the
  # Barman Cloud plugin, so it names plugin-barman-cloud in dependsOn, and the check above then
  # requires the cluster to enable it: otherwise its Cluster is admitted before the plugin's webhooks
  # exist, or never. The component builds the archive's path from CNPG_NAMESPACE, which it cannot read
  # from targetNamespace, so the two are held equal here: a Kustomization that names another
  # namespace archives to the path of the database of that namespace.
  if ! jq -r 'def clean: tostring | gsub("[^A-Za-z0-9._-]"; "?");
    select(((.spec.components // []) | map(select(test("(^|/)components/cnpg-cluster/?$"))) | length) > 0) as $k
    | (if (($k.spec.dependsOn // []) | map(.name) | index("plugin-barman-cloud")) == null then "plugin|" + ($k.metadata.name | clean) else empty end,
       if ($k.spec.postBuild.substitute.CNPG_NAMESPACE // "") != ($k.spec.targetNamespace // "") then
         "namespace|" + ($k.metadata.name | clean) + "|" + (($k.spec.postBuild.substitute.CNPG_NAMESPACE // "nothing") | clean)
           + "|" + (($k.spec.targetNamespace // "nothing") | clean) else empty end)' \
    "$tmp/dependents.jsonl" >"$tmp/database-users"; then
    fail "$dir/ks.yaml: cannot read the Kustomizations built for $overlay, so those that take the cnpg-cluster component were not checked"
    continue
  fi
  while IFS='|' read -r verdict dependent namespace target; do
    file="${ks_name_file[$dependent]:-$dir/ks.yaml}"
    case $verdict in
      plugin)
        fail "$file: Kustomization $dependent takes the cnpg-cluster component but does not name plugin-barman-cloud in dependsOn, so its database can be made before the plugin's webhooks exist; name plugin-barman-cloud in dependsOn"
        ;;
      namespace)
        fail "$file: Kustomization $dependent sets CNPG_NAMESPACE to $namespace, but its targetNamespace is $target, so its backups would go to the path of a database of the namespace $namespace; set CNPG_NAMESPACE to the targetNamespace"
        ;;
    esac
  done <"$tmp/database-users"
done

if ((failures > 0)); then
  echo "kubernetes-check: $failures failure(s)" >&2
  exit 1
fi
echo "kubernetes-check: passed ($kustomize_builds kustomize builds, $flux_builds flux builds, $ks_files ks.yaml, $apps applications, $dependencies dependencies)"
