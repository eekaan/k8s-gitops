# OpenTofu state and variables hold real addresses and secrets; a stack's .terraform.lock.hcl
# stays tracked.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
.terraform.tfstate.lock.info

# The stacks that use a module pin its providers, not the module. tofu init in a module directory,
# which its tests need, would otherwise leave a lock file there.
infra/openstack/modules/*/.terraform.lock.hcl

# talman's per-cluster config and generated machine configs carry cluster secrets.
talos/*/talman.yaml
clusterconfig/

# Keys and credentials only ever live on the operator's machine.
*.agekey
age.txt
*.key
*.pem
kubeconfig
talosconfig
.env
.env.*
# Variable names and placeholders only.
!.env.example
clouds.yaml
secure.yaml

# The operator's own source addresses.
operator-cidrs.json

# Planning notes stay local.
.devflow/

.DS_Store
*.swp
.idea/
.vscode/
