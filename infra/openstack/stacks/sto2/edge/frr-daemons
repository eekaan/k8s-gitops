# FRR's daemons on an edge: the BGP daemon, and what FRR's start script starts whatever this list
# says: watchfrr, zebra, which puts the routes BGP learns into the kernel, mgmtd, and staticd, which
# installs the reject route for the service range. Every other routing daemon is off.
bgpd=yes
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no

vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
mgmtd_options="  -A 127.0.0.1"
bgpd_options="   -A 127.0.0.1"
staticd_options="-A 127.0.0.1"
