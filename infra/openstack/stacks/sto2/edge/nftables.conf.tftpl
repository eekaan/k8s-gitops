flush ruleset

# Filtering. A connection to a public port ends at the edge's own proxy, which opens its own
# connection to the Gateway's address, so nothing is translated and nothing is forwarded. What is
# addressed to the edge is dropped except SSH, the public ports, BGP from the workers' addresses and
# the ICMP that path MTU discovery needs. The networks the public ports and SSH admit are the
# security group's to hold; these rules take the public ports by port, to the edge's own address, as
# the user data holds no operator allowlist. A port that is not listed has no rule here and no
# listener.
# The proxy's connection to the Gateway's address is locally generated, so it leaves through the
# output chain, which refuses at once, with an answer the proxy reads as a refused connection, every
# packet toward that address whose route's next hop is not a worker's address. With no worker's
# route to it, before FRR has learned one or once FRR stops and zebra takes its routes out of the
# kernel, a connection to it fails there and does not follow the default route to the cloud's router;
# while FRR runs, its reject route for the service range gives the same answer in the kernel. The
# connection's source is the edge's own address, which the proxy's configuration names and which is
# the one the kernel picks for a route out of the node subnet's interface: a worker answers a
# packet from a node-subnet address straight back to it, where it would send an answer to a
# client's address through the cloud's router.
# Replies to the proxy's connections and to SSH and BGP are what ct state established admits.
# Nothing of IPv6 is forwarded: the kernel's IPv6 forwarding stays off, and no rule admits it.
table inet edge {
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif "lo" accept
    tcp dport 22 accept
    ip daddr ${own} tcp dport { ${join(", ", ports)} } accept
    ip saddr { ${workers} } tcp dport 179 accept
    icmp type destination-unreachable icmp code frag-needed accept
    icmpv6 type { packet-too-big, nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
    ip daddr ${gateway} rt ip nexthop != { ${workers} } reject
  }
}
