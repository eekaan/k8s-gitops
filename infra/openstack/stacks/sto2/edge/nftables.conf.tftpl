flush ruleset

# Filtering. What is addressed to the edge is dropped except SSH, BGP from the workers' addresses
# and the ICMP that path MTU discovery needs. The public ports never reach the input chain: the
# translation below moves their destination to the Gateway first, so they are forwarded, and only to
# it. The networks the public ports and SSH admit are the security group's to hold; these rules take
# those by port only, as they are in the user data, which holds no operator allowlist.
# A translated connection is forwarded only when its route's next hop is a worker's address. With
# no worker's route to the Gateway's address, before FRR has learned one or once FRR stops and its
# routes go, it is dropped here and does not follow the default route to the cloud's router.
table inet edge {
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif "lo" accept
    tcp dport 22 accept
    ip saddr { ${workers} } tcp dport 179 accept
    icmp type destination-unreachable icmp code frag-needed accept
    icmpv6 type { packet-too-big, nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    ip daddr ${gateway} tcp dport { ${ports} } ct state new ct status dnat rt ip nexthop { ${workers} } accept
  }
}

# Translation. A connection to the edge's own address on a public port goes to the Gateway's
# address, from the edge's own address: a worker answers a packet from a node-subnet address
# straight back to it, where it would send an answer to a client's address through the cloud's
# router, and the answer would never meet the connection it belongs to.
table ip edge-nat {
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
    ip daddr ${own} tcp dport { ${ports} } dnat to ${gateway}
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip daddr ${gateway} tcp dport { ${ports} } ct status dnat snat to ${own}
  }
}
