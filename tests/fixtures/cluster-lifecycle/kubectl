#!/usr/bin/env bash
# A stand-in for kubectl against a running cluster, installed by tests/cluster-lifecycle.bats as
# <tmp>/bin/kubectl. It finds its files from its own path and answers the reads the cluster recipes
# make from files in <tmp>/state:
#   api-down          the API does not answer; kubectl's error names the API server's address
#   readyz-fails      the API answers, but /readyz says it is not ready
#   nodes             the cluster's nodes, by hostname, one per line
#   not-ready         hostnames whose Ready condition is False
#   back.<hostname>   the node's kubelet has reported since it rebooted: its Ready condition's
#                     heartbeat is the current time; without it, a heartbeat from long ago
#   cordoned.<hostname>  the node is unschedulable: cordon and drain make it so, uncordon undoes it
#   drain-fails       kubectl drain cordons the node, cannot evict a pod and fails
#   drain-unreachable kubectl drain cannot reach the API, and its error names the API server's address
#   bgp-out.<hostname>  the node carries the BGP opt-out label: kubectl label sets and removes it
#   bgp-slow          the number of reads of a worker's CiliumBGPNodeConfig after its label changes
#                     before the change shows: the config stays that long after the label is set,
#                     and its peers are not established that long after the label is removed, as
#                     the operator and the agent take a moment
#   bgp-stays         a labelled-out worker's CiliumBGPNodeConfig never goes
#   bgp-not-back      a worker whose label is removed never announces again
#   bgp-peers-down    no worker's BGP session is ever established, as with no edge stack to peer with
#   bgp-peer-late     with bgp-slow, only the second peer is established late after the label is
#                     removed: the first is established at once
#   bgp-back-late     with bgp-slow, a worker's CiliumBGPNodeConfig is not there for that many reads
#                     after its label is removed, as the operator takes a moment to make it again
#   bgp-unreadable    reading a CiliumBGPNodeConfig fails, as when the API does not answer it
#   bgp-unreadable-out  the same, but only while the worker carries the label
#   agent-sequence.<hostname>  what the node's Cilium agent pod answers to each read after the node is
#                     back, one word per read, the last repeated: ready (Ready since the reboot),
#                     stale (Ready, but since before it: the pod's last report before the node went
#                     down) or not (not Ready); without the file it is ready at once
#   agent-missing     no Cilium agent pod runs on the nodes
#   agent-unreadable  reading a Cilium agent pod fails, as when the API does not answer it
#   kube-proxy        a kube-proxy pod runs in kube-system
#   pods              more pods, one per line as <namespace> <name> <phase> [<node> [<reason>]], on
#                     cp-1 when no node is given; kubectl delete pod removes them
#   no-flux           the namespace flux-system does not exist, and no pod runs in it
#   pending-csr       a certificate signing request is Pending
#   logs-fail         a pod's logs cannot be fetched, as before its kubelet's serving certificate is
#                     approved, with an error naming the node's address
#   load-balancer     a Service of type LoadBalancer exists, at an address outside the service range
#   pool-load-balancer  a Service of type LoadBalancer exists at an address in the service range of
#                     the fixture's talman.yaml
#   pending-load-balancer  a Service of type LoadBalancer exists without an address yet
#   mixed-load-balancer  a Service of type LoadBalancer exists with one address in the service range
#                     and one outside it
#   hostname-load-balancer  a Service of type LoadBalancer exists whose load balancer has a host
#                     name and no address
#   extra-services    more Services, one JSON object per line
#   csi-volume        a PersistentVolume of a CSI driver exists
#   no-monitoring     the monitoring stack is not installed: there is no Service for Prometheus
#   targets-down      Prometheus's targets that are down, one per line as <job> [<node>]
#   other-down        a target of a job that is none of the cluster's own components is down
#   prometheus-silent Prometheus does not answer through the service proxy, and kubectl's error names
#                     an address
#   prometheus-error  Prometheus answers its targets request with an error status
#   targets-none      Prometheus answers successfully with no active target at all, as just started
#   unscraped         the jobs that file names, one per line, have no active target
#   many-targets      Prometheus's answer carries that many more targets of another job, enough to
#                     fill a pipe many times over
#   linstor-volumes   as many PersistentVolumes of LINSTOR's CSI driver as the file's number
# Every object it answers with holds addresses from the documentation ranges, as do its errors and the
# log line, which the recipes must never print. It records "kubectl ARGS" in <tmp>/record/argv, and
# "drain of <hostname> finished" there when a drain has evicted every pod, a
# /readyz it refuses in <tmp>/record/readyz-refused, each pod it deletes as <namespace>/<name> in
# <tmp>/record/deleted, and for each uncordon whether the node had come back, as "<hostname> back" or
# "<hostname> away", in <tmp>/record/uncordoned, and for each drain whether the node still announced
# when it began, as "<hostname> announcing" or "<hostname> withdrawn", in <tmp>/record/drained-bgp.
set -uo pipefail

root=${0%/bin/*}
state=$root/state
record=$root/record
printf '%s\n' "kubectl $*" >> "$record/argv"

args=" $* "
if [[ -e $state/api-down ]]; then
  if [[ $args == *" /readyz "* ]]; then
    echo refused >> "$record/readyz-refused"
  fi
  echo "Unable to connect to the server: dial tcp 198.51.100.66:6443: connect: connection refused" >&2
  exit 1
fi

# listed FILE: whether FILE exists.
listed() {
  [[ -e $state/$1 ]]
}

nodes() {
  local node ready beat now unschedulable
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  while IFS= read -r node; do
    [[ -n $node ]] || continue
    ready=True
    if grep -qxF -- "$node" "$state/not-ready" 2> /dev/null; then
      ready=False
    fi
    beat=2026-01-01T00:00:00Z
    if listed "back.$node"; then
      beat=$now
    fi
    unschedulable=false
    if listed "cordoned.$node"; then
      unschedulable=true
    fi
    labels='{}'
    if [[ $node == cp-* ]]; then
      labels='{"node-role.kubernetes.io/control-plane": ""}'
    fi
    if listed "bgp-out.$node"; then
      labels=$(jq -c '. + {"node-restriction.kubernetes.io/bgp-out": "true"}' <<< "$labels")
    fi
    jq -n --arg node "$node" --arg ready "$ready" --arg beat "$beat" --arg now "$now" \
      --argjson unschedulable "$unschedulable" --argjson labels "$labels" '{
      metadata: {name: $node, labels: $labels},
      spec: (if $unschedulable then {unschedulable: true} else {} end),
      status: {
        addresses: [
          {type: "InternalIP", address: "198.51.100.31"},
          {type: "ExternalIP", address: "198.51.100.41"},
          {type: "Hostname", address: $node}],
        conditions: [
          {type: "MemoryPressure", status: "False", lastHeartbeatTime: $now},
          {type: "Ready", status: $ready, lastHeartbeatTime: $beat,
           message: "kubelet on 198.51.100.31 reports \($ready)"}]}}'
  done < "$state/nodes"
}

# bgp_reads NODE: counts a read of NODE's CiliumBGPNodeConfig since its label last changed.
bgp_reads() {
  echo $(($(cat "$state/bgp-reads.$1" 2> /dev/null || echo 0) + 1)) > "$state/bgp-reads.$1"
}

# announcing NODE: whether NODE's CiliumBGPNodeConfig exists, which the operator makes for each node
# the cluster configuration selects: never for a control plane; for a worker with the label only
# until bgp-slow reads have passed, or always with bgp-stays; for one without it, unless bgp-not-back
# keeps it away once the label was set, or bgp-back-late for bgp-slow reads after it was removed.
announcing() {
  local reads slow
  [[ $1 != cp-* ]] || return 1
  reads=$(cat "$state/bgp-reads.$1" 2> /dev/null || echo 0)
  slow=$(cat "$state/bgp-slow" 2> /dev/null || echo 0)
  if listed "bgp-out.$1"; then
    listed bgp-stays && return 0
    ((reads < slow))
    return
  fi
  if listed bgp-back-late && listed "bgp-put-back.$1" && ((reads < slow)); then
    return 1
  fi
  ! listed bgp-not-back || ! listed "bgp-was-out.$1"
}

# bgp_node_config NODE: what kubectl get ciliumbgpnodeconfig NODE --ignore-not-found prints: an
# error, and a failure, with bgp-unreadable, or with bgp-unreadable-out while NODE carries the label;
# otherwise nothing while announcing says there is no such object, else the object, its two peers
# active with bgp-peers-down, else established, unless the label has been set on NODE and last
# changed fewer than bgp-slow reads ago, which leaves the second active, and the first too without
# bgp-peer-late.
bgp_node_config() {
  local first=established second=established present=0
  if listed bgp-unreadable || { listed bgp-unreadable-out && listed "bgp-out.$1"; }; then
    echo "Unable to connect to the server: net/http: TLS handshake timeout" >&2
    exit 1
  fi
  announcing "$1" && present=1
  if listed bgp-peers-down; then
    first=active second=active
  elif listed "bgp-was-out.$1" && (($(cat "$state/bgp-reads.$1" 2> /dev/null || echo 0) < $(cat "$state/bgp-slow" 2> /dev/null || echo 0))); then
    second=active
    listed bgp-peer-late || first=active
  fi
  bgp_reads "$1"
  ((present)) || return 0
  jq -n --arg node "$1" --arg first "$first" --arg second "$second" '{metadata: {name: $node},
    spec: {bgpInstances: [{name: "cluster", peers: [{name: "edge-1"}, {name: "edge-2"}]}]},
    status: {bgpInstances: [{name: "cluster", peers: [
      {name: "edge-1", peeringState: $first}, {name: "edge-2", peeringState: $second}]}]}}'
}

# agent_pods NODE: the Cilium agent pods on NODE as a kubectl List: while the node has not come back,
# the pod's last report from before it went down; afterwards what agent-sequence.NODE says of this
# read.
agent_pods() {
  local node=$1 reads answer words status when now
  if listed agent-unreadable; then
    echo "Unable to connect to the server: net/http: TLS handshake timeout" >&2
    exit 1
  fi
  listed agent-missing && { list < /dev/null; return; }
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  answer=stale
  if listed "back.$node"; then
    reads=$(cat "$state/agent-reads.$node" 2> /dev/null || echo 0)
    echo $((reads + 1)) > "$state/agent-reads.$node"
    answer=ready
    if listed "agent-sequence.$node"; then
      read -ra words < "$state/agent-sequence.$node"
      answer=${words[reads]:-${words[${#words[@]} - 1]}}
    fi
  fi
  echo "agent $node $answer" >> "$record/argv"
  echo "$answer" > "$state/agent-last.$node"
  status=True when=$now
  [[ $answer != stale ]] || when=2026-01-01T00:00:00Z
  [[ $answer != not ]] || status=False
  jq -n --arg node "$node" --arg status "$status" --arg when "$when" '{
    metadata: {namespace: "kube-system", name: "cilium-\($node)", labels: {"k8s-app": "cilium"}},
    spec: {nodeName: $node},
    status: {phase: "Running", podIP: "198.51.100.51", conditions: [
      {type: "Ready", status: $status, lastTransitionTime: $when}]}}' | list
}

# pod NAMESPACE NAME PHASE [K8S_APP [NODE [REASON]]]
pod() {
  jq -n --arg namespace "$1" --arg name "$2" --arg phase "$3" --arg app "${4-}" --arg node "${5:-cp-1}" \
    --arg reason "${6-}" '{
    metadata: ({namespace: $namespace, name: $name} + if $app == "" then {} else {labels: {"k8s-app": $app}} end),
    spec: {nodeName: $node, containers: [{name: "main"}]},
    status: ({phase: $phase, hostIP: "198.51.100.31", podIP: "198.51.100.51"}
      + if $reason == "" then {} else {reason: $reason, message: "Pod was rejected: \($reason) on 198.51.100.31"} end)}'
}

pods() {
  local namespace name phase node reason
  pod kube-system cilium-a1b2c Running cilium
  pod kube-system coredns-c3d4e Running kube-dns
  pod kube-system kubelet-csr-approver-e5f6g Running
  pod kube-system etcd-defrag-h7i8j Succeeded
  # Outside the namespaces the check reads, a pod in any phase is no concern of it.
  pod default app-k9l0m Pending
  if ! listed no-flux; then
    pod flux-system source-controller-n1o2p Running
  fi
  if listed kube-proxy; then
    pod kube-system kube-proxy-q3r4s Running kube-proxy
  fi
  if listed pods; then
    while read -r namespace name phase node reason; do
      pod "$namespace" "$name" "$phase" '' "$node" "$reason"
    done < "$state/pods"
  fi
}

# delete_pods ARG...: kubectl delete pod's arguments: removes each named pod of the namespace
# --namespace gives from the pods file, failing on one that is not there unless --ignore-not-found.
delete_pods() {
  local namespace=default ignore=0 name kept
  local -a names=()
  while (($#)); do
    case $1 in
      --namespace | -n) namespace=$2 && shift ;;
      --namespace=*) namespace=${1#*=} ;;
      --ignore-not-found | --ignore-not-found=true) ignore=1 ;;
      -*) ;;
      *) names+=("$1") ;;
    esac
    shift
  done
  for name in "${names[@]}"; do
    if ! grep -q "^$namespace $name " "$state/pods" 2> /dev/null; then
      ((ignore)) && continue
      echo "Error from server (NotFound): pods \"$name\" not found" >&2
      exit 1
    fi
    kept=$(grep -v "^$namespace $name " "$state/pods")
    printf '%s\n' "$kept" | grep . > "$state/pods"
    echo "$namespace/$name" >> "$record/deleted"
    echo "pod \"$name\" deleted"
  done
}

csrs() {
  jq -n '{metadata: {name: "csr-approved-1"}, spec: {signerName: "kubernetes.io/kubelet-serving", username: "system:node:cp-1"},
    status: {conditions: [{type: "Approved", status: "True"}], certificate: "marker-certificate"}}'
  jq -n '{metadata: {name: "csr-denied-1"}, spec: {signerName: "kubernetes.io/kubelet-serving", username: "system:node:cp-2"},
    status: {conditions: [{type: "Denied", status: "True"}]}}'
  if listed pending-csr; then
    jq -n '{metadata: {name: "csr-pending-1"}, spec: {signerName: "kubernetes.io/kubelet-serving", username: "system:node:worker-1"}, status: {}}'
  fi
}

services() {
  jq -n '{metadata: {namespace: "default", name: "kubernetes"}, spec: {type: "ClusterIP", clusterIP: "198.51.100.61"}}'
  jq -n '{metadata: {namespace: "kube-system", name: "hubble-relay"}, spec: {type: "NodePort", clusterIP: "198.51.100.63"}}'
  if listed load-balancer; then
    jq -n '{metadata: {namespace: "apps", name: "web"}, spec: {type: "LoadBalancer", clusterIP: "198.51.100.64"},
      status: {loadBalancer: {ingress: [{ip: "198.51.100.62"}]}}}'
  fi
  if listed pool-load-balancer; then
    jq -n '{metadata: {namespace: "gateways", name: "public"}, spec: {type: "LoadBalancer", clusterIP: "198.51.100.65"},
      status: {loadBalancer: {ingress: [{ip: "192.0.2.130", ipMode: "VIP"}]}}}'
  fi
  if listed pending-load-balancer; then
    jq -n '{metadata: {namespace: "apps", name: "queued"}, spec: {type: "LoadBalancer", clusterIP: "198.51.100.67"},
      status: {loadBalancer: {}}}'
  fi
  if listed mixed-load-balancer; then
    jq -n '{metadata: {namespace: "apps", name: "mixed"}, spec: {type: "LoadBalancer", clusterIP: "198.51.100.68"},
      status: {loadBalancer: {ingress: [{ip: "192.0.2.131"}, {ip: "198.51.100.69"}]}}}'
  fi
  if listed hostname-load-balancer; then
    jq -n '{metadata: {namespace: "apps", name: "named"}, spec: {type: "LoadBalancer", clusterIP: "198.51.100.70"},
      status: {loadBalancer: {ingress: [{hostname: "lb.example.invalid"}]}}}'
  fi
  # One object per line, for an ingress address no other state gives.
  if listed extra-services; then
    cat "$state/extra-services"
  fi
}

volumes() {
  jq -n '{metadata: {name: "local-volume-1"}, spec: {local: {path: "/var/mnt/local"}, nodeAffinity: {}}}'
  if listed csi-volume; then
    jq -n '{metadata: {name: "pvc-0a1b2c3d"}, spec: {csi: {driver: "cinder.csi.openstack.org", volumeHandle: "marker-volume-handle"}}}'
  fi
  local i
  if listed linstor-volumes; then
    for ((i = 1; i <= $(< "$state/linstor-volumes"); i++)); do
      jq -n --arg name "pvc-linstor-$i" '{metadata: {name: $name}, spec: {csi: {driver: "linstor.csi.linbit.com",
        volumeHandle: "marker-volume-handle"}, nodeAffinity: {required: {nodeSelectorTerms: [{matchExpressions: [
        {key: "kubernetes.io/hostname", operator: "In", values: ["worker-1", "198.51.100.84"]}]}]}}}}'
    done
  fi
}

# list: the objects on standard input as a kubectl List.
list() {
  jq -s '{apiVersion: "v1", kind: "List", items: .}'
}

# targets: Prometheus's answer to a request for its active targets: each of the cluster's own
# components, on every node that runs it, up unless targets-down names it, with the addresses a real
# answer holds in its labels, which the recipes must never print. A target names its node as the
# monitor that finds it does: etcd's by its endpoint's node alone; the controller manager's and the
# scheduler's by their endpoint's node and their pod's; node-exporter's by its pod's node alone; a
# kubelet's, whose endpoint the Prometheus Operator points at the Node, only in the label node the
# Operator gives it; the API server's not at all.
targets() {
  local job node
  {
    if ! listed targets-none; then
      for job in kube-controller-manager kube-scheduler kube-etcd; do
        for node in cp-1 cp-2 cp-3; do echo "$job $node"; done
      done
      for job in kubelet node-exporter; do
        for node in cp-1 cp-2 cp-3 worker-1 worker-2 worker-3; do echo "$job $node"; done
      done
      echo "apiserver"
      echo "coredns"
      if listed other-down; then echo "my-app down"; fi
      if listed many-targets; then
        for ((n = 0; n < $(< "$state/many-targets"); n++)); do echo "coredns-$n"; done
      fi
    fi
  } | jq -R -s --rawfile down <(cat "$state/targets-down" 2> /dev/null) --rawfile unscraped <(cat "$state/unscraped" 2> /dev/null) '
    ($down | split("\n") | map(select(. != ""))) as $down
    | ($unscraped | split("\n") | map(select(. != ""))) as $unscraped
    | {status: "success", data: {activeTargets: [split("\n")[] | select(. != "") | split(" ") as $t | select($t[0] | IN($unscraped[]) | not)
      | (if ($t | length) > 1 and $t[0] != "my-app" then $t[1] else null end) as $node
      | {discoveredLabels: ({"__address__": "198.51.100.31:9100"}
          + (if $node == null then {}
            elif $t[0] == "kube-etcd" then {"__meta_kubernetes_endpoint_node_name": $node}
            elif $t[0] == "node-exporter" then {"__meta_kubernetes_pod_node_name": $node}
            elif $t[0] == "kubelet" then {"__meta_kubernetes_endpoint_address_target_kind": "Node",
              "__meta_kubernetes_endpoint_address_target_name": $node}
            else {"__meta_kubernetes_endpoint_node_name": $node, "__meta_kubernetes_pod_node_name": $node} end)),
        labels: ({job: $t[0], instance: "198.51.100.31:9100"}
          + (if $t[0] == "kubelet" and $node != null then {node: $node} else {} end)),
        scrapeUrl: "http://198.51.100.31:9100/metrics",
        health: (if ($down | index($t | join(" "))) != null or ($t[0] == "my-app") then "down" else "up" end)}]}}'
}

case $args in
  *" get service kube-prometheus-stack-prometheus "*)
    listed no-monitoring || echo service/kube-prometheus-stack-prometheus
    ;;
  *" get --raw /api/v1/namespaces/monitoring/services/kube-prometheus-stack-prometheus:9090/proxy/api/v1/targets"*)
    if listed prometheus-silent; then
      echo 'Error from server (ServiceUnavailable): the server is currently unable to handle the request (get services kube-prometheus-stack-prometheus:9090): dial tcp 198.51.100.55:9090: i/o timeout' >&2
      exit 1
    fi
    if listed prometheus-error; then
      echo '{"status":"error","errorType":"internal","error":"reading 198.51.100.55 failed"}'
      exit 0
    fi
    targets
    ;;
  *" get --raw /readyz "*)
    if listed readyz-fails; then
      echo 'Error from server (InternalError): an error on the server ("[-]etcd failed: reason withheld") has prevented the request from succeeding' >&2
      exit 1
    fi
    echo ok
    ;;
  *" get nodes "*) nodes | list ;;
  " get node "*)
    found=$(nodes | jq -c --arg node "$3" 'select(.metadata.name == $node)')
    if [[ -z $found ]]; then
      echo "Error from server (NotFound): nodes \"$3\" not found" >&2
      exit 1
    fi
    printf '%s\n' "$found"
    ;;
  " label node "*)
    node=$3
    for arg in "${@:4}"; do
      case $arg in
        node-restriction.kubernetes.io/bgp-out=*)
          : > "$state/bgp-out.$node"
          : > "$state/bgp-was-out.$node"
          echo 0 > "$state/bgp-reads.$node"
          echo "node/$node labeled"
          ;;
        node-restriction.kubernetes.io/bgp-out-)
          rm -f "$state/bgp-out.$node"
          echo "$node $(cat "$state/agent-last.$node" 2> /dev/null || echo unread)" >> "$record/label-removed"
          : > "$state/bgp-put-back.$node"
          echo 0 > "$state/bgp-reads.$node"
          echo "node/$node unlabeled"
          ;;
      esac
    done
    ;;
  *" get ciliumbgpnodeconfig "*) bgp_node_config "$3" ;;
  " cordon "*)
    : > "$state/cordoned.$2"
    echo "node/$2 cordoned"
    ;;
  " drain "*)
    if listed drain-unreachable; then
      echo "Unable to connect to the server: dial tcp 198.51.100.66:6443: connect: connection refused" >&2
      exit 1
    fi
    : > "$state/cordoned.$2"
    echo "node/$2 cordoned"
    # Evicting takes a while, as a drain does.
    sleep 1.5
    if listed drain-fails; then
      echo 'error when evicting pods/"web-0" -n "apps" (will retry after 5s): Cannot evict pod as it would violate the pod'"'"'s disruption budget.' >&2
      echo "error: unable to drain node \"$2\" due to error: global timeout reached: 10m0s" >&2
      exit 1
    fi
    if announcing "$2"; then
      echo "$2 announcing" >> "$record/drained-bgp"
    else
      echo "$2 withdrawn" >> "$record/drained-bgp"
    fi
    echo "evicting pod apps/web-0"
    echo "pod/web-0 evicted"
    echo "node/$2 drained"
    echo "drain of $2 finished" >> "$record/argv"
    ;;
  " uncordon "*)
    rm -f "$state/cordoned.$2"
    if listed "back.$2"; then
      echo "$2 back" >> "$record/uncordoned"
    else
      echo "$2 away" >> "$record/uncordoned"
    fi
    echo "node/$2 uncordoned"
    ;;
  " delete pod "*)
    shift 2
    delete_pods "$@"
    ;;
  *" get pods --namespace kube-system --selector k8s-app=cilium --field-selector spec.nodeName="*)
    node=${args#*spec.nodeName=}
    agent_pods "${node%% *}"
    ;;
  *" get pods "*) pods | list ;;
  *" get namespace flux-system "*) listed no-flux || echo namespace/flux-system ;;
  *" get certificatesigningrequests "*) csrs | list ;;
  *" get services "*) services | list ;;
  *" get persistentvolumes "*) volumes | list ;;
  " logs "*)
    if listed logs-fail; then
      echo 'Error from server: Get "https://198.51.100.31:10250/containerLogs/kube-system/cilium-a1b2c/main?tailLines=1": remote error: tls: internal error' >&2
      exit 1
    fi
    echo "level=info msg=\"serving on 198.51.100.52:4244\""
    ;;
  *)
    echo "unexpected call: kubectl $*" >&2
    exit 1
    ;;
esac
