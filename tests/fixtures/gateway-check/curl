#!/usr/bin/env bash
# A stand-in for curl reaching the public Gateway through the edge routers' floating addresses,
# installed by tests/gateway-check.bats as <tmp>/bin/curl. It finds its files from its own path. A
# host is reached only through an address --resolve gives for its port, and only an edge's address
# answers. The Gateway behind it answers as a healthy one does unless a file in <tmp>/state says
# otherwise:
#   edge-down.ADDRESS   nothing answers at ADDRESS; curl's error names it
#   redirect-status     the status plain HTTP is answered with, 301 without it
#   redirect-location   the Location plain HTTP is sent to, https on the same host and path without it
#   served-by           which authority signed the certificate served: cluster-ca (the default),
#                       production (a public one, trusted from the CA path curl was built with alone)
#                       or staging (trusted from the issuing certificate of <tmp>/fixtures/acme-anchors.crt,
#                       given by --cacert, alone)
#   untrusted           the certificate served is signed by another authority than the cluster's CA,
#                       one in the CA path this curl was built with, as a public authority would be
#   wrong-names         the certificate served names another domain
#   hello-status        the status the demo answers with, 200 without it
#   hello-page          the page the demo answers with, the one of its ConfigMap without it
#   unrouted-status     the status a host no route serves is answered with, 404 without it
#   dns-answer          the addresses the public resolver gives for hello, one per line, both edges'
#                       without it
#   dns-nxdomain        the public resolver answers that the name does not exist
#   dns-garbage         the public resolver answers with something that is not JSON
#   dns-json            the public resolver answers for hello with this file's content, as it is
#   doh-down            nothing answers at the public resolver
#   by-name-down        the name does not resolve for a request that names no address
#   no-rate-limit       a burst for the demo is answered 200 throughout
#   two-connections     a burst for the demo takes two connections
#   burst-status        the last request of a burst for the demo is answered with the status this
#                       file holds
#   burst-limited-only  a burst for the demo is answered 429 throughout
#   burst-short         a burst for the demo writes out nothing for its last request
#   still-limited       a request for the demo through an edge that has had a burst is answered 429
#   page-after-burst    a request for the demo through an edge that has had a burst is answered 200
#                       with this file's content
# A burst is one call with --http2 and --parallel for several URLs of the demo, each with its own
# --output, which curl multiplexes on one HTTP/2 connection: the demo's rate limit, 5 a second,
# answers the first five 200 and the rest 429, and the connects add up to one. A call for several
# URLs in any other form is refused. A burst leaves a file .burst.ADDRESS in <tmp>/state.
# Verification is curl's: the chain against the --cacert file, which must be the cluster CA's
# certificate in <tmp>/fixtures/ca.crt, and against the CA path, the one it was built with unless
# --capath names another, and the host against the certificate's names, both skipped with -k or
# --insecure. A --cacert does not set the CA path aside: only an empty --capath does. It writes out
# %{http_code}, %{num_connects}, %{ssl_verify_result}, %header{location} and %{certs}, for each
# transfer and also when it fails, as curl does, and records "curl ARGS" in <tmp>/record/argv.
set -uo pipefail

root=${0%/bin/*}
state=$root/state
fixtures=$root/fixtures
printf '%s\n' "curl $*" >> "$root/record/argv"
# The variables that give curl trust of the caller's choosing, as set when it ran.
printf '%s\n' "${CURL_CA_BUNDLE+CURL_CA_BUNDLE }${SSL_CERT_FILE+SSL_CERT_FILE }${SSL_CERT_DIR+SSL_CERT_DIR}" >> "$root/record/curl-env"

listed() {
  [[ -e $state/$1 ]]
}

edges=(203.0.113.51 203.0.113.52)
domain=example.com
# The public resolver's DNS-over-HTTPS endpoint scripts/gateway-check asks, in the JSON form.
doh_json=https://dns.google/resolve

insecure=0 cacert='' capath=built-in format='' http2=0 parallel=0
resolve=() urls=() outputs=()
while (($#)); do
  case $1 in
    -k | --insecure) insecure=1; shift ;;
    --cacert) cacert=$2; shift 2 ;;
    --capath) capath=$2; shift 2 ;;
    --resolve) resolve+=("$2"); shift 2 ;;
    -o | --output) outputs+=("$2"); shift 2 ;;
    -w | --write-out) format=$2; shift 2 ;;
    --http2) http2=1; shift ;;
    --parallel) parallel=1; shift ;;
    --connect-timeout | --max-time | --noproxy | --parallel-max) shift 2 ;;
    -q | --disable | -s | --silent) shift ;;
    -*) echo "fake curl: unexpected option $1" >&2; exit 2 ;;
    *) urls+=("$1"); shift ;;
  esac
done
url=${urls[0]-} output=${outputs[0]:-/dev/stdout}
if ((${#urls[@]} > 1)) && { ((!http2 || !parallel)) || [[ ${#outputs[@]} -ne ${#urls[@]} ]]; }; then
  echo "fake curl: several URLs, and not a parallel HTTP/2 burst with an output for each" >&2
  exit 2
fi

code=000 location='' certs='' verify=0 connects=0
# write_out: what curl writes out after a request, whether it succeeded or not.
write_out() {
  local text=${format//\\n/$'\n'}
  text=${text//'%{http_code}'/$code}
  text=${text//'%{num_connects}'/$connects}
  text=${text//'%{ssl_verify_result}'/$verify}
  text=${text//'%header{location}'/$location}
  text=${text//'%{certs}'/$certs}
  printf '%s' "$text"
}

# The public resolver: a name's A records as JSON, from a certificate the system trusts; a request
# for the resolver is not through an edge, so it takes no --resolve and no cluster CA.
if [[ $url == "$doh_json?"* ]]; then
  listed doh-down && { echo "curl: (28) Connection timed out after 5001 milliseconds" >&2; exit 28; }
  [[ -z $cacert && ${#resolve[@]} -eq 0 && $insecure -eq 0 ]] || { echo "fake curl: the resolver is asked with no cluster CA and no --resolve" >&2; exit 2; }
  [[ $url == "$doh_json?name=hello.$domain&type=A" ]] || { echo '{"Status": 3}' > "$output"; exit 0; }
  if listed dns-garbage; then
    echo 'not JSON {' > "$output"
  elif listed dns-json; then
    cat "$state/dns-json" > "$output"
  elif listed dns-nxdomain; then
    echo '{"Status": 3, "Question": [{"name": "hello.example.com.", "type": 1}]}' > "$output"
  else
    answers=("${edges[@]}")
    listed dns-answer && mapfile -t answers < "$state/dns-answer"
    jq -n --args '{Status: 0, Answer: [$ARGS.positional[] | {name: "hello.example.com.", type: 1, TTL: 300, data: .}]}' "${answers[@]}" > "$output"
  fi
  exit 0
fi

[[ $url =~ ^(https?)://([^/:]+)(/.*)?$ ]] || { echo "fake curl: unexpected URL $url" >&2; exit 3; }
scheme=${BASH_REMATCH[1]} host=${BASH_REMATCH[2]} path=${BASH_REMATCH[3]:-/}
port=80
[[ $scheme == https ]] && port=443
address=''
for entry in "${resolve[@]}"; do
  if [[ $entry == "$host:$port:"* ]]; then
    address=${entry#"$host:$port:"}
  fi
done
if [[ -z $address && ${#resolve[@]} -eq 0 ]]; then
  # No --resolve: the system's resolver, which gives an edge's address for the demo's name.
  listed by-name-down || [[ $host != "hello.$domain" ]] || address=${edges[0]}
fi
if [[ -z $address ]]; then
  write_out
  echo "curl: (6) Could not resolve host: $host" >&2
  exit 6
fi
if [[ " ${edges[*]} " != *" $address "* ]] || listed "edge-down.$address"; then
  write_out
  echo "curl: (7) Failed to connect to $host port $port via $address after 3 ms: Could not connect to server" >&2
  exit 7
fi

if [[ $scheme == http ]]; then
  code=301
  listed redirect-status && code=$(< "$state/redirect-status")
  location="https://$host$path"
  listed redirect-location && location=$(< "$state/redirect-location")
  printf '<html>moved</html>\n' > "$output"
  write_out
  exit 0
fi

issuer=cluster-ca names="DNS:*.$domain, DNS:$domain"
served_by=cluster-ca
listed served-by && served_by=$(< "$state/served-by")
case $served_by in
  production) issuer="fixture public intermediate" ;;
  staging) issuer="(STAGING) fixture intermediate" ;;
esac
listed untrusted && issuer=another-ca
listed wrong-names && names="DNS:*.other.example.org, DNS:other.example.org"
certs="Subject:CN = public-wildcard
Issuer:CN = $issuer
X509v3 Subject Alternative Name:$names
Cert:-----BEGIN CERTIFICATE-----
MIIfixtureLeaf
-----END CERTIFICATE-----
Subject:CN = $issuer
Issuer:CN = $issuer
Cert:-----BEGIN CERTIFICATE-----
MIIfixtureAuthority
-----END CERTIFICATE-----
"
# covered: whether the certificate's names cover the host, a wildcard for one label only.
covered() {
  local name
  while IFS= read -r name; do
    name=${name#DNS:}
    if [[ $name == "$host" ]] || [[ $name == '*.'* && ${host#*.} == "${name#*.}" && $host == *.*.* ]]; then
      return 0
    fi
  done <<< "${names//, /$'\n'}"
  return 1
}
# trusted: whether the authority that signed the certificate served is trusted.
trusted() {
  if [[ $issuer == another-ca ]]; then
    [[ $capath == built-in || -n $(ls -A "$capath" 2> /dev/null) ]]
  else
    case $served_by in
      cluster-ca) [[ -n $cacert && $(< "$cacert") == "$(< "$fixtures/ca.crt")" ]] ;;
      # A public authority's chain: in the CA path curl was built with, which nothing else sets aside.
      production) [[ -z $cacert && $capath == built-in ]] ;;
      # The staging chain, which no public store holds: only the issuing certificate the file gives.
      staging) [[ -n $cacert && $(< "$cacert") == "$(< "$fixtures/acme-anchors.crt")" && -z $(ls -A "$capath" 2> /dev/null) ]] ;;
    esac
  fi
}
if ((!insecure)); then
  if ! trusted; then
    verify=20
    write_out
    echo "curl: (60) SSL certificate problem: unable to get local issuer certificate" >&2
    exit 60
  fi
  if ! covered; then
    verify=1
    write_out
    echo "curl: (60) SSL: no alternative certificate subject name matches target hostname '$host'" >&2
    exit 60
  fi
fi

connects=1
if ((${#urls[@]} > 1)); then
  for url in "${urls[@]}"; do
    [[ $url == "https://hello.$domain/" ]] || { echo "fake curl: a burst for $url, not the demo" >&2; exit 2; }
  done
  : > "$state/.burst.$address"
  last=$((${#urls[@]} - 1))
  for ((i = 0; i <= last; i++)); do
    code=429
    ((i >= 5)) && ! listed no-rate-limit || code=200
    ! listed burst-limited-only || code=429
    ((i != last)) || ! listed burst-status || code=$(< "$state/burst-status")
    connects=0
    ((i != 0)) || connects=1
    ((i != 1)) || ! listed two-connections || connects=1
    if [[ $code == 200 ]]; then cat "$fixtures/page.html"; else printf ''; fi > "${outputs[i]}"
    ((i == last)) && listed burst-short || write_out
  done
  exit 0
fi

if [[ $host == "hello.$domain" ]] && listed still-limited && [[ -e $state/.burst.$address ]]; then
  code=429
  printf '' > "$output"
elif [[ $host == "hello.$domain" ]] && listed page-after-burst && [[ -e $state/.burst.$address ]]; then
  code=200
  cat "$state/page-after-burst" > "$output"
elif [[ $host == "hello.$domain" ]]; then
  code=200
  listed hello-status && code=$(< "$state/hello-status")
  if listed hello-page; then cat "$state/hello-page"; else cat "$fixtures/page.html"; fi > "$output"
else
  code=404
  listed unrouted-status && code=$(< "$state/unrouted-status")
  printf '' > "$output"
fi
write_out
exit 0
