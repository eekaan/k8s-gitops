#!/usr/bin/env bash
# A stand-in for kubectl against a cluster with the public Gateway, installed by
# tests/gateway-check.bats as <tmp>/bin/kubectl. It finds its files from its own path and answers the
# reads scripts/gateway-check makes, with the CA's certificate and the demo's page from
# <tmp>/fixtures, from a healthy cluster unless a file in <tmp>/state says otherwise:
#   api-down                 nothing answers; kubectl's error names the API server's address
#   no-config                the ConfigMap cluster-config does not exist
#   not-accepted             the Gateway is not Accepted
#   not-programmed           the Gateway is Accepted but not Programmed
#   long-reason              the Gateway is not Programmed, for a reason a word of 300 letters
#   gateway-garbage          the Gateway is answered with something that is not JSON
#   hang-pods                the proxies' pods are not answered until <tmp>/state/release exists,
#                            at most 20 seconds; the PID of the script that asked goes to
#                            <tmp>/record/script-pid
#   other-address            the Gateway's status names another address than GATEWAY_ADDRESS
#   service-cluster-ip       the proxies' Service is of type ClusterIP
#   service-unlabelled       the proxies' Service lacks the label k8s-gitops/announce: bgp
#   service-pending          the proxies' Service holds no address yet
#   two-services             two Services carry the labels of the Gateway's proxies
#   one-proxy                one of the two proxy pods is not Ready
#   proxies-one-node         both proxy pods run on one node
#   certificate-not-ready    the Gateway's Certificate is not Ready
#   certificate-reason       the reason of the Certificate's Ready condition, the word the file holds
#   validity                 "BEFORE AHEAD": the hours since the Certificate's notBefore and until its
#                            notAfter, 720 and 1440 without it
#   no-validity              the Certificate's status holds neither notBefore nor notAfter
#   no-ca                    the Secret of the cluster's CA cannot be read
#   no-tls-secret            the Secret the Gateway's Certificate makes cannot be read
#   non-acme-issuer          an ACME issuer names a directory that is neither Let's Encrypt's, the one the
#                            file holds, https://acme.example.net/directory when it is empty
#   issuer-name              the Certificate's issuerRef.name, the JSON string the file holds; the
#                            ClusterIssuers cluster-ca (a CA), letsencrypt-production and
#                            letsencrypt-staging (ACME) exist
#   ca-secret-name           the ClusterIssuer's spec.ca.secretName, the JSON string the file holds
#   service-name             the name of the proxies' Service, the JSON string the file holds
#   tls-secret-name          the Secret the https listener names, the JSON string the file holds
#   no-page                  the ConfigMap demo/hello cannot be read
#   unlabelled-route-accepted  an HTTPRoute in a namespace without the opt-in label is Accepted on
#                            the Gateway
#   http-routes              the number of routes the Gateway reports on its http listener, 1
#                            without it
#   no-dns-app               the Kustomization external-dns does not exist, as where the cluster's
#                            overlay does not select DNS records
# Every object it answers with holds addresses from the documentation ranges, and the CA's Secret a
# private key marker, none of which the recipe may print. Like kubectl, it takes every argument after
# -- as a name or a type, never as a flag. It records "kubectl ARGS" in <tmp>/record/argv.
set -uo pipefail

root=${0%/bin/*}
state=$root/state
fixtures=$root/fixtures
printf '%s\n' "kubectl $*" >> "$root/record/argv"

# The values of the cluster's cluster-config the answers agree with.
gateway_address=198.51.100.21
domain=example.com
namespace=envoy-gateway-system

listed() {
  [[ -e $state/$1 ]]
}

if listed api-down; then
  echo "Unable to connect to the server: dial tcp 203.0.113.80:6443: connect: connection refused" >&2
  exit 1
fi

# The flags, as one string to look in, and the other arguments, a type and a name, in order.
flags=' '
positional=()
verb=$1
shift
while (($#)); do
  case $1 in
    --) shift; positional+=("$@"); break ;;
    -*) flags+="$1 " ;;
    *) positional+=("$1") ;;
  esac
  shift
done
args=$flags
# has FLAG: whether the command line holds FLAG as one flag.
has() {
  [[ $args == *" $1 "* ]]
}
kind=${positional[0]-}
object=${positional[1]-}

# condition TYPE STATUS: one status condition.
condition() {
  jq -nc --arg type "$1" --arg status "$2" --arg reason "${3-}" '{type: $type, status: $status,
    reason: (if $reason != "" then $reason elif $status == "True" then $type else "Not" + $type end),
    message: "fixture message naming 198.51.100.99"}'
}

# json_name FILE DEFAULT: the JSON string FILE in the state holds, or DEFAULT as one, so a name can
# carry any character, a NUL among them.
json_name() {
  if listed "$1"; then cat "$state/$1"; else jq -n --arg name "$2" '$name'; fi
}

not_found() {
  echo "Error from server (NotFound): $1 not found" >&2
  exit 1
}

gateway() {
  local address=$gateway_address accepted=True programmed=True http=1
  if listed gateway-garbage; then
    echo 'not JSON {'
    return
  fi
  listed not-accepted && accepted=False
  local reason=''
  if listed long-reason; then
    programmed=False
    reason=$(printf 'A%.0s' {1..300})
  fi
  listed other-address && address=198.51.100.99
  listed not-programmed && programmed=False
  listed http-routes && http=$(< "$state/http-routes")
  jq -n --arg address "$address" --argjson accepted "$(condition Accepted "$accepted")" --argjson secret "$(json_name tls-secret-name public-wildcard-tls)" \
    --argjson programmed "$(condition Programmed "$programmed" "$reason")" --argjson http "$http" '{
    apiVersion: "gateway.networking.k8s.io/v1", kind: "Gateway",
    metadata: {name: "public", namespace: "envoy-gateway-system"},
    spec: {gatewayClassName: "envoy-gateway", listeners: [
      {name: "http", port: 80, protocol: "HTTP"},
      {name: "https", port: 443, protocol: "HTTPS", hostname: "*.example.com",
       tls: {mode: "Terminate", certificateRefs: [{name: $secret}]}}]},
    status: {addresses: [{type: "IPAddress", value: $address}], conditions: [$accepted, $programmed],
      listeners: [{name: "http", attachedRoutes: $http}, {name: "https", attachedRoutes: 1}]}}'
}

service() {
  local type=LoadBalancer labels='{"k8s-gitops/announce": "bgp"}' ingress
  ingress=$(jq -nc --arg address "$gateway_address" '[{ip: $address, ipMode: "VIP"}]')
  listed service-cluster-ip && type=ClusterIP
  listed service-unlabelled && labels='{}'
  listed service-pending && ingress='[]'
  jq -n --arg type "$type" --argjson labels "$labels" --argjson ingress "$ingress" --argjson two "$(listed two-services && echo true || echo false)" \
    --argjson name "$(json_name service-name envoy-envoy-gateway-system-public-1a2b3c4d)" '
    def service($name): {
      apiVersion: "v1", kind: "Service",
      metadata: {name: $name, namespace: "envoy-gateway-system",
        labels: ({"app.kubernetes.io/component": "proxy", "gateway.envoyproxy.io/owning-gateway-name": "public",
          "gateway.envoyproxy.io/owning-gateway-namespace": "envoy-gateway-system"} + $labels)},
      spec: {type: $type, clusterIP: "198.51.100.200", externalTrafficPolicy: "Cluster",
        ports: [{name: "http-80", port: 80}, {name: "https-443", port: 443}]},
      status: {loadBalancer: {ingress: $ingress}}};
    {items: ([service($name)] + (if $two then [service("envoy-public-copy")] else [] end))}'
}

# hang: what an API that does not answer does, until the test releases it, after recording the
# script that asked: the topmost process above that runs scripts/gateway-check, as its subshells
# do too.
hang() {
  local pid=$PPID script='' tick
  local -a argv
  while ((pid > 1)); do
    mapfile -d '' -t argv 2> /dev/null < "/proc/$pid/cmdline" || break
    [[ ${argv[1]-} != *scripts/gateway-check ]] || script=$pid
    pid=$(awk '{ print $4 }' "/proc/$pid/stat")
  done
  echo "$script" > "$root/record/script-pid"
  for ((tick = 0; tick < 200; tick++)); do
    [[ ! -e $state/release ]] || break
    sleep 0.1
  done
  echo "Unable to connect to the server: dial tcp 203.0.113.80:6443: i/o timeout" >&2
  exit 1
}

pods() {
  listed hang-pods && hang
  local second_ready=True second_node=worker-2
  listed one-proxy && second_ready=False
  listed proxies-one-node && second_node=worker-1
  jq -n --arg ready "$second_ready" --arg node "$second_node" '
    def pod($name; $node; $ready; $ip; $host): {
      apiVersion: "v1", kind: "Pod",
      metadata: {name: $name, namespace: "envoy-gateway-system",
        labels: {"app.kubernetes.io/component": "proxy", "gateway.envoyproxy.io/owning-gateway-name": "public"}},
      spec: {nodeName: $node},
      status: {phase: "Running", podIP: $ip, hostIP: $host, conditions: [{type: "Ready", status: $ready}]}};
    {items: [pod("envoy-public-7d9f-abcde"; "worker-1"; "True"; "198.51.100.31"; "192.0.2.20"),
             pod("envoy-public-7d9f-fghij"; $node; $ready; "198.51.100.32"; "192.0.2.30")]}'
}

certificates() {
  local ready=True reason='' before=720 ahead=1440 times='{}'
  listed certificate-not-ready && ready=False
  listed certificate-reason && reason=$(< "$state/certificate-reason")
  listed validity && read -r before ahead < "$state/validity"
  if ! listed no-validity; then
    times=$(jq -nc --arg before "$(date -u -d "$before hours ago" +%Y-%m-%dT%H:%M:%SZ)" \
      --arg after "$(date -u -d "$ahead hours" +%Y-%m-%dT%H:%M:%SZ)" '{notBefore: $before, notAfter: $after}')
  fi
  jq -n --argjson ready "$(condition Ready "$ready" "$reason")" --argjson issuer "$(json_name issuer-name cluster-ca)" \
    --argjson times "$times" '{items: [{
    apiVersion: "cert-manager.io/v1", kind: "Certificate",
    metadata: {name: "public-wildcard", namespace: "envoy-gateway-system"},
    spec: {secretName: "public-wildcard-tls", dnsNames: ["*.example.com", "example.com"],
      issuerRef: {group: "cert-manager.io", kind: "ClusterIssuer", name: $issuer}},
    status: ({conditions: [$ready]} + $times)}]}'
}

routes() {
  local others='[]'
  if listed unlabelled-route-accepted; then
    others='[{"namespace": "other", "name": "sneaky", "accepted": "True"}]'
  fi
  jq -n --argjson others "$others" '
    def route($namespace; $name; $section; $accepted): {
      apiVersion: "gateway.networking.k8s.io/v1", kind: "HTTPRoute",
      metadata: {namespace: $namespace, name: $name},
      spec: ({parentRefs: [{name: "public", namespace: "envoy-gateway-system", sectionName: $section}]}
        + (if $section == "https" then {hostnames: [$name + ".example.com"]} else {} end)),
      status: {parents: [{parentRef: {group: "gateway.networking.k8s.io", kind: "Gateway", name: "public",
          namespace: "envoy-gateway-system", sectionName: $section},
        controllerName: "gateway.envoyproxy.io/gatewayclass-controller",
        conditions: [{type: "Accepted", status: $accepted,
          reason: (if $accepted == "True" then "Accepted" else "NotAllowedByListeners" end)}]}]}};
    {items: ([route("envoy-gateway-system"; "https-redirect"; "http"; "True"),
              route("demo"; "hello"; "https"; "True"),
              route("unlabelled"; "refused"; "https"; "False")]
             + [$others[] | route(.namespace; .name; "https"; .accepted)])}'
}

secret() {
  local crt key
  listed no-ca && { echo "Error from server (Forbidden): secrets is forbidden: 198.51.100.66" >&2; exit 1; }
  crt=$(base64 -w0 < "$fixtures/ca.crt")
  key=$(printf 'MARKER-CA-PRIVATE-KEY\n' | base64 -w0)
  if has '--output=jsonpath={.data.tls\.crt}'; then
    printf '%s' "$crt"
  elif [[ $args == *jsonpath* ]]; then
    # Any other path, the private key's among them, is answered as the API would.
    jq -nr --arg crt "$crt" --arg key "$key" '{"tls.crt": $crt, "tls.key": $key}
      | to_entries | map(.value) | join(" ")'
  else
    jq -n --arg crt "$crt" --arg key "$key" '{apiVersion: "v1", kind: "Secret",
      metadata: {name: "cluster-ca", namespace: "cert-manager"}, type: "kubernetes.io/tls",
      data: {"tls.crt": $crt, "tls.key": $key, "ca.crt": $crt}}'
  fi
}

# tls_secret: the Secret the Gateway's Certificate makes: the leaf and the issuing chain in tls.crt, as
# cert-manager stores an ACME certificate, and a private key.
tls_secret() {
  local crt key
  listed no-tls-secret && { echo "Error from server (Forbidden): secrets is forbidden: 198.51.100.66" >&2; exit 1; }
  crt=$(base64 -w0 < "$fixtures/acme-chain.crt")
  key=$(printf 'MARKER-LEAF-PRIVATE-KEY\n' | base64 -w0)
  if has '--output=jsonpath={.data.tls\.crt}'; then
    printf '%s' "$crt"
  elif [[ $args == *jsonpath* ]]; then
    jq -nr --arg crt "$crt" --arg key "$key" '{"tls.crt": $crt, "tls.key": $key} | to_entries | map(.value) | join(" ")'
  else
    jq -n --arg crt "$crt" --arg key "$key" '{apiVersion: "v1", kind: "Secret",
      metadata: {name: "public-wildcard-tls", namespace: "envoy-gateway-system"}, type: "kubernetes.io/tls",
      data: {"tls.crt": $crt, "tls.key": $key}}'
  fi
}

[[ $verb == get ]] || { echo "fake kubectl: unexpected $verb" >&2; exit 1; }
case $kind in
  configmap)
    case $object in
      cluster-config)
        has --namespace=flux-system || not_found 'configmaps "cluster-config"'
        listed no-config && not_found 'configmaps "cluster-config"'
        jq -n --arg domain "$domain" --arg address "$gateway_address" '{apiVersion: "v1", kind: "ConfigMap",
          metadata: {name: "cluster-config", namespace: "flux-system"},
          data: {CLUSTER_DOMAIN: $domain, GATEWAY_ADDRESS: $address, SERVICE_RANGE: "198.51.100.16/28",
            BGP_EDGE_ADDRESS_1: "192.0.2.251", BGP_EDGE_ADDRESS_2: "192.0.2.252"}}'
        ;;
      hello)
        has --namespace=demo || not_found 'configmaps "hello"'
        listed no-page && not_found 'configmaps "hello"'
        if has '--output=jsonpath={.data.index\.html}'; then
          cat "$fixtures/page.html"
        else
          echo "fake kubectl: unexpected flags$flags" >&2
          exit 1
        fi
        ;;
      *) not_found "configmaps \"$object\"" ;;
    esac
    ;;
  gateways.gateway.networking.k8s.io)
    [[ $object == public ]] && has --namespace=$namespace || not_found "gateways.gateway.networking.k8s.io \"$object\""
    gateway
    ;;
  services)
    has --namespace=$namespace || { echo '{"items": []}'; exit 0; }
    has --selector=app.kubernetes.io/component=proxy,gateway.envoyproxy.io/owning-gateway-name=public,gateway.envoyproxy.io/owning-gateway-namespace=$namespace ||
      { echo '{"items": []}'; exit 0; }
    service
    ;;
  pods)
    has --namespace=$namespace || { echo '{"items": []}'; exit 0; }
    has --selector=app.kubernetes.io/component=proxy,gateway.envoyproxy.io/owning-gateway-name=public,gateway.envoyproxy.io/owning-gateway-namespace=$namespace ||
      { echo '{"items": []}'; exit 0; }
    pods
    ;;
  certificates.cert-manager.io)
    has --namespace=$namespace || { echo '{"items": []}'; exit 0; }
    certificates
    ;;
  clusterissuers.cert-manager.io)
    case $object in
      cluster-ca)
        jq -n --argjson secret "$(json_name ca-secret-name cluster-ca)" '{apiVersion: "cert-manager.io/v1", kind: "ClusterIssuer", metadata: {name: "cluster-ca"},
          spec: {ca: {secretName: $secret}}, status: {conditions: [{type: "Ready", status: "True"}]}}'
        ;;
      letsencrypt-production | letsencrypt-staging)
        server=https://acme-v02.api.letsencrypt.org/directory
        [[ $object == letsencrypt-staging ]] && server=https://acme-staging-v02.api.letsencrypt.org/directory
        if listed non-acme-issuer; then
          server=$(< "$state/non-acme-issuer")
          [[ -n $server ]] || server=https://acme.example.net/directory
        fi
        jq -n --arg name "$object" --arg server "$server" '{apiVersion: "cert-manager.io/v1", kind: "ClusterIssuer", metadata: {name: $name},
          spec: {acme: {server: $server, privateKeySecretRef: {name: ($name + "-account")},
            solvers: [{selector: {dnsZones: ["example.com"]}, dns01: {cloudflare: {apiTokenSecretRef: {name: "cloudflare-api-token", key: "api-token"}}}}]}},
          status: {conditions: [{type: "Ready", status: "True"}]}}'
        ;;
      *) not_found "clusterissuers.cert-manager.io \"$object\"" ;;
    esac
    ;;
  secret)
    if [[ $object == public-wildcard-tls ]] && has --namespace=$namespace; then
      tls_secret
    else
      [[ $object == cluster-ca ]] && has --namespace=cert-manager || not_found "secrets \"$object\""
      secret
    fi
    ;;
  namespaces)
    has --selector=k8s-gitops/gateway=public || { echo "fake kubectl: unexpected flags$flags" >&2; exit 1; }
    jq -n '{items: [{apiVersion: "v1", kind: "Namespace", metadata: {name: "demo", labels: {"k8s-gitops/gateway": "public"}}}]}'
    ;;
  kustomizations.kustomize.toolkit.fluxcd.io)
    [[ $object == external-dns ]] && has --namespace=flux-system || not_found "kustomizations.kustomize.toolkit.fluxcd.io \"$object\""
    # --ignore-not-found: nothing, and success, for a Kustomization that is not there.
    listed no-dns-app && { has --ignore-not-found && exit 0 || not_found "kustomizations.kustomize.toolkit.fluxcd.io \"$object\""; }
    jq -n '{apiVersion: "kustomize.toolkit.fluxcd.io/v1", kind: "Kustomization",
      metadata: {name: "external-dns", namespace: "flux-system"},
      status: {conditions: [{type: "Ready", status: "True"}]}}'
    ;;
  httproutes.gateway.networking.k8s.io)
    has --all-namespaces || { echo "fake kubectl: unexpected flags$flags" >&2; exit 1; }
    routes
    ;;
  *)
    echo "fake kubectl: unexpected $kind" >&2
    exit 1
    ;;
esac
