# The infra and cluster recipes read .env at the repository root when it exists, and the environment
# otherwise. Copy this file to .env (gitignored) and fill it in: secrets are left empty here, and
# the recipes refuse an empty value and any value still starting with example-.
# Each line is a literal NAME=value, read without a shell: nothing in a value is expanded or run,
# one pair of quotes around a value is dropped, and lines starting with # are comments.

# Bucket in the cloud's object storage that holds every stack's OpenTofu state.
TF_STATE_BUCKET=example-state-bucket
# S3 access key for that bucket.
AWS_ACCESS_KEY_ID=
# S3 secret key for that bucket.
AWS_SECRET_ACCESS_KEY=
# Passphrase state and plans are encrypted with, 16 characters or more; losing it makes state unreadable.
TF_STATE_PASSPHRASE=

# OpenStack, either the clouds.yaml entry to use (clouds.yaml lives outside the repository):
OS_CLOUD=example-cloud
# or, in place of OS_CLOUD, an application credential:
# OS_AUTH_URL=https://identity.example.invalid/v3
# OS_AUTH_TYPE=v3applicationcredential
# OS_APPLICATION_CREDENTIAL_ID=
# OS_APPLICATION_CREDENTIAL_SECRET=
# OS_REGION_NAME=example-region

# Operator allowlist for the cluster stack, as a JSON list of CIDRs; only where operator-cidrs.json is absent, as in CI.
# OPERATOR_CIDRS=["192.0.2.0/24"]

# The cluster recipes (docs/cluster.md).
# Path of the Talos age key, outside the repository; just cluster-age-key creates it there. In CI,
# SOPS_AGE_KEY holds the key itself instead.
SOPS_AGE_KEY_FILE=
# The Kubernetes API load balancer's floating address, an IPv4 address or host name, which the
# kubeconfig points at.
KUBE_API_ADDRESS=example-api-address
# Seconds cluster-bootstrap waits for every node to answer on the Talos API port; 600 when unset.
# TALOS_WAIT=600
