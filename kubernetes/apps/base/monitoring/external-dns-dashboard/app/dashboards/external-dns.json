{
  "uid": "external-dns",
  "title": "external-dns",
  "tags": ["external-dns"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last successful sync, age",
      "description": "The time since external-dns last synced with the DNS provider without an error, as the alert ExternalDNSSyncStale computes it. A sync is due every minute; the alert is for an age above 10 minutes, and for no external-dns reporting the time at all.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "time() - max by (namespace) (external_dns_controller_last_sync_timestamp_seconds{namespace=\"external-dns\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 600 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last attempted sync, age",
      "description": "The time since external-dns last tried to sync with the DNS provider, whether or not the attempt succeeded.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "time() - max by (namespace) (external_dns_controller_last_reconcile_timestamp_seconds{namespace=\"external-dns\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 600 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Endpoints of the sources",
      "description": "Endpoints external-dns reads from its sources, which are the routes of the public Gateway.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(external_dns_source_endpoints_total{namespace=\"external-dns\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Endpoints in the registry",
      "description": "Endpoints external-dns finds in its registry, which it reads from the DNS provider.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(external_dns_registry_endpoints_total{namespace=\"external-dns\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Age of the last sync",
      "description": "The time since the last successful sync and since the last attempt. The two rise together while no sync is attempted, and the first alone while attempts fail.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "time() - max by (namespace) (external_dns_controller_last_sync_timestamp_seconds{namespace=\"external-dns\"})",
          "legendFormat": "successful"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "time() - max by (namespace) (external_dns_controller_last_reconcile_timestamp_seconds{namespace=\"external-dns\"})",
          "legendFormat": "attempted"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Endpoints",
      "description": "Endpoints of the sources and of the registry over time.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(external_dns_source_endpoints_total{namespace=\"external-dns\"})",
          "legendFormat": "sources"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(external_dns_registry_endpoints_total{namespace=\"external-dns\"})",
          "legendFormat": "registry"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Errors, per 5 minutes",
      "description": "Errors external-dns counts for its sources and for its registry, over the last 5 minutes.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(increase(external_dns_source_errors_total{namespace=\"external-dns\"}[5m]))",
          "legendFormat": "sources"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(increase(external_dns_registry_errors_total{namespace=\"external-dns\"}[5m]))",
          "legendFormat": "registry"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Verified records, by type",
      "description": "DNS records that exist both in a source and in the registry, by record type.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (record_type) (external_dns_controller_verified_records{namespace=\"external-dns\"})",
          "legendFormat": "{{record_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "decimals": 0 }, "overrides": [] }
    }
  ]
}
