{
  "path": {
    "secrets/data/*": {
      "capabilities": ["create", "patch"]
    },
    "auth/token/revoke-self": {
      "capabilities": ["update"]
    },
    "sys/rotate/recovery/init": {
      "capabilities": ["read", "update", "delete"]
    },
    "sys/rotate/recovery/update": {
      "capabilities": ["update"]
    },
    "sys/rotate/recovery/verify": {
      "capabilities": ["read", "update", "delete"]
    },
    "sys/generate-root-token/attempt": {
      "capabilities": ["read", "update", "delete"]
    },
    "sys/generate-root-token/update": {
      "capabilities": ["update"]
    }
  }
}
