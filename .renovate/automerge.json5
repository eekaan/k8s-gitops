{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "What may merge itself: application patch and minor updates, behind one switch. Everything else waits for a person.",
  packageRules: [
    {
      description: "Everything under kubernetes/: the release age gates the merge, not the pull request",
      matchFileNames: ["kubernetes/**"],
      // The pull request may open before the release is three days old, with the
      // renovate/stability-days status pending until it is. Auto-merge waits for that status.
      internalChecksFilter: "flexible",
      // A release whose registry reports no publish date never counts as three days old, so it
      // never merges itself.
      minimumReleaseAgeBehaviour: "timestamp-required",
    },
    {
      description: "The auto-merge switch: application patch and minor updates",
      matchFileNames: ["kubernetes/**"],
      matchUpdateTypes: ["minor", "patch"],
      // Off until the rendered-manifest check is part of the required check on main (ADR 0009).
      // Setting this to true is all it takes to turn auto-merge on.
      automerge: false,
      // Merged through the pull request once its checks pass, never pushed to the branch.
      automergeType: "pr",
      // Renovate merges, not GitHub's auto-merge, which waits only for the required check and
      // not for renovate/stability-days.
      platformAutomerge: false,
    },
    // Never merged automatically, whatever the update type. These rules come after the switch so
    // that they win over it.
    {
      description: "Major updates",
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      description: "Talos",
      matchPackageNames: ["siderolabs/talos", "ghcr.io/siderolabs/**", "factory.talos.dev/**"],
      automerge: false,
    },
    {
      description: "Kubernetes: kubectl, kubelet and the control plane",
      matchPackageNames: [
        "kubernetes/kubernetes",
        "ghcr.io/siderolabs/kubelet",
        "registry.k8s.io/kube-apiserver",
        "registry.k8s.io/kube-controller-manager",
        "registry.k8s.io/kube-scheduler",
        "registry.k8s.io/kube-proxy",
      ],
      automerge: false,
    },
    {
      description: "Kubernetes API versions",
      matchDatasources: ["kubernetes-api"],
      automerge: false,
    },
    {
      description: "The CNI",
      matchPackageNames: ["cilium", "cilium/**", "quay.io/cilium/**"],
      automerge: false,
    },
    {
      description: "Flux and the Flux Operator",
      matchPackageNames: [
        "fluxcd/**",
        "ghcr.io/fluxcd/**",
        "controlplaneio-fluxcd/**",
        "ghcr.io/controlplaneio-fluxcd/**",
      ],
      automerge: false,
    },
    {
      description: "OpenTofu",
      matchPackageNames: ["opentofu/opentofu"],
      automerge: false,
    },
    {
      description: "OpenTofu providers and modules",
      matchManagers: ["terraform"],
      automerge: false,
    },
    {
      description: "talman",
      matchPackageNames: ["ludwighansson/talman"],
      automerge: false,
    },
    {
      // n8n has marked a few patches of a stable minor as pre-releases, which Docker Hub's tags do
      // not show: a person checks the version on n8n's releases page (docs/kubernetes.md, n8n).
      description: "n8n",
      matchPackageNames: ["docker.io/n8nio/n8n", "docker.io/n8nio/runners"],
      automerge: false,
    },
    {
      // Open WebUI is before 1.0 and its minors migrate its database, which a person reads the
      // release notes for (docs/kubernetes.md, Open WebUI).
      description: "Open WebUI",
      matchPackageNames: ["ghcr.io/open-webui/open-webui"],
      automerge: false,
    },
    {
      // The image's frontend and backend change with its release (docs/kubernetes.md, Backstage).
      description: "Backstage",
      matchPackageNames: ["ghcr.io/backstage/backstage"],
      automerge: false,
    },
    {
      // The chart that runs it is held the same way, whatever the switch above says.
      description: "Everything of Backstage's application, its chart included",
      matchFileNames: ["kubernetes/apps/base/backstage/**"],
      automerge: false,
    },
    {
      // The test that runs CrowdSec's image needs docker, which the required check has none of: a
      // person runs `bats tests/crowdsec.bats` on a machine with docker before merging an update
      // of the image or of the chart (docs/kubernetes.md, CrowdSec).
      description: "Everything of CrowdSec's application: its image and its chart",
      matchFileNames: ["kubernetes/apps/base/crowdsec/**"],
      automerge: false,
    },
    {
      description: "Anything pinned in mise.toml or versions.yaml",
      matchFileNames: ["mise.toml", "versions.yaml"],
      automerge: false,
    },
    {
      // What the application pins runs at admission and inside other workloads' pods: the operator,
      // its chart and the flagd images it injects (docs/kubernetes.md, OpenFeature Operator).
      description: "Everything of the OpenFeature Operator's application, the images it injects included",
      matchFileNames: ["kubernetes/apps/base/open-feature-operator/**"],
      automerge: false,
    },
    {
      // A new filter release brings a new Core Rule Set, which can start refusing a route's
      // traffic (docs/kubernetes.md, Web application firewall).
      description: "The web application firewall's filter",
      matchPackageNames: ["ghcr.io/corazawaf/coraza-proxy-wasm"],
      automerge: false,
    },
    {
      // The chart moves the Envoy the firewall's filter runs on, which no test runs it on: a module
      // the new Envoy cannot load fails open while its policy stays accepted (docs/kubernetes.md,
      // Web application firewall).
      description: "Envoy Gateway's chart",
      matchPackageNames: ["docker.io/envoyproxy/gateway-helm"],
      automerge: false,
    },
  ],
}
