{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Where this repository keeps versions beyond Renovate's default file patterns, the one it reads but must not propose, and the ones it may propose only within the line the tree runs. grafana-plugins is the datasource that reads a Grafana plugin's versions from the catalogue Grafana installs it from.",
  // HelmRelease, OCIRepository, GitRepository and Flux Kustomization images. Helm values files,
  // kustomization.yaml, mise.toml, GitHub Actions workflows and OpenTofu files are found by their
  // managers' default patterns.
  flux: {
    managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
  },
  // Images and API versions in plain manifests.
  kubernetes: {
    managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
  },
  customManagers: [
    {
      customType: "regex",
      // The version is the last value on that line after a ':' or '=', so the tag ending an image
      // or OCI reference such as oci://host/path:v1.2.3 counts, not the whole reference; a digest
      // after it, as in host/path:v1.2.3@sha256:…, is the digest Renovate moves with the tag.
      description: "A version on the line under a '# renovate: datasource=… depName=…' comment",
      managerFilePatterns: [
        // The one source of the Talos and Kubernetes versions.
        "/^versions\\.yaml$/",
        "/^kubernetes/.+\\.ya?ml$/",
        "/^infra/.+\\.(tf|tofu)$/",
        "/^\\.github/workflows/.+\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n[^\\n]*?[:=][ \\t]*[\"']?(?<currentValue>[^\\s\"'/@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?(?:\\s|$)",
      ],
    },
    {
      customType: "regex",
      // A commit of a branch, not a version: the digest under 'branch=…' is what moves.
      description: "A commit of a Git repository's branch on the line under a '# renovate-ref: depName=<URL> branch=…' comment",
      managerFilePatterns: ["/^versions\\.yaml$/"],
      datasourceTemplate: "git-refs",
      matchStrings: [
        "# renovate-ref: depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\n[a-z_]+:[ \\t]*(?<currentDigest>[0-9a-f]{40})(?:\\s|$)",
      ],
    },
    {
      customType: "regex",
      // A justfile variable such as vector_image := "host/name:tag@sha256:…": Renovate moves the
      // tag and the digest of its image index together.
      description: "An image pinned by tag and digest in a justfile variable under a '# renovate: datasource=… depName=…' comment",
      managerFilePatterns: ["/^justfile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[a-z_]+[ \\t]*:=[ \\t]*\"[^\"@\\n]+:(?<currentValue>[^\"@:\\n]+)@(?<currentDigest>sha256:[0-9a-f]{64})\"",
      ],
    },
  ],
  // A Grafana plugin's versions, by the plugin's id, from the grafana.com listing that Grafana's
  // image installs the plugin from at every start, and a version missing from it stops Grafana from
  // starting (docs/kubernetes.md, Grafana). The listing holds a publisher's GitHub releases later,
  // and some never, so a pin under '# renovate: datasource=custom.grafana-plugins' moves only to a
  // version it lists, aged from the listing's createdAt for that version.
  customDatasources: {
    "grafana-plugins": {
      defaultRegistryUrlTemplate: "https://grafana.com/api/plugins/{{packageName}}/versions",
      format: "json",
      transformTemplates: ["{'sourceUrl': items[0].url, 'releases': [items.{'version': version, 'releaseTimestamp': createdAt}]}"],
    },
  },
  packageRules: [
    {
      // To move mise-action's checksum, Renovate first fetches the current release by the tag the
      // version input is written as, and mise's tags carry a v that the workflows' versions do not:
      // it would propose only the version of the workflow without a checksum, which tests/ci.bats
      // refuses. Moved by hand while the version has that form (.renovate/by-hand.tsv).
      description: "mise in the workflows, while its version is written without the v of its release tags",
      matchManagers: ["github-actions"],
      matchDepNames: ["jdx/mise"],
      matchCurrentValue: "/^[0-9]/",
      enabled: false,
    },
    {
      // n8n tags its betas, the next minor and the next major, on Docker Hub as plain versions
      // beside the stable release. Its GitHub releases mark them as pre-releases, but Renovate
      // moves an image's digest only from the image's own registry, which does not, so a newer
      // minor or major cannot be told from a beta here. Renovate therefore proposes only patches
      // of the minor the tree runs, with their digests; a newer minor is moved by hand once n8n
      // releases it as stable (docs/kubernetes.md, n8n).
      description: "n8n and its task runners: patches of the minor the tree runs",
      matchPackageNames: ["docker.io/n8nio/n8n", "docker.io/n8nio/runners"],
      allowedVersions: "/^{{major}}\\.{{minor}}\\.[0-9]+$/",
    },
    {
      // Open WebUI's registry holds each release under two tags, 0.13.3-slim and v0.13.3-slim, and
      // Renovate's docker versioning reads a leading v as part of the version, so it may propose the
      // form with the v, which .renovate/tag-forms.tsv does not accept for the pin.
      description: "Open WebUI: the tags written without a v",
      matchPackageNames: ["ghcr.io/open-webui/open-webui"],
      allowedVersions: "/^[0-9]/",
    },
    {
      // Backstage's registry lists a -next.N pre-release of each coming minor beside its releases.
      description: "Backstage: releases, not the pre-releases of the next minor",
      matchPackageNames: ["ghcr.io/backstage/backstage"],
      allowedVersions: "/^[0-9]+\\.[0-9]+\\.[0-9]+$/",
    },
    {
      // The web application firewall's filter: its registry lists a -busybox variant beside each
      // release, and the moving tags latest, main and 0, the last two with -busybox variants too.
      description: "coraza-proxy-wasm: releases, not their busybox variants or the moving tags",
      matchPackageNames: ["ghcr.io/corazawaf/coraza-proxy-wasm"],
      allowedVersions: "/^[0-9]+\\.[0-9]+\\.[0-9]+$/",
    },
    {
      // The operator runs valkey 9-alpine by default (roles/installer/defaults/main.yml of its tag),
      // the major its configuration is written for, and the AWX pins its newest release by patch.
      // The registry also lists 9.x tags without a patch, other bases and release candidates.
      description: "valkey, the AWX's: releases of the alpine build on major 9",
      matchPackageNames: ["ghcr.io/valkey-io/valkey"],
      allowedVersions: "/^9\\.[0-9]+\\.[0-9]+-alpine$/",
    },
    {
      // The ascender-operator chart names its kube-rbac-proxy by a tag of its own, which the
      // HelmRelease's post-renderer pins by digest, and tests/ascender.bats fails unless the tag is
      // the chart's: a newer tag on its own never passes. So Renovate proposes only new digests of
      // that tag here, and the tag moves with the chart, in the chart's pull request
      // (docs/kubernetes.md, Ascender).
      description: "kube-rbac-proxy of the Ascender operator's chart: digests only, as its tag is the chart's",
      matchFileNames: ["kubernetes/apps/base/ascender/ascender-operator/app/helmrelease.yaml"],
      matchPackageNames: ["quay.io/brancz/kube-rbac-proxy"],
      matchUpdateTypes: ["major", "minor", "patch"],
      enabled: false,
    },
    {
      // Locust's registry tags each build of its master branch as the next patch with .devN after
      // it, such as 2.47.1.dev61, beside its releases, and also holds the moving tags master,
      // latest and reallylatest, tags of single commits and old pre-releases.
      description: "Locust: releases, not the builds of its master branch or the moving tags",
      matchPackageNames: ["docker.io/locustio/locust"],
      allowedVersions: "/^[0-9]+\\.[0-9]+\\.[0-9]+$/",
    },
    {
      // The Browser library's registry tags each release as x.y.z and also holds the moving tags of
      // its major and minor, such as 21 and 21.0, and latest, which follow the newest release.
      description: "Robot Framework's Browser library image: its releases, not the moving tags",
      matchPackageNames: ["docker.io/marketsquare/robotframework-browser"],
      allowedVersions: "/^[0-9]+\\.[0-9]+\\.[0-9]+$/",
    },
  ],
}
