{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Dependencies that move together in one pull request.",
  packageRules: [
    {
      description: "Talos: versions.yaml and the talosctl pin in mise.toml",
      matchPackageNames: ["siderolabs/talos"],
      groupName: "Talos",
      // A patch gets its own pull request, so the running minor can reach its latest patch
      // before the next minor is taken.
      separateMinorPatch: true,
    },
    {
      description: "Kubernetes: versions.yaml and the kubectl pin in mise.toml",
      matchPackageNames: ["kubernetes/kubernetes"],
      groupName: "Kubernetes",
      separateMinorPatch: true,
    },
    {
      description: "The CNI: Cilium's chart and images",
      matchPackageNames: ["cilium", "quay.io/cilium/**"],
      groupName: "Cilium",
    },
    {
      description: "The Prometheus Operator: the chart of its resource definitions and the monitoring chart, which runs it",
      matchPackageNames: [
        "ghcr.io/prometheus-community/charts/prometheus-operator-crds",
        "ghcr.io/prometheus-community/charts/kube-prometheus-stack",
      ],
      groupName: "Prometheus Operator",
      // The two version numbers can move by different steps for the same operator release, a major
      // in one where the other takes a minor or a patch. In one pull request whatever the step,
      // each at its latest, the two name the same operator, which tests/monitoring.bats checks.
      separateMajorMinor: false,
    },
    {
      // tests/openbao.bats holds the image's tag to the pin, so neither moves without the other.
      description: "Flux: the flux2 pin in mise.toml and the Flux CLI image OpenBao's initialise guard runs",
      matchPackageNames: ["fluxcd/flux2", "ghcr.io/fluxcd/flux-cli"],
      groupName: "Flux",
    },
    {
      description: "The log collector: Vector's chart and the image vector-check checks its configuration in",
      matchPackageNames: ["ghcr.io/vectordotdev/helm-charts/vector", "docker.io/timberio/vector"],
      groupName: "Vector",
      // tests/logs.bats fails unless the justfile's image is the one the chart runs, so both move in
      // one pull request whatever the step of each.
      separateMajorMinor: false,
    },
    {
      description: "The Flux Operator: its image and its operator and instance charts",
      matchPackageNames: ["controlplaneio-fluxcd/**", "ghcr.io/controlplaneio-fluxcd/**"],
      groupName: "Flux Operator",
    },
  ],
}
