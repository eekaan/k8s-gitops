{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Dependencies that move together in one pull request.",
  packageRules: [
    {
      // tests/etcd-snapshots.bats holds the etcd snapshot job's talosctl image to versions.yaml's version.
      description: "Talos: versions.yaml, the talosctl pin in mise.toml and the talosctl image of the etcd snapshot job",
      matchPackageNames: ["siderolabs/talos", "ghcr.io/siderolabs/talosctl"],
      groupName: "Talos",
      // A patch gets its own pull request, so the running minor can reach its latest patch
      // before the next minor is taken.
      separateMinorPatch: true,
    },
    {
      description: "Kubernetes: versions.yaml, the kubectl pin in mise.toml and the commit of the JSON schemas kubernetes-validate validates against",
      matchPackageNames: ["kubernetes/kubernetes", "https://github.com/yannh/kubernetes-json-schema"],
      groupName: "Kubernetes",
      separateMinorPatch: true,
    },
    {
      description: "The CNI: Cilium's chart and images",
      matchPackageNames: ["cilium", "quay.io/cilium/**"],
      groupName: "Cilium",
    },
    {
      description: "The Prometheus Operator: the chart of its resource definitions and the monitoring chart, which runs it",
      matchPackageNames: [
        "ghcr.io/prometheus-community/charts/prometheus-operator-crds",
        "ghcr.io/prometheus-community/charts/kube-prometheus-stack",
      ],
      groupName: "Prometheus Operator",
      // The two version numbers can move by different steps for the same operator release, a major
      // in one where the other takes a minor or a patch. In one pull request whatever the step,
      // each at its latest, the two name the same operator, which tests/monitoring.bats checks.
      separateMajorMinor: false,
    },
    {
      // tests/openbao.bats holds the image's tag to the pin, so neither moves without the other.
      description: "Flux: the flux2 pin in mise.toml and the Flux CLI image OpenBao's initialise guard runs",
      matchPackageNames: ["fluxcd/flux2", "ghcr.io/fluxcd/flux-cli"],
      groupName: "Flux",
    },
    {
      // tests/openbao-snapshots.bats holds the snapshot job's client image to the tag the chart gives
      // the servers.
      description: "OpenBao: its chart and the image of the client the snapshot job runs",
      matchPackageNames: ["ghcr.io/openbao/charts/openbao", "quay.io/openbao/openbao"],
      groupName: "OpenBao",
      // The chart's version and the servers' differ, so each takes its own step: one pull request
      // whatever the step of either.
      separateMajorMinor: false,
    },
    {
      description: "The log collector: Vector's chart and the image vector-check checks its configuration in",
      matchPackageNames: ["ghcr.io/vectordotdev/helm-charts/vector", "docker.io/timberio/vector"],
      groupName: "Vector",
      // tests/logs.bats fails unless the justfile's image is the one the chart runs, so both move in
      // one pull request whatever the step of each.
      separateMajorMinor: false,
    },
    {
      // tests/applications.bats fails unless the runners image is of n8n's version.
      description: "n8n: its image and its task runners' image",
      matchPackageNames: ["docker.io/n8nio/n8n", "docker.io/n8nio/runners"],
      groupName: "n8n",
    },
    {
      // tests/postgresql.bats fails unless the plugin's image and its sidecar's are of the release the
      // chart is made for, its appVersion, so the three move in one pull request whatever the step of each.
      // The oldest operator the release supports is a constant of that test: a release whose
      // documentation raises it needs the constant raised by hand in this pull request.
      description: "The Barman Cloud plugin: its chart, its image and its sidecar's image",
      matchPackageNames: [
        "ghcr.io/cloudnative-pg/charts/plugin-barman-cloud",
        "ghcr.io/cloudnative-pg/plugin-barman-cloud",
        "ghcr.io/cloudnative-pg/plugin-barman-cloud-sidecar",
      ],
      groupName: "Barman Cloud plugin",
      separateMajorMinor: false,
    },
    {
      description: "The Flux Operator: its image and its operator and instance charts",
      matchPackageNames: ["controlplaneio-fluxcd/**", "ghcr.io/controlplaneio-fluxcd/**"],
      groupName: "Flux Operator",
    },
  ],
}
